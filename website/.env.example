SITE_URL=https://wirkaufendeineimmobilie.de

# Brevo (E-Mail-Service)
BREVO_API_KEY=
BREVO_DOI_TEMPLATE_ID=
BREVO_LIST_ID_INVESTOR=
BREVO_LIST_ID_MAKLER=
BREVO_LIST_ID_TIPPGEBER=
BREVO_LIST_ID_ROI=
BREVO_LIST_ID_KAPITALANLEGER=
BREVO_LIST_ID_ERBEN=
BREVO_LIST_ID_BLUEPRINT=
BREVO_LIST_ID_KOMPASS=
BREVO_LIST_ID_SCHEIDUNG=
BREVO_LIST_ID_UMZUG=
NOTIFY_EMAIL=office@wirkaufendeineimmobilie.de

# DOI-Redirect — wohin Brevo nach Bestätigung weiterleitet
BREVO_DOI_REDIRECT_URL=https://wirkaufendeineimmobilie.de/api/confirm-welcome

# Admin Panel (Zugangsdaten für /admin)
ADMIN_USER=admin
ADMIN_PASSWORD=<sicheres-passwort-generieren-mit: openssl rand -base64 24>

# Welcome-Mail Brevo Template IDs (in Brevo unter Transactional > Templates anlegen)
# Wenn leer: HTML-Fallback wird genutzt, kein Fehler
BREVO_TEMPLATE_ID_WELCOME_INVESTOR=
BREVO_TEMPLATE_ID_WELCOME_TIPPGEBER=
BREVO_TEMPLATE_ID_WELCOME_MAKLER=
BREVO_TEMPLATE_ID_WELCOME_VERKAEUFER=

# Cloudflare Turnstile (kostenloser Spam-Schutz)
# Erstellen unter: https://dash.cloudflare.com → Turnstile → Add Site
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
