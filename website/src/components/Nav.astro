<style>
  .nav {
    position: fixed;
    top: 16px;
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% - 48px);
    max-width: 1200px;
    z-index: var(--z-nav, 100);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(226, 232, 240, 0.8);
    border-radius: 16px;
    box-shadow:
      0 2px 8px rgba(15, 23, 42, 0.06),
      0 8px 32px rgba(15, 23, 42, 0.08);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                box-shadow 0.35s ease;
  }

  .nav.nav--hidden {
    transform: translateX(-50%) translateY(calc(-100% - 24px));
    opacity: 0;
    pointer-events: none;
  }

  .nav.nav--scrolled {
    box-shadow:
      0 4px 16px rgba(15, 23, 42, 0.10),
      0 16px 48px rgba(15, 23, 42, 0.12);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    gap: var(--space-6);
    padding-inline: var(--space-5);
  }

  .nav__logo {
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-text {
    font-size: 18px;
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: var(--tracking-tight, -0.02em);
  }

  .logo-accent {
    color: var(--color-accent);
  }

  .nav__links {
    display: flex;
    gap: var(--space-5);
  }

  .nav__links a {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-mid);
    text-decoration: none;
    transition: color var(--duration-fast, 150ms) ease;
    white-space: nowrap;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .nav__links a:hover {
    color: var(--color-text);
  }

  /* Dropdown */
  .nav__dropdown {
    position: relative;
  }

  .nav__dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-mid);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    min-height: 44px;
    transition: color var(--duration-fast, 150ms) ease;
    white-space: nowrap;
  }

  .nav__dropdown-trigger:hover,
  .nav__dropdown:hover .nav__dropdown-trigger {
    color: var(--color-text);
  }

  .nav__dropdown-trigger svg {
    transition: transform 0.2s ease;
  }

  .nav__dropdown:hover .nav__dropdown-trigger svg,
  .nav__dropdown-trigger[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }

  .nav__dropdown-menu {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    min-width: 240px;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.10), 0 16px 48px rgba(15, 23, 42, 0.08);
    padding: 6px;
    z-index: 200;
  }

  .nav__dropdown-menu::before {
    content: '';
    position: absolute;
    top: -12px;
    left: 0;
    right: 0;
    height: 12px;
  }

  .nav__dropdown:hover .nav__dropdown-menu,
  .nav__dropdown-trigger[aria-expanded="true"] + .nav__dropdown-menu {
    display: block;
  }

  .nav__dropdown-menu a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-3) var(--space-4);
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.15s ease;
    min-height: unset;
  }

  .nav__dropdown-menu a:hover {
    background: var(--color-bg-alt);
    color: inherit;
  }

  .nav__dropdown-title {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
  }

  .nav__dropdown-desc {
    font-size: 12px;
    color: var(--color-text-mid);
    font-weight: var(--weight-normal);
  }

  /* Mobile group */
  .nav__mobile-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .nav__mobile-group-label {
    font-size: 11px;
    font-weight: var(--weight-semibold);
    color: var(--color-text-mid);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: var(--space-2) 0 0;
  }

  .nav__mobile-sub {
    font-size: var(--text-base) !important;
    color: var(--color-text) !important;
    padding-left: var(--space-3) !important;
    min-height: 40px !important;
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .nav__phone {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    background: var(--color-accent-light);
    border-radius: var(--radius-full, 9999px);
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--duration-fast, 150ms) ease;
    min-height: 36px;
  }

  .nav__phone:hover {
    background: var(--color-accent);
    color: var(--color-text-on-accent);
  }

  .nav__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2) var(--space-5);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-text-on-accent);
    background: var(--color-accent);
    border-radius: var(--radius-sm, 6px);
    text-decoration: none;
    white-space: nowrap;
    transition: all var(--duration-fast, 150ms) ease;
    min-height: 36px;
    box-shadow: 0 1px 4px rgba(59, 130, 246, 0.3);
  }

  .nav__cta:hover {
    background: var(--color-accent-hover);
    color: var(--color-text-on-accent);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
  }

  .nav__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-2);
  }

  .nav__burger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .nav__burger[aria-expanded="true"] span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }
  .nav__burger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .nav__burger[aria-expanded="true"] span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  .nav__mobile {
    display: none;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .nav__mobile[aria-hidden="false"] {
    display: flex;
  }

  .nav__mobile a {
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    color: var(--color-text);
    text-decoration: none;
    padding: var(--space-2) 0;
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .nav__phone--mobile {
    margin-top: var(--space-4);
    justify-content: center;
  }

  .nav__cta--mobile {
    justify-content: center;
    text-align: center;
  }

  @media (max-width: 900px) {
    .nav__links {
      display: none;
    }

    .nav__burger {
      display: flex;
    }
  }

  @media (max-width: 768px) {
    .nav {
      width: calc(100% - 24px);
      top: 8px;
      border-radius: 12px;
    }

    .nav__actions {
      display: none;
    }
  }
</style>

<script>
  // Floating navbar — hide on scroll down, reveal on scroll up
  const nav = document.getElementById('floating-nav');
  let lastScrollY = window.scrollY;
  let ticking = false;

  function updateNav() {
    const currentScrollY = window.scrollY;

    if (currentScrollY > 80) {
      nav?.classList.add('nav--scrolled');
    } else {
      nav?.classList.remove('nav--scrolled');
    }

    if (currentScrollY > lastScrollY && currentScrollY > 120) {
      nav?.classList.add('nav--hidden');
    } else {
      nav?.classList.remove('nav--hidden');
    }

    lastScrollY = currentScrollY;
    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(updateNav);
      ticking = true;
    }
  }, { passive: true });

  // Mobile burger
  const burger = document.getElementById('nav-burger');
  const mobile = document.getElementById('nav-mobile');

  burger?.addEventListener('click', () => {
    const expanded = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!expanded));
    mobile?.setAttribute('aria-hidden', String(expanded));
  });
</script>
