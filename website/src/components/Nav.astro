---
---
<header class="nav">
  <div class="nav__inner container">
    <a href="/" class="nav__logo" aria-label="wirkaufendeineimmobilie.de — Startseite">
      <span class="logo-text">wirkaufen<span class="logo-accent">deine</span>immobilie</span>
    </a>

    <nav class="nav__links" id="nav-links" aria-label="Hauptnavigation">
      <a href="/so-funktionierts">So funktioniert's</a>
      <a href="/investoren">Für Investoren</a>
      <a href="/roi-rechner">ROI-Rechner</a>
    </nav>

    <a href="tel:+493418009000" class="nav__phone">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      0341 — 800 900 0
    </a>

    <button class="nav__burger" id="nav-burger" aria-label="Menü öffnen" aria-expanded="false" aria-controls="nav-mobile">
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div class="nav__mobile" id="nav-mobile" aria-hidden="true">
    <a href="/so-funktionierts">So funktioniert's</a>
    <a href="/investoren">Für Investoren</a>
    <a href="/roi-rechner">ROI-Rechner</a>
    <a href="tel:+493418009000" class="nav__phone nav__phone--mobile">
      0341 — 800 900 0
    </a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: var(--color-bg-card);
    border-bottom: 1px solid var(--color-border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: var(--space-6);
  }

  .nav__logo {
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-text {
    font-size: 20px;
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: var(--tracking-tight);
  }

  .logo-accent {
    color: var(--color-accent);
  }

  .nav__links {
    display: flex;
    gap: var(--space-6);
  }

  .nav__links a {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-mid);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-default);
    white-space: nowrap;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .nav__links a:hover {
    color: var(--color-text);
  }

  .nav__phone {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    background: var(--color-accent-light);
    border-radius: var(--radius-full);
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--duration-fast) var(--ease-default);
    min-height: 44px;
  }

  .nav__phone:hover {
    background: var(--color-accent);
    color: var(--color-text-on-accent);
  }

  .nav__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-2);
  }

  .nav__burger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: transform var(--duration-normal) var(--ease-default),
                opacity var(--duration-normal) var(--ease-default);
  }

  .nav__burger[aria-expanded="true"] span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }
  .nav__burger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .nav__burger[aria-expanded="true"] span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  .nav__mobile {
    display: none;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6) var(--container-padding);
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-card);
  }

  .nav__mobile[aria-hidden="false"] {
    display: flex;
  }

  .nav__mobile a {
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    color: var(--color-text);
    text-decoration: none;
    padding: var(--space-2) 0;
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .nav__phone--mobile {
    margin-top: var(--space-4);
    justify-content: center;
  }

  @media (max-width: 768px) {
    .nav__links,
    .nav__phone:not(.nav__phone--mobile) {
      display: none;
    }

    .nav__burger {
      display: flex;
    }
  }
</style>

<script>
  const burger = document.getElementById('nav-burger');
  const mobile = document.getElementById('nav-mobile');

  burger?.addEventListener('click', () => {
    const expanded = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!expanded));
    mobile?.setAttribute('aria-hidden', String(expanded));
  });
</script>
