---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

const url = new URL(Astro.request.url);
const typ = url.searchParams.get('typ') || 'verkaeufer';
const guide = url.searchParams.get('guide') || '';

const content: Record<string, { title: string; heading: string; message: string; next?: string; nextLink?: string }> = {
  verkaeufer: {
    title: 'Anfrage eingegangen',
    heading: 'Ihre Anfrage ist eingegangen!',
    message: 'Wir melden uns innerhalb von 24 Stunden mit einer ersten Einschätzung bei Ihnen.',
    next: 'Wie funktioniert das Angebotsverfahren?',
    nextLink: '/so-funktionierts',
  },
  investor: {
    title: 'Willkommen',
    heading: 'Willkommen!',
    message: 'Wir prüfen Ihren Zugang und melden uns in 48 Stunden. Bitte stellen Sie sicher, dass unsere E-Mails nicht im Spam landen.',
    next: 'ROI-Rechner ausprobieren',
    nextLink: '/roi-rechner',
  },
  guide: {
    title: 'Ihr Guide ist unterwegs',
    heading: 'Ihr Guide ist unterwegs!',
    message: 'Prüfen Sie Ihren Posteingang — die E-Mail sollte in wenigen Minuten ankommen. Schauen Sie auch im Spam-Ordner nach.',
    next: guide === 'erben' ? 'Immobilie jetzt bewerten lassen' : 'Investoren-Zugang anfragen',
    nextLink: guide === 'erben' ? '/#bewertung' : '/investoren',
  },
};

const c = content[typ] || content.verkaeufer;
---
<Layout
  title={`${c.title} — wirkaufendeineimmobilie.de`}
  description="Ihre Anfrage wurde erfolgreich übermittelt. Wir melden uns innerhalb von 48 Stunden."
>

  <section class="section danke">
    <div class="container danke__inner">
      <div class="danke__icon">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      </div>
      <h1>{c.heading}</h1>
      <p class="danke__msg">{c.message}</p>

      {c.next && c.nextLink && (
        <a href={c.nextLink} class="btn btn-primary" style="margin-top: var(--space-6);">{c.next} &rarr;</a>
      )}

      <div class="danke__contact">
        <p>Fragen? Rufen Sie uns an:</p>
        <a href="tel:+493418009000" class="danke__phone">0341 — 800 900 0</a>
      </div>

      <a href="/" class="danke__back">&larr; Zurück zur Startseite</a>
    </div>
  </section>

</Layout>

<style>
  .danke {
    padding-top: var(--space-24);
    padding-bottom: var(--space-24);
    text-align: center;
  }

  .danke__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    max-width: 560px;
    margin-inline: auto;
  }

  .danke__icon {
    margin-bottom: var(--space-4);
  }

  .danke__msg {
    font-size: var(--text-lg);
    color: var(--color-text-mid);
    line-height: var(--leading-relaxed);
  }

  .danke__contact {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .danke__contact p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-inline: auto;
  }

  .danke__phone {
    display: block;
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--color-accent);
    margin-top: var(--space-2);
  }

  .danke__back {
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
