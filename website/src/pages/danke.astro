---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

const url = new URL(Astro.request.url);
const typ = url.searchParams.get('typ') || 'verkaeufer';
const tool = url.searchParams.get('tool') || '';

const content: Record<string, { title: string; heading: string; message: string; next?: string; nextLink?: string }> = {
  verkaeufer: {
    title: 'Anfrage eingegangen',
    heading: 'Deine Anfrage ist eingegangen!',
    message: 'So geht es weiter: Wir prüfen deine Angaben und melden uns innerhalb von 24 Stunden mit einer ersten Einschätzung — per E-Mail oder Telefon.',
    next: 'Erfahre, wie das Angebotsverfahren funktioniert',
    nextLink: '/so-funktionierts',
  },
  investor: {
    title: 'Zugang beantragt',
    heading: 'Dein Zugang wird geprüft!',
    message: 'Nächster Schritt: Wir prüfen deinen Antrag persönlich und melden uns innerhalb von 48 Stunden per E-Mail. Bitte stelle sicher, dass unsere Mails nicht im Spam landen.',
    next: 'In der Zwischenzeit: ROI-Rechner ausprobieren',
    nextLink: '/roi-rechner',
  },
  aktionsplan: {
    title: 'Dein Aktionsplan ist unterwegs',
    heading: 'Dein Aktionsplan ist unterwegs!',
    message: 'Prüfe deinen Posteingang — die E-Mail sollte in wenigen Minuten ankommen. Schau auch im Spam-Ordner nach.',
    next: 'Nächster Schritt: Immobilie bewerten lassen',
    nextLink: '/#bewertung',
  },
  blueprint: {
    title: 'Dein Blueprint ist unterwegs',
    heading: 'Dein Blueprint ist unterwegs!',
    message: 'Prüfe deinen Posteingang — die E-Mail sollte in wenigen Minuten ankommen. Schau auch im Spam-Ordner nach.',
    next: 'Nächster Schritt: Investoren-Zugang anfragen',
    nextLink: '/investoren',
  },
  kompass: {
    title: 'Dein Entscheidungskompass ist unterwegs',
    heading: 'Dein Entscheidungskompass ist unterwegs!',
    message: 'Prüfe deinen Posteingang — die E-Mail sollte in wenigen Minuten ankommen. Schau auch im Spam-Ordner nach.',
    next: 'Nächster Schritt: Immobilie bewerten lassen',
    nextLink: '/#bewertung',
  },
  makler: {
    title: 'Bewerbung eingegangen',
    heading: 'Ihre Bewerbung ist bei uns!',
    message: 'Nächster Schritt: Wir prüfen Ihre Angaben und melden uns innerhalb von 48 Stunden — mit allen Details zur Kooperation und unserer Vereinbarung.',
    next: 'So funktioniert das Verfahren',
    nextLink: '/so-funktionierts',
  },
  tippgeber: {
    title: 'Anmeldung eingegangen',
    heading: 'Danke für deine Anmeldung!',
    message: 'Wir melden uns innerhalb von 48 Stunden mit allen Details — zu deiner Provision und wie du starten kannst.',
    next: 'So funktioniert das Verfahren',
    nextLink: '/so-funktionierts',
  },
  unterlagen: {
    title: 'Unterlagen eingegangen',
    heading: 'Vielen Dank — Ihre Unterlagen sind bei uns!',
    message: 'Joachim Kleinke schaut sich alles persönlich an und meldet sich innerhalb von 48 Stunden mit einer ersten Einschätzung. Fehlende Unterlagen sind kein Problem — wir klären das gemeinsam.',
    next: 'Wie funktioniert das Verfahren?',
    nextLink: '/so-funktionierts',
  },
};

const c = content[typ] || content.verkaeufer;
---
<Layout
  title={`${c.title} — wirkaufendeineimmobilie.de`}
  description="Deine Anfrage wurde erfolgreich übermittelt. Wir melden uns innerhalb von 48 Stunden."
  noindex={true}
>

  <section class="section danke">
    <div class="container danke__inner">
      <div class="danke__icon">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      </div>
      <h1>{c.heading}</h1>
      <p class="danke__msg">{c.message}</p>

      {c.next && c.nextLink && (
        <a href={c.nextLink} class="btn btn-primary" style="margin-top: var(--space-6);">{c.next} &rarr;</a>
      )}

      <div class="danke__contact">
        <p>Fragen? Ruf uns direkt an:</p>
        <a href="tel:+493418009000" class="danke__phone">0341 — 800 900 0</a>
      </div>

      <a href="/" class="danke__back">&larr; Zurück zur Startseite</a>
    </div>
  </section>

</Layout>

<style>
  .danke {
    padding-top: var(--space-24);
    padding-bottom: var(--space-24);
    text-align: center;
  }

  .danke__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .danke__icon {
    margin-bottom: var(--space-4);
  }

  .danke__msg {
    font-size: var(--text-lg);
    color: var(--color-text-mid);
    line-height: var(--leading-relaxed);
  }

  .danke__contact {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .danke__contact p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .danke__phone {
    display: block;
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--color-accent);
    margin-top: var(--space-2);
  }

  .danke__back {
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
