---
import Layout from '../../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const dir = path.join(process.cwd(), 'src', 'content', 'stadtteile');
  const files = fs.readdirSync(dir).filter((f: string) => f.endsWith('.json'));

  return files.map((file: string) => {
    const data = JSON.parse(fs.readFileSync(path.join(dir, file), 'utf-8'));
    return {
      params: { stadtteil: data.slug },
      props: { data },
    };
  });
}

interface StadtteilData {
  name: string;
  slug: string;
  bezirk: string;
  qm_unsaniert: number;
  qm_saniert: number;
  trend: string;
  trend_5j: string;
  typische_objekte: string;
  besonderheit: string;
  infrastruktur: string[];
  einwohner: number;
  sanierungsquote: string;
  nachbar_stadtteile: string[];
  definition: string;
  fliesstext: string;
  marktdaten_quelle: string;
  beispielrechnung_text: string;
  zielgruppe_verkaeufer: string;
  zielgruppe_kaeufer: string;
}

const { data } = Astro.props as { data: StadtteilData };

const kaufpreis = data.qm_unsaniert * 45;
const sanierung = 35000;
const verkaufspreis = data.qm_saniert * 45;
const gewinn = verkaufspreis - kaufpreis - sanierung;

// Map slug to readable name for nachbar links
const slugDir = path.join(process.cwd(), 'src', 'content', 'stadtteile');
const allFiles = fs.readdirSync(slugDir).filter((f: string) => f.endsWith('.json'));
const slugMap: Record<string, string> = {};
allFiles.forEach((f: string) => {
  const d = JSON.parse(fs.readFileSync(path.join(slugDir, f), 'utf-8'));
  slugMap[d.slug] = d.name;
});

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": `wirkaufendeineimmobilie.de — ${data.name}`,
  "description": `Sanierungsbedürftige Wohnungen verkaufen in ${data.name}, Leipzig`,
  "areaServed": {
    "@type": "City",
    "name": "Leipzig",
    "containsPlace": {
      "@type": "Place",
      "name": data.name
    }
  },
  "telephone": "+49-341-800-900-0",
  "url": `https://wirkaufendeineimmobilie.build-upstream.com/leipzig/${data.slug}`
});

const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://wirkaufendeineimmobilie.build-upstream.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Leipzig",
      "item": "https://wirkaufendeineimmobilie.build-upstream.com/leipzig/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": data.name
    }
  ]
});
---
<Layout
  title={`Sanierungsbedürftige Wohnung verkaufen in ${data.name} — wirkaufendeineimmobilie.de`}
  description={`${data.name} (Leipzig ${data.bezirk}): qm-Preise unsaniert ab ${data.qm_unsaniert} €, saniert bis ${data.qm_saniert} €. ${data.trend_5j} in 5 Jahren.`}
>

  <script type="application/ld+json" set:html={jsonLd} />
  <script type="application/ld+json" set:html={breadcrumbLd} />

  <!-- BREADCRUMB -->
  <nav class="st-breadcrumb" aria-label="Breadcrumb">
    <div class="container">
      <a href="/">Home</a> <span class="st-bc-sep">&rsaquo;</span>
      <span>Leipzig</span> <span class="st-bc-sep">&rsaquo;</span>
      <span class="st-bc-current">{data.name}</span>
    </div>
  </nav>

  <!-- HERO -->
  <section class="section st-hero">
    <div class="container">
      <div class="label">{data.bezirk} &middot; Leipzig</div>
      <h1>Sanierungsbedürftige Wohnung verkaufen in {data.name}</h1>
      <p class="st-hero__sub">{data.besonderheit}</p>
    </div>
  </section>

  <!-- 4 MARKET DATA CARDS -->
  <section class="st-market-section">
    <div class="container">
      <h2>Marktdaten {data.name}</h2>
      <div class="st-market-grid">
        <div class="st-market-card">
          <span class="st-market-card__val">{data.qm_unsaniert} &euro;/m&sup2;</span>
          <span class="st-market-card__label">Unsaniert</span>
        </div>
        <div class="st-market-card">
          <span class="st-market-card__val">{data.qm_saniert} &euro;/m&sup2;</span>
          <span class="st-market-card__label">Saniert</span>
        </div>
        <div class="st-market-card">
          <span class="st-market-card__val">{data.trend}</span>
          <span class="st-market-card__label">Trend</span>
        </div>
        <div class="st-market-card">
          <span class="st-market-card__val">{data.trend_5j}</span>
          <span class="st-market-card__label">5-Jahres-Entwicklung</span>
        </div>
      </div>
      <p class="st-source">
        Quelle: {data.marktdaten_quelle}
      </p>
    </div>
  </section>

  <!-- FLIESSTEXT — full width bg-alt -->
  <section class="st-text-section">
    <div class="container">
      <h2>{data.name} als Immobilienstandort</h2>
      <div class="st-text-body" set:html={data.fliesstext} />
      <p class="st-source">
        Quelle: {data.marktdaten_quelle}
      </p>
    </div>
  </section>

  <!-- DEFINITION (AI-Citability) -->
  <section class="st-definition-section">
    <div class="container">
      <p class="st-definition">{data.definition}</p>
    </div>
  </section>

  <!-- MINI ROI — compact horizontal table -->
  <section class="st-roi-section">
    <div class="container">
      <h2>Beispielrechnung für {data.name}</h2>
      <p class="text-mid">45 m&sup2; Wohnung, typisches Sanierungsobjekt</p>
      <div class="st-roi-table">
        <div class="st-roi-row">
          <span class="st-roi-row__label">Kauf (45 m&sup2; &times; {data.qm_unsaniert} &euro;)</span>
          <span class="st-roi-row__val">{kaufpreis.toLocaleString('de-DE')} &euro;</span>
        </div>
        <div class="st-roi-row">
          <span class="st-roi-row__label">Sanierung</span>
          <span class="st-roi-row__val">{sanierung.toLocaleString('de-DE')} &euro;</span>
        </div>
        <div class="st-roi-row">
          <span class="st-roi-row__label">Verkauf (45 m&sup2; &times; {data.qm_saniert} &euro;)</span>
          <span class="st-roi-row__val">{verkaufspreis.toLocaleString('de-DE')} &euro;</span>
        </div>
        <div class="st-roi-row st-roi-row--result">
          <span class="st-roi-row__label">Gewinn (vor Nebenkosten)</span>
          <span class="st-roi-row__val st-roi-row__val--accent">{gewinn.toLocaleString('de-DE')} &euro;</span>
        </div>
      </div>
      <p class="st-roi-footnote">{data.beispielrechnung_text}</p>
      <a href="/roi-rechner" class="btn btn-primary" style="margin-top: var(--space-6);">Exakt berechnen im ROI-Rechner &rarr;</a>
    </div>
  </section>

  <!-- ZIELGRUPPEN — 2 Column Split -->
  <section class="section">
    <div class="container">
      <div class="st-zielgruppen-grid">
        <div class="st-zg-block">
          <div class="st-zg-block__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/><path d="M9 21V12h6v9"/></svg>
          </div>
          <h3>Wer verkauft in {data.name}?</h3>
          <p>{data.zielgruppe_verkaeufer}</p>
        </div>
        <div class="st-zg-block">
          <div class="st-zg-block__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
          </div>
          <h3>Wer kauft in {data.name}?</h3>
          <p>{data.zielgruppe_kaeufer}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- LOCAL INFO -->
  <section class="section bg-alt">
    <div class="container">
      <h2>{data.name} im Detail</h2>
      <div class="st-local-grid">
        <div>
          <h4>Typische Objekte</h4>
          <p class="text-mid">{data.typische_objekte}</p>
        </div>
        <div>
          <h4>Infrastruktur</h4>
          <ul class="st-infra-list">
            {data.infrastruktur.map((item: string) => <li>{item}</li>)}
          </ul>
        </div>
        <div>
          <h4>Einwohner</h4>
          <p class="text-mid">{data.einwohner.toLocaleString('de-DE')}</p>
        </div>
        <div>
          <h4>Sanierungsquote</h4>
          <p class="text-mid">{data.sanierungsquote}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA FORM — accent-light background -->
  <section class="st-cta-section">
    <div class="container st-cta__inner">
      <h2>Immobilie in {data.name} bewerten lassen</h2>
      <p class="text-mid">Kostenlos, unverbindlich — Erstbewertung innerhalb von 48 Stunden.</p>
      <form class="st-cta-form" id="st-form" data-endpoint="/api/bewertung">
        <input
          type="text"
          name="plz"
          placeholder="PLZ eingeben..."
          pattern="[0-9]{5}"
          maxlength="5"
          required
          aria-label="Postleitzahl"
        />
        <button type="submit" class="btn btn-primary">Kostenlos bewerten &rarr;</button>
      </form>
    </div>
  </section>

  <!-- NACHBAR-STADTTEILE — Pill-Links -->
  <section class="section bg-alt">
    <div class="container st-links">
      {data.nachbar_stadtteile.length > 0 && (
        <div class="st-link-group">
          <h4>Nachbar-Stadtteile</h4>
          <div class="st-pills">
            {data.nachbar_stadtteile.map((slug: string) => (
              <a href={`/leipzig/${slug}`} class="st-pill">{slugMap[slug] || slug}</a>
            ))}
          </div>
        </div>
      )}
      <div class="st-link-group">
        <h4>Weitere Seiten</h4>
        <div class="st-pills">
          <a href="/roi-rechner" class="st-pill">ROI-Rechner</a>
          <a href="/so-funktionierts" class="st-pill">So funktioniert's</a>
          <a href="/" class="st-pill">Startseite</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* BREADCRUMB */
  .st-breadcrumb {
    padding-block: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .st-breadcrumb a {
    color: var(--color-text-muted);
  }

  .st-breadcrumb a:hover {
    color: var(--color-accent);
  }

  .st-bc-sep {
    margin-inline: var(--space-2);
    opacity: 0.5;
  }

  .st-bc-current {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }

  /* HERO */
  .st-hero {
    padding-bottom: var(--space-8);
  }

  .st-hero .label {
    margin-bottom: var(--space-4);
  }

  .st-hero__sub {
    font-size: var(--text-lg);
    color: var(--color-text-mid);
    margin-top: var(--space-4);
  }

  /* MARKET DATA — 4 cards */
  .st-market-section {
    background: var(--color-bg-alt);
    padding-block: var(--section-gap);
  }

  .st-market-section h2 {
    margin-bottom: var(--space-6);
  }

  .st-market-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  .st-market-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    text-align: center;
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--duration-normal) var(--ease-default),
                transform var(--duration-normal) var(--ease-default);
  }

  .st-market-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .st-market-card__val {
    display: block;
    font-size: var(--text-2xl);
    font-weight: var(--weight-extrabold);
    color: var(--color-text);
  }

  .st-market-card__label {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-text-mid);
    margin-top: var(--space-1);
  }

  .st-source {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: var(--space-4);
  }

  @media (max-width: 640px) {
    .st-market-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* FLIESSTEXT — full width bg-alt */
  .st-text-section {
    padding-block: var(--section-gap);
  }

  .st-text-section h2 {
    margin-bottom: var(--space-6);
  }

  .st-text-body {
    line-height: 1.8;
    color: var(--color-text-mid);
  }

  .st-text-body :global(p) {
    margin-bottom: var(--space-4);
  }

  .st-text-body :global(p:last-child) {
    margin-bottom: 0;
  }

  /* DEFINITION */
  .st-definition-section {
    padding-block: var(--space-4) var(--space-2);
  }

  .st-definition {
    font-size: var(--text-base);
    color: var(--color-text-mid);
    line-height: 1.7;
    font-style: italic;
  }

  /* MINI ROI — compact horizontal table */
  .st-roi-section {
    background: var(--color-bg-alt);
    padding-block: var(--section-gap);
  }

  .st-roi-section h2 {
    margin-bottom: var(--space-2);
  }

  .st-roi-section > .container {
    text-align: center;
  }

  .st-roi-table {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-8);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    box-shadow: var(--shadow-sm);
    text-align: center;
  }

  .st-roi-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3);
  }

  .st-roi-row:not(:last-child) {
    border-right: 1px solid var(--color-border);
  }

  .st-roi-row__label {
    font-size: var(--text-xs);
    color: var(--color-text-mid);
    font-weight: var(--weight-medium);
  }

  .st-roi-row__val {
    font-size: var(--text-xl);
    font-weight: var(--weight-extrabold);
    color: var(--color-text);
  }

  .st-roi-row--result .st-roi-row__val {
    color: var(--color-accent);
  }

  .st-roi-row__val--accent {
    color: var(--color-accent);
  }

  .st-roi-footnote {
    text-align: left;
    line-height: 1.7;
    color: var(--color-text-mid);
    font-size: var(--text-sm);
    margin-top: var(--space-6);
  }

  @media (max-width: 768px) {
    .st-roi-table {
      grid-template-columns: repeat(2, 1fr);
    }

    .st-roi-row:nth-child(2) {
      border-right: none;
    }

    .st-roi-row:nth-child(1),
    .st-roi-row:nth-child(2) {
      border-bottom: 1px solid var(--color-border);
      padding-bottom: var(--space-4);
    }
  }

  @media (max-width: 480px) {
    .st-roi-table {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ZIELGRUPPEN — 2 Column Split */
  .st-zielgruppen-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
  }

  .st-zg-block {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .st-zg-block__icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-light);
    color: var(--color-accent);
    border-radius: var(--radius-sm);
  }

  .st-zg-block h3 {
    font-size: var(--text-xl);
  }

  .st-zg-block p {
    line-height: 1.7;
    color: var(--color-text-mid);
  }

  @media (max-width: 640px) {
    .st-zielgruppen-grid {
      grid-template-columns: 1fr;
    }
  }

  /* LOCAL INFO */
  .st-local-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .st-local-grid h4 {
    margin-bottom: var(--space-2);
  }

  .st-infra-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .st-infra-list li {
    font-size: var(--text-sm);
    color: var(--color-text-mid);
  }

  .st-infra-list li::before {
    content: '\2022  ';
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .st-local-grid {
      grid-template-columns: 1fr;
    }
  }

  /* CTA — accent-light background */
  .st-cta-section {
    background: rgba(59, 130, 246, 0.05);
    padding-block: var(--section-gap);
  }

  .st-cta__inner {
    text-align: center;
  }

  .st-cta__inner p {
    margin-bottom: var(--space-6);
  }

  .st-cta-form {
    display: flex;
    gap: var(--space-2);
    max-width: 520px;
    margin-inline: auto;
  }

  .st-cta-form input {
    flex: 1;
    min-width: 0;
  }

  @media (max-width: 480px) {
    .st-cta-form {
      flex-direction: column;
    }
  }

  /* NACHBAR LINKS */
  .st-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .st-link-group h4 {
    margin-bottom: var(--space-3);
  }

  .st-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .st-pill {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-mid);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all var(--duration-fast) var(--ease-default);
    min-height: 44px;
  }

  .st-pill:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }
</style>

<script>
  const form = document.getElementById('st-form') as HTMLFormElement;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const btn = form.querySelector('button') as HTMLButtonElement;
    btn.textContent = 'Wird gesendet...';
    btn.disabled = true;
    try {
      const res = await fetch('/api/bewertung', { method: 'POST', body: formData });
      if (res.ok) {
        window.location.href = '/danke?typ=verkaeufer';
      } else {
        btn.textContent = 'Fehler — erneut versuchen';
        btn.disabled = false;
      }
    } catch {
      btn.textContent = 'Fehler — erneut versuchen';
      btn.disabled = false;
    }
  });
</script>
