---
import Layout from '../../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const dir = path.join(process.cwd(), 'src', 'content', 'stadtteile');
  const files = fs.readdirSync(dir).filter((f: string) => f.endsWith('.json'));

  return files.map((file: string) => {
    const data = JSON.parse(fs.readFileSync(path.join(dir, file), 'utf-8'));
    return {
      params: { stadtteil: data.slug },
      props: { data },
    };
  });
}

interface StadtteilData {
  name: string;
  slug: string;
  bezirk: string;
  qm_unsaniert: number;
  qm_saniert: number;
  trend: string;
  trend_5j: string;
  typische_objekte: string;
  besonderheit: string;
  infrastruktur: string[];
  einwohner: number;
  sanierungsquote: string;
  nachbar_stadtteile: string[];
  definition: string;
  fliesstext: string;
  marktdaten_quelle: string;
  beispielrechnung_text: string;
  zielgruppe_verkaeufer: string;
  zielgruppe_kaeufer: string;
}

const { data } = Astro.props as { data: StadtteilData };

const kaufpreis = data.qm_unsaniert * 45;
const sanierung = 35000;
const nebenkosten = Math.round(kaufpreis * 0.105);
const gesamtInvest = kaufpreis + sanierung + nebenkosten;
const verkaufspreis = data.qm_saniert * 45;
const gewinn = verkaufspreis - gesamtInvest;

// Map slug to readable name for nachbar links
const slugDir = path.join(process.cwd(), 'src', 'content', 'stadtteile');
const allFiles = fs.readdirSync(slugDir).filter((f: string) => f.endsWith('.json'));
const slugMap: Record<string, string> = {};
allFiles.forEach((f: string) => {
  const d = JSON.parse(fs.readFileSync(path.join(slugDir, f), 'utf-8'));
  slugMap[d.slug] = d.name;
});

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": `wirkaufendeineimmobilie.de — ${data.name}`,
  "description": `Sanierungsbedürftige Wohnungen verkaufen in ${data.name}, Leipzig`,
  "areaServed": {
    "@type": "City",
    "name": "Leipzig",
    "containsPlace": {
      "@type": "Place",
      "name": data.name
    }
  },
  "telephone": "+49-341-800-900-0",
  "url": `https://wirkaufendeineimmobilie.build-upstream.com/leipzig/${data.slug}`
});

const breadcrumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://wirkaufendeineimmobilie.build-upstream.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Leipzig",
      "item": "https://wirkaufendeineimmobilie.build-upstream.com/leipzig/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": data.name
    }
  ]
});
---
<Layout
  title={`Sanierungsbedürftige Wohnung verkaufen in ${data.name} — wirkaufendeineimmobilie.de`}
  description={`${data.name} (Leipzig ${data.bezirk}): qm-Preise unsaniert ab ${data.qm_unsaniert} €, saniert bis ${data.qm_saniert} €. ${data.trend_5j} in 5 Jahren.`}
>

  <script type="application/ld+json" set:html={jsonLd} />
  <script type="application/ld+json" set:html={breadcrumbLd} />

  <!-- BREADCRUMB -->
  <nav class="st-breadcrumb" aria-label="Breadcrumb">
    <div class="container">
      <a href="/">Home</a> <span class="st-bc-sep">&rsaquo;</span>
      <span>Leipzig</span> <span class="st-bc-sep">&rsaquo;</span>
      <span class="st-bc-current">{data.name}</span>
    </div>
  </nav>

  <!-- HERO — links-ausgerichtet (asymmetrisch) -->
  <section class="section st-hero">
    <div class="container">
      <div class="label">{data.bezirk} &middot; Leipzig</div>
      <h1>Sanierungsbedürftige Wohnung<br />verkaufen in {data.name}</h1>
      <p class="st-hero__sub">{data.besonderheit}</p>
    </div>
  </section>

  <!-- 4 MARKET DATA CARDS — one highlighted -->
  <section class="st-market-section">
    <div class="container">
      <h2>Marktdaten {data.name}</h2>
      <div class="st-market-grid">
        <div class="st-market-card">
          <span class="st-market-card__val">{data.qm_unsaniert} &euro;/m&sup2;</span>
          <span class="st-market-card__label">Unsaniert</span>
        </div>
        <div class="st-market-card">
          <span class="st-market-card__val">{data.qm_saniert} &euro;/m&sup2;</span>
          <span class="st-market-card__label">Saniert</span>
        </div>
        <div class="st-market-card st-market-card--highlight">
          <span class="st-market-card__val">{data.trend}</span>
          <span class="st-market-card__label">Trend</span>
        </div>
        <div class="st-market-card">
          <span class="st-market-card__val">{data.trend_5j}</span>
          <span class="st-market-card__label">5-Jahres-Entwicklung</span>
        </div>
      </div>
      <p class="st-source">
        Quelle: {data.marktdaten_quelle}
      </p>
    </div>
  </section>

  <!-- CONTENT 2/3 + 1/3 SPLIT — Fliesstext links, Mikrolage-Check rechts (sticky) -->
  <section class="st-content-section">
    <div class="container st-content-grid">
      <div class="st-content-main">
        <h2>{data.name} als Immobilienstandort</h2>
        <div class="st-text-body" set:html={data.fliesstext} />
        <p class="st-source">
          Quelle: {data.marktdaten_quelle}
        </p>

        <!-- DEFINITION (AI-Citability) -->
        <p class="st-definition">{data.definition}</p>
      </div>

      <aside class="st-mikrolage-card">
        <h3>Mikrolage-Check</h3>
        <div class="st-mikrolage-items">
          <div class="st-mikrolage-item">
            <h4>Typische Objekte</h4>
            <p>{data.typische_objekte}</p>
          </div>
          <div class="st-mikrolage-item">
            <h4>Infrastruktur</h4>
            <ul class="st-infra-list">
              {data.infrastruktur.map((item: string) => <li>{item}</li>)}
            </ul>
          </div>
          <div class="st-mikrolage-item">
            <h4>Einwohner</h4>
            <p>{data.einwohner.toLocaleString('de-DE')}</p>
          </div>
          <div class="st-mikrolage-item">
            <h4>Sanierungsquote</h4>
            <p>{data.sanierungsquote}</p>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- ROI TABELLE — volle Breite in rounded Card -->
  <section class="st-roi-section">
    <div class="container">
      <h2>Beispielrechnung für {data.name}</h2>
      <p class="text-mid">45 m&sup2; Wohnung, typisches Sanierungsobjekt</p>
      <div class="st-roi-table-card">
        <table class="st-roi-table">
          <thead>
            <tr>
              <th>Position</th>
              <th>Betrag</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Kaufpreis (45 m&sup2; &times; {data.qm_unsaniert} &euro;)</td>
              <td class="st-roi-num">{kaufpreis.toLocaleString('de-DE')} &euro;</td>
            </tr>
            <tr>
              <td>Sanierungskosten</td>
              <td class="st-roi-num">{sanierung.toLocaleString('de-DE')} &euro;</td>
            </tr>
            <tr>
              <td>Nebenkosten (ca. 10,5%)</td>
              <td class="st-roi-num">{nebenkosten.toLocaleString('de-DE')} &euro;</td>
            </tr>
            <tr class="st-roi-subtotal">
              <td>Gesamtinvestition</td>
              <td class="st-roi-num">{gesamtInvest.toLocaleString('de-DE')} &euro;</td>
            </tr>
            <tr>
              <td>Verkaufspreis (45 m&sup2; &times; {data.qm_saniert} &euro;)</td>
              <td class="st-roi-num">{verkaufspreis.toLocaleString('de-DE')} &euro;</td>
            </tr>
            <tr class="st-roi-result">
              <td>Gewinn (vor Vermittlung)</td>
              <td class="st-roi-num">{gewinn.toLocaleString('de-DE')} &euro;</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="st-roi-footnote">{data.beispielrechnung_text}</p>
      <a href="/roi-rechner" class="btn btn-primary" style="margin-top: var(--space-6);">Exakt berechnen im ROI-Rechner &rarr;</a>
    </div>
  </section>

  <!-- ZIELGRUPPEN — 2 Column Split -->
  <section class="section">
    <div class="container">
      <div class="st-zielgruppen-grid">
        <div class="st-zg-block">
          <div class="st-zg-block__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/><path d="M9 21V12h6v9"/></svg>
          </div>
          <h3>Wer verkauft in {data.name}?</h3>
          <p>{data.zielgruppe_verkaeufer}</p>
        </div>
        <div class="st-zg-block">
          <div class="st-zg-block__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
          </div>
          <h3>Wer kauft in {data.name}?</h3>
          <p>{data.zielgruppe_kaeufer}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- DARK CTA SECTION -->
  <section class="st-dark-cta-section">
    <div class="container st-dark-cta__inner">
      <h2>Immobilie in {data.name} bewerten lassen</h2>
      <p>Kostenlos, unverbindlich — Erstbewertung innerhalb von 48 Stunden.</p>
      <form class="st-dark-cta-form" id="st-form" data-endpoint="/api/bewertung">
        <input
          type="text"
          name="plz"
          placeholder="PLZ eingeben..."
          pattern="[0-9]{5}"
          maxlength="5"
          required
          aria-label="Postleitzahl"
        />
        <button type="submit" class="btn btn-primary">Kostenlos bewerten &rarr;</button>
      </form>
    </div>
  </section>

  <!-- NACHBAR-STADTTEILE — Pill-Links -->
  <section class="section bg-alt">
    <div class="container st-links">
      {data.nachbar_stadtteile.length > 0 && (
        <div class="st-link-group">
          <h4>Nachbar-Stadtteile</h4>
          <div class="st-pills">
            {data.nachbar_stadtteile.map((slug: string) => (
              <a href={`/leipzig/${slug}`} class="st-pill">{slugMap[slug] || slug}</a>
            ))}
          </div>
        </div>
      )}
      <div class="st-link-group">
        <h4>Weitere Seiten</h4>
        <div class="st-pills">
          <a href="/roi-rechner" class="st-pill">ROI-Rechner</a>
          <a href="/so-funktionierts" class="st-pill">So funktioniert's</a>
          <a href="/" class="st-pill">Startseite</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* BREADCRUMB */
  .st-breadcrumb {
    padding-block: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .st-breadcrumb a {
    color: var(--color-text-muted);
  }

  .st-breadcrumb a:hover {
    color: var(--color-accent);
  }

  .st-bc-sep {
    margin-inline: var(--space-2);
    opacity: 0.5;
  }

  .st-bc-current {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }

  /* HERO — links-ausgerichtet, asymmetrisch */
  .st-hero {
    padding-bottom: var(--space-8);
    text-align: left;
  }

  .st-hero .container {
    max-width: 720px;
    margin-left: var(--container-padding);
    margin-right: auto;
  }

  @media (min-width: 1120px) {
    .st-hero .container {
      margin-left: calc((100% - var(--container-max)) / 2 + var(--container-padding));
    }
  }

  .st-hero .label {
    margin-bottom: var(--space-4);
  }

  .st-hero__sub {
    font-size: var(--text-lg);
    color: var(--color-text-mid);
    margin-top: var(--space-4);
  }

  /* MARKET DATA — 4 cards, one highlighted */
  .st-market-section {
    background: var(--color-bg-alt);
    padding-block: var(--section-gap);
  }

  .st-market-section h2 {
    margin-bottom: var(--space-6);
  }

  .st-market-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  .st-market-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    text-align: center;
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--duration-normal) var(--ease-default),
                transform var(--duration-normal) var(--ease-default);
  }

  .st-market-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  /* Highlighted card (Trend) */
  .st-market-card--highlight {
    background: rgba(59, 130, 246, 0.06);
    border-color: var(--color-accent);
    box-shadow:
      0 2px 4px rgba(59, 130, 246, 0.08),
      0 4px 12px rgba(59, 130, 246, 0.12);
  }

  .st-market-card--highlight .st-market-card__val {
    color: var(--color-accent);
  }

  .st-market-card__val {
    display: block;
    font-size: var(--text-2xl);
    font-weight: var(--weight-extrabold);
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  .st-market-card__label {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-text-mid);
    margin-top: var(--space-1);
  }

  .st-source {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: var(--space-4);
  }

  @media (max-width: 640px) {
    .st-market-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* CONTENT 2/3 + 1/3 SPLIT */
  .st-content-section {
    padding-block: var(--section-gap);
  }

  .st-content-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--space-10);
    align-items: start;
  }

  .st-content-main h2 {
    margin-bottom: var(--space-6);
  }

  .st-text-body {
    line-height: 1.8;
    color: var(--color-text-mid);
    column-count: 2;
    column-gap: var(--space-8);
  }

  .st-text-body :global(p) {
    margin-bottom: var(--space-4);
    break-inside: avoid;
  }

  .st-text-body :global(p:last-child) {
    margin-bottom: 0;
  }

  /* DEFINITION */
  .st-definition {
    font-size: var(--text-base);
    color: var(--color-text-mid);
    line-height: 1.7;
    font-style: italic;
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  /* MIKROLAGE CARD — sticky sidebar */
  .st-mikrolage-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 2rem;
    padding: var(--space-8);
    box-shadow: var(--shadow-lg);
    position: sticky;
    top: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .st-mikrolage-card h3 {
    font-size: var(--text-xl);
  }

  .st-mikrolage-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .st-mikrolage-item h4 {
    margin-bottom: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .st-mikrolage-item p {
    font-size: var(--text-sm);
    color: var(--color-text-mid);
  }

  .st-infra-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .st-infra-list li {
    font-size: var(--text-sm);
    color: var(--color-text-mid);
  }

  .st-infra-list li::before {
    content: '\2022  ';
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .st-content-grid {
      grid-template-columns: 1fr;
    }

    .st-mikrolage-card {
      position: static;
    }

    .st-text-body {
      column-count: 1;
    }
  }

  /* ROI TABLE — volle Breite in rounded Card */
  .st-roi-section {
    background: var(--color-bg-alt);
    padding-block: var(--section-gap);
  }

  .st-roi-section h2 {
    margin-bottom: var(--space-2);
  }

  .st-roi-section > .container {
    text-align: center;
  }

  .st-roi-table-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-md);
    margin-top: var(--space-8);
    overflow: hidden;
  }

  .st-roi-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .st-roi-table th {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-text-muted);
    padding: var(--space-3) var(--space-4);
    border-bottom: 2px solid var(--color-border);
  }

  .st-roi-table td {
    font-size: var(--text-base);
    color: var(--color-text-mid);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .st-roi-table tr:last-child td {
    border-bottom: none;
  }

  .st-roi-num {
    text-align: right;
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  /* Subtotal row */
  .st-roi-subtotal td {
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    border-bottom: 2px solid var(--color-border);
    padding-block: var(--space-4);
  }

  /* Result/Gewinn row — accent highlight */
  .st-roi-result td {
    font-weight: var(--weight-bold);
    font-size: var(--text-lg);
    background: rgba(59, 130, 246, 0.06);
    border-radius: 0;
    padding-block: var(--space-4);
  }

  .st-roi-result .st-roi-num {
    color: var(--color-accent);
    font-weight: var(--weight-extrabold);
  }

  .st-roi-footnote {
    text-align: left;
    line-height: 1.7;
    color: var(--color-text-mid);
    font-size: var(--text-sm);
    margin-top: var(--space-6);
  }

  /* ZIELGRUPPEN — 2 Column Split */
  .st-zielgruppen-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
  }

  .st-zg-block {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .st-zg-block__icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-light);
    color: var(--color-accent);
    border-radius: var(--radius-sm);
  }

  .st-zg-block h3 {
    font-size: var(--text-xl);
  }

  .st-zg-block p {
    line-height: 1.7;
    color: var(--color-text-mid);
  }

  @media (max-width: 640px) {
    .st-zielgruppen-grid {
      grid-template-columns: 1fr;
    }
  }

  /* DARK CTA SECTION */
  .st-dark-cta-section {
    background: var(--color-bg-dark);
    color: var(--color-text-on-dark);
    padding-block: var(--section-gap);
  }

  .st-dark-cta__inner {
    text-align: center;
  }

  .st-dark-cta__inner h2 {
    color: var(--color-text-on-dark);
    margin-bottom: var(--space-3);
  }

  .st-dark-cta__inner > p {
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
  }

  .st-dark-cta-form {
    display: flex;
    gap: var(--space-2);
    max-width: 520px;
    margin-inline: auto;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: var(--space-2);
  }

  .st-dark-cta-form input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    color: var(--color-text-on-dark);
    padding: var(--space-3) var(--space-4);
  }

  .st-dark-cta-form input::placeholder {
    color: var(--color-text-muted);
  }

  .st-dark-cta-form input:focus {
    outline: none;
    box-shadow: none;
  }

  @media (max-width: 480px) {
    .st-dark-cta-form {
      flex-direction: column;
    }
  }

  /* NACHBAR LINKS */
  .st-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .st-link-group h4 {
    margin-bottom: var(--space-3);
  }

  .st-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .st-pill {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-mid);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all var(--duration-fast) var(--ease-default);
    min-height: 44px;
  }

  .st-pill:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }
</style>

<script>
  const form = document.getElementById('st-form') as HTMLFormElement;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const btn = form.querySelector('button') as HTMLButtonElement;
    btn.textContent = 'Wird gesendet...';
    btn.disabled = true;
    try {
      const res = await fetch('/api/bewertung', { method: 'POST', body: formData });
      if (res.ok) {
        window.location.href = '/danke?typ=verkaeufer';
      } else {
        btn.textContent = 'Fehler — erneut versuchen';
        btn.disabled = false;
      }
    } catch {
      btn.textContent = 'Fehler — erneut versuchen';
      btn.disabled = false;
    }
  });
</script>
