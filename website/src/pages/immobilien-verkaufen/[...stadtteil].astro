---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import { STADTTEILE, SLUG_MAP } from '../../data/stadtteile-verkaufen';
import { getObjektTypText, getMilieuschutzText, MILIEUSCHUTZ_FAQ, ALLGEMEIN_FAQ, SZENARIEN } from '../../lib/stadtteile-verkaufen/copy';

export function getStaticPaths() {
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  return STADTTEILE
    .filter(st => st.publishDate !== null && new Date(st.publishDate) <= today)
    .map(st => ({
      params: { stadtteil: st.slug },
      props: { st },
    }));
}

const { st } = Astro.props;

const preisFormatted = st.preis.toLocaleString('de-DE');
const objektTypText = getObjektTypText(st.objekttyp, st.name);
const milieuschutzText = st.milieuschutz ? getMilieuschutzText(st.name) : null;

const canonicalUrl = `https://wirkaufendeineimmobilie.de/immobilien-verkaufen/${st.slug}`;

// JSON-LD
const businessId = `${canonicalUrl}#business`;

const jsonLdBusiness = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": businessId,
  "name": "wirkaufendeineimmobilie.de",
  "description": `Immobilienankauf in ${st.name} Leipzig — Erbschaft, Messie-Objekt, GEG-Sanierungspflicht`,
  "url": canonicalUrl,
  "areaServed": {
    "@type": "Place",
    "name": st.name,
    "containedInPlace": { "@type": "City", "name": "Leipzig" }
  },
  "priceRange": "Kostenlose Erstbewertung",
  "contactPoint": { "@type": "ContactPoint", "contactType": "customer service", "availableLanguage": "German" }
});

const jsonLdService = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${canonicalUrl}#service`,
  "name": `Immobilienankauf ${st.name}`,
  "serviceType": "Immobilienankauf",
  "provider": { "@id": businessId },
  "areaServed": {
    "@type": "Place",
    "name": st.name,
    "containedInPlace": { "@type": "City", "name": "Leipzig" }
  },
  "description": `Wir kaufen Immobilien in ${st.name} im Ist-Zustand. Aktueller Marktpreis: Ø ${preisFormatted} €/m² (Immowelt März 2026).`
});

const jsonLdBreadcrumb = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://wirkaufendeineimmobilie.de/" },
    { "@type": "ListItem", "position": 2, "name": "Immobilie verkaufen in Leipzig", "item": "https://wirkaufendeineimmobilie.de/immobilien-verkaufen/" },
    { "@type": "ListItem", "position": 3, "name": st.name }
  ]
});

const allFaqs = [
  ...ALLGEMEIN_FAQ,
  ...(st.milieuschutz ? MILIEUSCHUTZ_FAQ : []),
];
const jsonLdFaq = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": allFaqs.map(item => ({
    "@type": "Question",
    "name": item.question(st.name),
    "acceptedAnswer": { "@type": "Answer", "text": item.answer }
  }))
});
---

<Layout
  title={`Immobilie verkaufen ${st.name} Leipzig — ohne Makler`}
  description={`Wohnung in ${st.name} Leipzig verkaufen? Ø ${preisFormatted} €/m². Diskrete Abwicklung — Erbschaft, Messie-Objekt, Sanierungspflicht. 48h Erstbewertung.`}
>
  <script type="application/ld+json" set:html={jsonLdBusiness} />
  <script type="application/ld+json" set:html={jsonLdService} />
  <script type="application/ld+json" set:html={jsonLdBreadcrumb} />
  <script type="application/ld+json" set:html={jsonLdFaq} />

  <!-- BREADCRUMB -->
  <nav class="iv-breadcrumb" aria-label="Breadcrumb">
    <div class="container">
      <a href="/">Home</a>
      <span class="iv-bc-sep">&rsaquo;</span>
      <a href="/immobilien-verkaufen/">Immobilie verkaufen in Leipzig</a>
      <span class="iv-bc-sep">&rsaquo;</span>
      <span class="iv-bc-current">{st.name}</span>
    </div>
  </nav>

  <!-- S1: HERO -->
  <section class="section iv-hero">
    <div class="container">
      <div class="label">{st.bezirk} &middot; Leipzig</div>
      <h1>Immobilie verkaufen in {st.name}<br />— ohne Makler, ohne Stress.</h1>
      <p class="iv-hero__sub">
        Aktueller Marktpreis: Ø <strong>{preisFormatted} €/m²</strong> (Immowelt März 2026).
        Wir kaufen im Ist-Zustand — auch bei Erbschaft, Sanierungsstau oder schwieriger Eigentümersituation.
      </p>
      <form class="iv-form" id="iv-form-hero" data-stadtteil={st.slug}>
        <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off" />
        <div class="iv-form__row">
          <input type="text" name="vorname" placeholder="Vorname" required aria-label="Vorname" />
          <input type="text" name="nachname" placeholder="Nachname" required aria-label="Nachname" />
        </div>
        <input type="email" name="email" placeholder="E-Mail-Adresse" required aria-label="E-Mail" />
        <input type="tel" name="telefon" placeholder="Telefonnummer (optional)" aria-label="Telefon" />
        <input type="text" name="plz" placeholder="PLZ der Immobilie" pattern="[0-9]{5}" maxlength="5" required aria-label="PLZ" />
        <button type="submit" class="btn btn-primary iv-form__btn">Kostenlos bewerten &rarr;</button>
      </form>
    </div>
  </section>

  <!-- TRUST BAR -->
  <div class="iv-trust-bar">
    <div class="container">
      <div class="iv-trust-bar__inner">
        <div class="iv-trust-item">
          <span class="iv-trust-val">48 h</span>
          <span class="iv-trust-label">Erste Rückmeldung</span>
        </div>
        <div class="iv-trust-sep" aria-hidden="true" />
        <div class="iv-trust-item">
          <span class="iv-trust-val">0 €</span>
          <span class="iv-trust-label">Maklercourtage</span>
        </div>
        <div class="iv-trust-sep" aria-hidden="true" />
        <div class="iv-trust-item">
          <span class="iv-trust-val">Kein Portal</span>
          <span class="iv-trust-label">Diskreter Verkauf</span>
        </div>
        <div class="iv-trust-sep" aria-hidden="true" />
        <div class="iv-trust-item">
          <span class="iv-trust-val">Ist-Zustand</span>
          <span class="iv-trust-label">Kein Renovieren</span>
        </div>
      </div>
    </div>
  </div>

  <!-- PROZESS -->
  <section class="section iv-prozess-section">
    <div class="container">
      <h2>So läuft der Verkauf ab</h2>
      <div class="iv-prozess-steps">
        <div class="iv-prozess-step">
          <div class="iv-prozess-num">1</div>
          <div class="iv-prozess-body">
            <h3>Anfrage stellen</h3>
            <p>Formular ausfüllen oder anrufen. Kostenlos, unverbindlich, 2 Minuten.</p>
          </div>
        </div>
        <div class="iv-prozess-line" aria-hidden="true" />
        <div class="iv-prozess-step">
          <div class="iv-prozess-num">2</div>
          <div class="iv-prozess-body">
            <h3>Joachim meldet sich</h3>
            <p>Innerhalb von 48 h — mit einer ersten Einschätzung und einem konkreten Angebot.</p>
          </div>
        </div>
        <div class="iv-prozess-line" aria-hidden="true" />
        <div class="iv-prozess-step">
          <div class="iv-prozess-num">3</div>
          <div class="iv-prozess-body">
            <h3>Notartermin</h3>
            <p>Beim Ja: Abwicklung in 2–4 Wochen. Kein Makler, kein Portal, kein Stress.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SITUATIONEN -->
  <section class="iv-situationen-section">
    <div class="container">
      <h2>Wann rufen Eigentümer in {st.name} uns an?</h2>
      <div class="iv-situationen-grid">
        <div class="iv-situation-card">
          <h3>Erbschaft & Erbengemeinschaft</h3>
          <p>Das Haus gehört mehreren Erben — einer blockiert, alle haften. Wir machen ein transparentes Angebot an alle Parteien gleichzeitig. Kein Feilschen, keine Bevorteilung.</p>
        </div>
        <div class="iv-situation-card">
          <h3>GEG-Sanierungspflicht</h3>
          <p>Energetische Pflichten fressen die Rendite. Wenn sich Sanieren nicht lohnt, kaufen wir im Ist-Zustand — ohne Auflagen, ohne Vorwürfe.</p>
        </div>
        <div class="iv-situation-card">
          <h3>Schwierige Ausgangslage</h3>
          <p>Messie-Objekt, Schimmel, Streit unter Eigentümern, Scheidung: Wir besichtigen diskret — ohne Fotos, ohne Portal, ohne Ghosting.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- MARKTDATEN (kompakt) -->
  <section class="iv-market-section">
    <div class="container">
      <div class="iv-market-header">
        <h2>Marktdaten {st.name}</h2>
        {st.milieuschutz && <span class="iv-milieu-badge">Milieuschutz · § 172 BauGB</span>}
      </div>
      <div class="iv-stats-bar">
        <div class="iv-stat-main">
          <span class="iv-stat-main__val">Ø {preisFormatted} €/m²</span>
          <span class="iv-stat-main__label">Marktpreis Bestandswohnungen</span>
        </div>
        {st.bodenrichtwert && (
          <>
            <div class="iv-stat-divider" aria-hidden="true" />
            <div class="iv-stat-secondary">
              <span class="iv-stat-secondary__val">{st.bodenrichtwert.toLocaleString('de-DE')} €/m²</span>
              <span class="iv-stat-secondary__label">Bodenrichtwert 2024</span>
            </div>
          </>
        )}
      </div>
      <p class="iv-objekt-note">{objektTypText}</p>
      <p class="iv-source">Quelle: Immowelt Preisatlas, März 2026. Offizielle Transaktionsdaten: Gutachterausschuss Leipzig 2024.</p>
    </div>
  </section>

  <!-- BODENRICHTWERT (conditional) -->
  {st.bodenrichtwert && (
    <section class="iv-brw-section">
      <div class="container">
        <h2>Bodenrichtwert in {st.name} — was bedeutet das für den Verkaufspreis?</h2>
        <div class="iv-brw-compare">
          <div class="iv-brw-box">
            <span class="iv-brw-val">{st.bodenrichtwert.toLocaleString('de-DE')} €/m²</span>
            <span class="iv-brw-label">Bodenrichtwert 2024<br />(Gutachterausschuss Leipzig)</span>
          </div>
          <div class="iv-brw-arrow" aria-hidden="true">→</div>
          <div class="iv-brw-box iv-brw-box--market">
            <span class="iv-brw-val">Ø {preisFormatted} €/m²</span>
            <span class="iv-brw-label">Tatsächlicher Marktpreis<br />(Immowelt März 2026)</span>
          </div>
        </div>
        <p class="iv-brw-text">
          Der Bodenrichtwert beschreibt den Wert des unbebauten Grundstücks — als würde auf deinem Grundstück nichts stehen.
          Der tatsächliche Verkaufspreis einer Bestandsimmobilie liegt fast immer deutlich darüber, weil Bauzustand,
          Ausstattung, Energieeffizienz und Nachfrage hinzukommen.
          <a href="/blog/bodenrichtwert-leipzig" class="iv-brw-link">Mehr zum Unterschied Bodenrichtwert vs. Verkehrswert →</a>
        </p>
      </div>
    </section>
  )}

  <!-- MILIEUSCHUTZ (conditional) -->
  {st.milieuschutz && milieuschutzText && (
    <section class="iv-milieu-section">
      <div class="container">
        <h2>Milieuschutz in {st.name} — was bedeutet das für den Verkauf?</h2>
        <p class="iv-milieu-text">{milieuschutzText}</p>
        <div class="iv-faq-list">
          {MILIEUSCHUTZ_FAQ.map(item => (
            <details class="iv-faq-item">
              <summary class="iv-faq-q">{item.question(st.name)}</summary>
              <p class="iv-faq-a">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ (minimal, SEO) -->
  <section class="iv-faq-section">
    <div class="container">
      <h2>Häufige Fragen</h2>
      <div class="iv-faq-list">
        {[...ALLGEMEIN_FAQ, ...(st.milieuschutz ? MILIEUSCHUTZ_FAQ : [])].map(item => (
          <details class="iv-faq-item">
            <summary class="iv-faq-q">{item.question(st.name)}</summary>
            <p class="iv-faq-a">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- S6: CTA JOACHIM -->
  <section class="iv-cta-section">
    <div class="container iv-cta-inner">
      <h2>Immobilie in {st.name} bewerten lassen</h2>
      <form class="iv-form iv-form--cta" id="iv-form-cta" data-stadtteil={st.slug}>
        <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off" />
        <div class="iv-form__row">
          <input type="text" name="vorname" placeholder="Vorname" required aria-label="Vorname" />
          <input type="text" name="nachname" placeholder="Nachname" required aria-label="Nachname" />
        </div>
        <input type="email" name="email" placeholder="E-Mail-Adresse" required aria-label="E-Mail" />
        <input type="tel" name="telefon" placeholder="Telefonnummer (optional)" aria-label="Telefon" />
        <input type="text" name="plz" placeholder="PLZ der Immobilie" pattern="[0-9]{5}" maxlength="5" required aria-label="PLZ" />
        <button type="submit" class="btn btn-primary iv-form__btn">Kostenlos bewerten &rarr;</button>
      </form>
      <div class="iv-joachim">
        <img src="/images/joachim-kleinke-portrait.webp" alt="Joachim Kleinke" class="iv-joachim__img" width="64" height="64" />
        <div class="iv-joachim__info">
          <strong>Joachim Kleinke</strong>
          <span>Immobilienankauf Leipzig</span>
          <p class="iv-joachim__quote">„Ich melde mich innerhalb der nächsten 48 h bei Ihnen mit einer kostenlosen Ersteinschätzung."</p>
        </div>
      </div>
      <a href="/roi-rechner" class="iv-roi-link">→ ROI-Rechner: Wieviel ist Ihre Immobilie wert?</a>
    </div>
  </section>

  <!-- S7: LINKS -->
  <section class="section iv-links-section bg-alt">
    <div class="container iv-links">
      {st.nachbarn.length > 0 && (
        <div class="iv-link-group">
          <h4>Nachbar-Stadtteile</h4>
          <div class="iv-pills">
            {st.nachbarn.map(slug => (
              <a href={`/immobilien-verkaufen/${slug}`} class="iv-pill">
                {SLUG_MAP[slug] || slug}
              </a>
            ))}
          </div>
        </div>
      )}
      <div class="iv-link-group">
        <h4>Weitere Seiten</h4>
        <div class="iv-pills">
          <a href="/immobilien-verkaufen/" class="iv-pill">Alle Stadtteile Leipzig</a>
          <a href="/roi-rechner" class="iv-pill">ROI-Rechner</a>
          <a href="/so-funktionierts" class="iv-pill">So funktioniert's</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* BREADCRUMB */
  .iv-breadcrumb { padding-block: var(--space-4); font-size: var(--text-sm); color: var(--color-text-muted); }
  .iv-breadcrumb a { color: var(--color-text-muted); }
  .iv-breadcrumb a:hover { color: var(--color-accent); }
  .iv-bc-sep { margin-inline: var(--space-2); opacity: 0.5; }
  .iv-bc-current { color: var(--color-text); font-weight: var(--weight-medium); }

  /* HERO */
  .iv-hero { padding-bottom: var(--space-8); }
  .iv-hero__sub { font-size: var(--text-lg); color: var(--color-text-mid); margin-top: var(--space-4); margin-bottom: var(--space-8); }

  /* FORM */
  .iv-form { display: flex; flex-direction: column; gap: var(--space-3); max-width: 520px; }
  .iv-form__row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }
  .iv-form input { padding: var(--space-3) var(--space-4); border: 1px solid var(--color-border); border-radius: var(--radius-md); font-size: var(--text-base); background: var(--color-bg-card); color: var(--color-text); width: 100%; }
  .iv-form input:focus { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .iv-form__btn { align-self: flex-start; }
  @media (max-width: 480px) { .iv-form__row { grid-template-columns: 1fr; } .iv-form__btn { width: 100%; } }

  /* MARKET */
  .iv-market-section { background: var(--color-bg-alt); padding-block: var(--section-gap); }
  .iv-market-header { display: flex; align-items: baseline; gap: var(--space-4); flex-wrap: wrap; margin-bottom: var(--space-8); }
  .iv-market-header h2 { margin-bottom: 0; }
  .iv-milieu-badge { display: inline-flex; align-items: center; padding: var(--space-1) var(--space-3); font-size: var(--text-sm); font-weight: var(--weight-medium); color: #92400e; background: rgba(251,191,36,0.12); border: 1px solid rgba(251,191,36,0.35); border-radius: var(--radius-full); white-space: nowrap; }
  .iv-stats-bar { display: flex; align-items: center; gap: var(--space-8); flex-wrap: wrap; }
  .iv-stat-main { display: flex; flex-direction: column; gap: var(--space-1); }
  .iv-stat-main__val { font-size: clamp(var(--text-3xl), 4vw, var(--text-4xl)); font-weight: var(--weight-extrabold); color: var(--color-accent); line-height: 1; letter-spacing: -0.02em; }
  .iv-stat-main__label { font-size: var(--text-sm); color: var(--color-text-muted); }
  .iv-stat-divider { width: 1px; height: 48px; background: var(--color-border); flex-shrink: 0; }
  .iv-stat-secondary { display: flex; flex-direction: column; gap: var(--space-1); }
  .iv-stat-secondary__val { font-size: var(--text-2xl); font-weight: var(--weight-bold); color: var(--color-text); line-height: 1; }
  .iv-stat-secondary__label { font-size: var(--text-sm); color: var(--color-text-muted); }
  .iv-source { font-size: var(--text-xs); color: var(--color-text-muted); margin-top: var(--space-6); }

  /* TRUST BAR */
  .iv-trust-bar { background: var(--color-bg-dark); }
  .iv-trust-bar__inner { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; padding-block: var(--space-6); }
  .iv-trust-item { display: flex; flex-direction: column; align-items: center; gap: var(--space-1); padding: var(--space-4) var(--space-8); }
  .iv-trust-val { font-size: var(--text-xl); font-weight: var(--weight-bold); color: var(--color-text-on-dark); }
  .iv-trust-label { font-size: var(--text-xs); color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 0.05em; }
  .iv-trust-sep { width: 1px; height: 40px; background: rgba(255,255,255,0.12); flex-shrink: 0; }
  @media (max-width: 600px) { .iv-trust-sep { display: none; } .iv-trust-item { padding: var(--space-3) var(--space-5); } }

  /* PROZESS */
  .iv-prozess-section { background: var(--color-bg-alt); }
  .iv-prozess-steps { display: flex; align-items: flex-start; margin-top: var(--space-8); }
  .iv-prozess-step { display: flex; gap: var(--space-5); flex: 1; }
  .iv-prozess-num { width: 40px; height: 40px; border-radius: 50%; background: var(--color-accent); color: white; font-weight: var(--weight-bold); font-size: var(--text-lg); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .iv-prozess-body h3 { margin-bottom: var(--space-2); font-size: var(--text-lg); }
  .iv-prozess-body p { font-size: var(--text-sm); color: var(--color-text-mid); line-height: 1.7; }
  .iv-prozess-line { flex: 0 0 60px; height: 1px; background: var(--color-border); margin-top: 20px; }
  @media (max-width: 768px) { .iv-prozess-steps { flex-direction: column; gap: var(--space-6); } .iv-prozess-line { width: 1px; height: 32px; flex: 0 0 32px; margin-top: 0; margin-left: 20px; } }

  /* SITUATIONEN */
  .iv-situationen-section { background: var(--color-bg); padding-block: var(--section-gap); }
  .iv-situationen-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); margin-top: var(--space-8); }
  .iv-situation-card { padding: var(--space-7); border-left: 3px solid var(--color-accent); background: var(--color-bg-alt); border-radius: 0 var(--radius-lg) var(--radius-lg) 0; }
  .iv-situation-card h3 { font-size: var(--text-lg); margin-bottom: var(--space-3); }
  .iv-situation-card p { font-size: var(--text-sm); line-height: 1.75; color: var(--color-text-mid); }
  @media (max-width: 900px) { .iv-situationen-grid { grid-template-columns: 1fr; } }

  /* MARKT NOTE */
  .iv-objekt-note { font-size: var(--text-sm); color: var(--color-text-mid); line-height: 1.7; max-width: 720px; margin-top: var(--space-6); margin-bottom: var(--space-2); }

  /* MILIEUSCHUTZ */
  .iv-milieu-section { background: rgba(234,179,8,0.04); border-top: 1px solid rgba(234,179,8,0.2); border-bottom: 1px solid rgba(234,179,8,0.2); padding-block: var(--section-gap); }
  .iv-milieu-section h2 { margin-bottom: var(--space-4); }
  .iv-milieu-text { font-size: var(--text-base); line-height: 1.8; color: var(--color-text-mid); max-width: 720px; margin-bottom: var(--space-6); }
  .iv-faq-list { display: flex; flex-direction: column; gap: var(--space-3); max-width: 720px; }
  .iv-faq-item { border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-4); background: var(--color-bg-card); }
  .iv-faq-q { font-weight: var(--weight-semibold); cursor: pointer; list-style: none; color: var(--color-text); }
  .iv-faq-q::marker, .iv-faq-q::-webkit-details-marker { display: none; }
  .iv-faq-q::before { content: '+ '; color: var(--color-accent); }
  details[open] .iv-faq-q::before { content: '− '; }
  .iv-faq-a { margin-top: var(--space-3); font-size: var(--text-sm); color: var(--color-text-mid); line-height: 1.7; }

