---
import Layout from '../../layouts/Layout.astro';
import FormPrivacyHint from '../../components/FormPrivacyHint.astro';
---
<Layout
  title="Aktionsplan Erbengemeinschaft — persönlich erstellt"
  description="Beantworte 5 Fragen zu deiner Erbengemeinschaft. Joachim Kleinke erstellt deinen persönlichen 7-Schritte Aktionsplan. Kostenlos."
>

  <section class="section ap-hero">
    <div class="container ap-hero__inner">
      <div class="label">Persönlich erstellt von Joachim Kleinke</div>
      <h1>Dein 7-Schritte Aktionsplan —<br /><span class="text-accent">auf deine Erbengemeinschaft zugeschnitten</span></h1>
      <p class="ap-hero__sub">Wir erstellen deinen Aktionsplan basierend auf deinen Angaben —
        mit konkreten Empfehlungen für deine Situation. Dafür brauchen wir
        ein paar Informationen von dir. Joachim Kleinke und sein Team schauen sich das an
        und schicken dir deinen persönlichen Aktionsplan, auf deine
        Erbengemeinschaft zugeschnitten. Kostenlos.</p>

      <div class="ap-steps">
        <div class="ap-step">
          <div class="ap-step__icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          </div>
          <div class="ap-step__label">5 Fragen beantworten</div>
          <div class="ap-step__detail">2 Minuten</div>
        </div>
        <div class="ap-step">
          <div class="ap-step__icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="ap-step__label">Joachim analysiert deine Situation</div>
          <div class="ap-step__detail">Persönlich, nicht automatisiert</div>
        </div>
        <div class="ap-step">
          <div class="ap-step__icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </div>
          <div class="ap-step__label">Dein Aktionsplan in 24h</div>
          <div class="ap-step__detail">Individuell, mit konkreten Zahlen</div>
        </div>
      </div>

      <!-- EMAIL GATE -->
      <div id="email-gate" class="ap-email-gate">
        <p class="ap-email-gate__label">Wohin sollen wir deinen Aktionsplan schicken?</p>
        <form id="gate-form" class="ap-email-gate__form" novalidate>
          <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off" />
          <input type="hidden" name="typ" value="aktionsplan-erben" />
          <div class="ap-gate-row">
            <input type="text" name="name" placeholder="Dein Vorname" class="ap-gate-input" />
            <input type="email" name="email" placeholder="Deine E-Mail *" required class="ap-gate-input" />
          </div>
          <FormPrivacyHint />
          <div class="cf-turnstile" data-sitekey={import.meta.env.TURNSTILE_SITE_KEY || ''} data-theme="dark" data-size="compact"></div>
          <button type="submit" class="btn btn-primary ap-hero__cta">Aktionsplan anfordern &rarr;</button>
        </form>
      </div>
      <!-- FAST FERTIG SCREEN -->
      <div id="doi-pending" class="ap-doi-pending" hidden>
        <div style="font-size:2.5rem; margin-bottom:1rem;">✉️</div>
        <h3>Fast fertig — check deine E-Mails!</h3>
        <p>Wir haben dir gerade eine E-Mail von <strong>office@wirkaufendeineimmobilie.de</strong> geschickt. Klick auf den Bestätigungslink — dann erhältst du deinen Aktionsplan.</p>
        <div class="ap-doi-benefits">
          <p><strong>Was dich erwartet:</strong></p>
          <ul>
            <li>✓ 7 priorisierte Schritte für deine Situation</li>
            <li>✓ Blockade-Kosten-Rechner (was dich der Stillstand kostet)</li>
            <li>✓ Verhandlungs-Skript für den blockierenden Erben</li>
            <li>✓ Marktwert-Schätzung für dein Objekt</li>
          </ul>
        </div>
        <p style="font-size:0.85rem; opacity:0.7;">⚠️ Mail nicht da? Schau in deinen Spam-Ordner.</p>
      </div>

      <!-- Includes-Liste als 2-Spalten Grid Card -->
      <div class="ap-includes-card">
        <p class="ap-includes-card__title">Dein Aktionsplan enthält:</p>
        <ul class="ap-includes-grid">
          <li>
            <svg class="ap-check" width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="var(--color-accent)"/><path d="M6 10.5l2.5 2.5L14 7.5" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>7 konkrete Schritte — priorisiert für deine Situation</span>
          </li>
          <li>
            <svg class="ap-check" width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="var(--color-accent)"/><path d="M6 10.5l2.5 2.5L14 7.5" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>Blockade-Rechner: Was dich der Stillstand jeden Monat kostet</span>
          </li>
          <li>
            <svg class="ap-check" width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="var(--color-accent)"/><path d="M6 10.5l2.5 2.5L14 7.5" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>Verhandlungs-Skript für das Gespräch mit dem blockierenden Erben</span>
          </li>
          <li>
            <svg class="ap-check" width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="var(--color-accent)"/><path d="M6 10.5l2.5 2.5L14 7.5" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>Lokale Kontakte: Nachlassgericht und Fachanwälte in deiner Region</span>
          </li>
          <li>
            <svg class="ap-check" width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="var(--color-accent)"/><path d="M6 10.5l2.5 2.5L14 7.5" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>Marktwert-Schätzung für dein Objekt</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('gate-form') as HTMLFormElement | null;
    const gate = document.getElementById('email-gate') as HTMLElement | null;
    const pending = document.getElementById('doi-pending') as HTMLElement | null;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = form?.querySelector('[name="email"]') as HTMLInputElement | null;
      if (!emailInput?.value) { emailInput?.focus(); return; }
      const checkbox = form?.querySelector('[name="datenschutz_ok"]') as HTMLInputElement | null;
      if (checkbox && !checkbox.checked) { checkbox.focus(); return; }
      const btn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (btn) { btn.textContent = 'Wird gesendet...'; btn.disabled = true; }
      try {
        const fd = new FormData(form!);
        const res = await fetch('/api/lead-magnet', { method: 'POST', body: fd });
        if (res.ok) {
          if (gate) gate.hidden = true;
          if (pending) pending.hidden = false;
        } else {
          if (btn) { btn.textContent = 'Fehler — erneut versuchen'; btn.disabled = false; }
        }
      } catch {
        if (btn) { btn.textContent = 'Fehler — erneut versuchen'; btn.disabled = false; }
      }
    });
  </script>

  <!-- TRUST SECTION — 2 Column Split -->
  <section class="section ap-trust-section">
    <div class="container">
      <div class="ap-trust-grid">
        <!-- LEFT: Joachim Card -->
        <div class="ap-joachim-card">
          <div class="ap-joachim-photo">
            <svg width="64" height="64" viewBox="0 0 64 64" fill="none" aria-hidden="true">
              <rect width="64" height="64" rx="16" fill="var(--color-bg-alt)"/>
              <circle cx="32" cy="24" r="10" stroke="var(--color-text-muted)" stroke-width="1.5" fill="none"/>
              <path d="M16 52c0-8.837 7.163-16 16-16s16 7.163 16 16" stroke="var(--color-text-muted)" stroke-width="1.5" fill="none"/>
            </svg>
          </div>
          <div class="ap-joachim-stars" aria-label="5 von 5 Sternen">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="var(--color-warning)"><path d="M8 0l2.47 5.01L16 5.81l-4 3.9.94 5.49L8 12.35 3.06 15.2 4 9.71 0 5.81l5.53-.8z"/></svg>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="var(--color-warning)"><path d="M8 0l2.47 5.01L16 5.81l-4 3.9.94 5.49L8 12.35 3.06 15.2 4 9.71 0 5.81l5.53-.8z"/></svg>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="var(--color-warning)"><path d="M8 0l2.47 5.01L16 5.81l-4 3.9.94 5.49L8 12.35 3.06 15.2 4 9.71 0 5.81l5.53-.8z"/></svg>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="var(--color-warning)"><path d="M8 0l2.47 5.01L16 5.81l-4 3.9.94 5.49L8 12.35 3.06 15.2 4 9.71 0 5.81l5.53-.8z"/></svg>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="var(--color-warning)"><path d="M8 0l2.47 5.01L16 5.81l-4 3.9.94 5.49L8 12.35 3.06 15.2 4 9.71 0 5.81l5.53-.8z"/></svg>
          </div>
          <blockquote class="ap-joachim-quote">
            &bdquo;Jede Erbengemeinschaft ist anders. Deshalb erstelle ich jeden Aktionsplan persönlich.&ldquo;
          </blockquote>
          <p class="ap-joachim-name">Joachim Kleinke</p>
          <div class="ap-joachim-stats">
            <div class="ap-joachim-stat">
              <span class="ap-joachim-stat__num">200+</span>
              <span class="ap-joachim-stat__label">Aktionspläne erstellt</span>
            </div>
            <div class="ap-joachim-stat">
              <span class="ap-joachim-stat__num">15 Jahre</span>
              <span class="ap-joachim-stat__label">Immobilien-Erfahrung</span>
            </div>
          </div>
        </div>

        <!-- RIGHT: Copy -->
        <div class="ap-trust-copy">
          <h2>Warum dieser Aktionsplan den Unterschied macht</h2>
          <p>
            Die meisten Erbengemeinschaften verlieren Geld — nicht weil die Immobilie schlecht ist,
            sondern weil niemand den ersten Schritt kennt. Unser Aktionsplan gibt dir eine klare
            Reihenfolge mit konkreten Handlungsanweisungen.
          </p>
          <p>
            Joachim Kleinke hat über 200 Erbengemeinschaften begleitet und kennt die typischen
            Blockaden. Dein Aktionsplan basiert auf echten Erfahrungswerten — keine generischen
            Checklisten aus dem Internet.
          </p>
          <ul class="ap-trust-bullets">
            <li>Individuelle Analyse deiner Erbengemeinschafts-Konstellation</li>
            <li>Konkrete Zahlen: Was die Verzögerung kostet, was der Verkauf bringt</li>
            <li>Persönliche Empfehlung von Joachim — nicht von einem Algorithmus</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .ap-hero {
    text-align: center;
    padding-top: var(--space-20);
    padding-bottom: var(--space-16);
  }

  .ap-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    max-width: 800px;
    margin: 0 auto;
  }

  .ap-hero__sub {
    color: var(--color-text-mid);
    font-size: var(--text-lg);
    max-width: 640px;
    line-height: var(--leading-relaxed);
  }

  /* STEPS — 64x64 icons, white bg, shadow, border, divider lines */
  .ap-steps {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin: var(--space-6) 0;
    width: 100%;
    max-width: 700px;
  }

  .ap-step {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
    position: relative;
  }

  /* Divider line between steps via ::after */
  .ap-step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 32px;
    right: calc(-1 * var(--space-4) / 2 - 20px);
    width: 40px;
    height: 2px;
    background: var(--color-border-strong);
  }

  .ap-step__icon {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-lg);
    background: var(--color-bg-card);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
  }

  .ap-step__label {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    line-height: var(--leading-snug);
  }

  .ap-step__detail {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @media (max-width: 600px) {
    .ap-steps { flex-direction: column; align-items: center; gap: var(--space-4); }
    .ap-step { flex-direction: row; text-align: left; gap: var(--space-3); }
    .ap-step::after { display: none; }
    .ap-step__icon { width: 52px; height: 52px; flex-shrink: 0; }
    .ap-step__icon svg { width: 26px; height: 26px; }
  }

  /* CTA Button — groesser */
  .ap-hero__cta {
    margin-top: var(--space-2);
    font-size: var(--text-lg);
    padding: var(--space-5) var(--space-10);
    border-radius: var(--radius-xl);
    transition: all var(--duration-normal) var(--ease-default);
    box-shadow:
      0 2px 4px rgba(59, 130, 246, 0.15),
      0 4px 16px rgba(59, 130, 246, 0.2),
      0 8px 32px rgba(59, 130, 246, 0.12);
  }

  .ap-hero__cta:hover {
    transform: scale(1.05);
  }

  /* INCLUDES — 2-Spalten Grid in weisser Card */
  .ap-includes-card {
    width: 100%;
    max-width: 700px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 1.5rem;
    padding: var(--space-8);
    box-shadow: var(--shadow-sm);
    text-align: left;
  }

  .ap-includes-card__title {
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-5);
    font-size: var(--text-lg);
  }

  .ap-includes-grid {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .ap-includes-grid li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-mid);
    line-height: var(--leading-snug);
  }

  .ap-check {
    flex-shrink: 0;
    margin-top: 1px;
  }

  @media (max-width: 600px) {
    .ap-includes-grid {
      grid-template-columns: 1fr;
    }
  }

  /* TRUST SECTION — 2 Column Split */
  .ap-trust-section {
    background: var(--color-bg-alt);
  }

  .ap-trust-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10);
    align-items: start;
  }

  @media (max-width: 768px) {
    .ap-trust-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Joachim Card */
  .ap-joachim-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 1.5rem;
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
    box-shadow: var(--shadow-md);
  }

  .ap-joachim-photo {
    width: 80px;
    height: 80px;
    border-radius: var(--radius-xl);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ap-joachim-stars {
    display: flex;
    gap: var(--space-1);
  }

  .ap-joachim-quote {
    font-size: var(--text-base);
    color: var(--color-text-mid);
    line-height: var(--leading-relaxed);
    font-style: italic;
    max-width: 320px;
  }

  .ap-joachim-name {
    font-weight: var(--weight-bold);
    font-size: var(--text-base);
  }

  .ap-joachim-stats {
    display: flex;
    gap: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    width: 100%;
    justify-content: center;
  }

  .ap-joachim-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }

  .ap-joachim-stat__num {
    font-size: var(--text-xl);
    font-weight: var(--weight-extrabold);
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  .ap-joachim-stat__label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Trust Copy (right side) */
  .ap-trust-copy h2 {
    margin-bottom: var(--space-5);
  }

  .ap-trust-copy p {
    color: var(--color-text-mid);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .ap-trust-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .ap-trust-bullets li {
    font-size: var(--text-sm);
    color: var(--color-text-mid);
    padding-left: var(--space-5);
    position: relative;
    line-height: var(--leading-snug);
  }

  .ap-trust-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .ap-email-gate { width: 100%; max-width: 560px; margin-top: var(--space-6); }
  .ap-email-gate__label { font-weight: 600; margin-bottom: 0.75rem; }
  .ap-email-gate__form { display: flex; flex-direction: column; gap: 0.75rem; }
  .ap-gate-row { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .ap-gate-input { flex: 1; min-width: 160px; padding: 0.75rem 1rem; border: 2px solid var(--color-border); border-radius: 8px; font-family: inherit; font-size: 1rem; background: var(--color-bg); color: var(--color-text); min-height: 48px; }
  .ap-doi-pending { max-width: 560px; padding: 2rem 0; }
  .ap-doi-pending h3 { margin-bottom: 0.75rem; }
  .ap-doi-benefits { background: var(--color-bg-card, #f9f9f9); border: 1px solid var(--color-border, #e0e0e0); border-radius: 8px; padding: 1.25rem; text-align: left; margin: 1rem 0; }
  .ap-doi-benefits ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.5rem; }
</style>
