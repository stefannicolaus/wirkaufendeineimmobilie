---
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="Deine Situation — Immobilie bei Scheidung"
  description="3 kurze Fragen zu deiner Scheidungssituation"
  noindex={true}
>

  <section class="section">
    <div class="container">
      <div class="wizard">
        <div class="wizard-progress">
          <div class="wizard-progress-fill" id="progress-fill" style="width: 33%"></div>
        </div>
        <div class="wizard-step-label" id="step-label">Schritt 1 von 3</div>

        <!-- Step 1: Einigung -->
        <div class="wizard-step" data-step="1">
          <h2>Einigung mit dem Partner?</h2>
          <p class="text-mid">Das beeinflusst deine rechtlichen Optionen und den Zeitplan.</p>
          <div class="wizard-options">
            <button type="button" data-value="ja" data-field="einigung">Ja, wir sind uns einig</button>
            <button type="button" data-value="nein" data-field="einigung">Nein, keine Einigung</button>
            <button type="button" data-value="in-verhandlung" data-field="einigung">In Verhandlung</button>
          </div>
        </div>

        <!-- Step 2: Zeitdruck -->
        <div class="wizard-step" data-step="2" hidden>
          <h2>Wie viel Zeitdruck besteht?</h2>
          <p class="text-mid">Das hilft uns, die Prioritäten richtig zu setzen.</p>
          <div class="wizard-options">
            <button type="button" data-value="sofort" data-field="zeitdruck">Sofort — sehr dringend</button>
            <button type="button" data-value="3-monate" data-field="zeitdruck">In 3 Monaten</button>
            <button type="button" data-value="kein-druck" data-field="zeitdruck">Kein konkreter Zeitdruck</button>
          </div>
        </div>

        <!-- Step 3: PLZ + Submit -->
        <div class="wizard-step" data-step="3" hidden>
          <h2>PLZ der Immobilie</h2>
          <p class="text-mid">Für eine lokale Einschätzung des Marktes.</p>
          <div class="wizard-input-group">
            <input type="text" id="plz-input" inputmode="numeric" placeholder="z.B. 04109" maxlength="5" class="wizard-text-input" />
          </div>
          <button type="button" id="submit-btn" class="btn btn-primary" style="margin-top: var(--space-6);">Absenden &rarr;</button>
          <p id="submit-error" class="submit-error" hidden>Bitte PLZ eingeben</p>
        </div>

        <!-- Success Screen -->
        <div class="wizard-step" data-step="success" hidden>
          <div style="text-align:center; padding: var(--space-12) 0;">
            <div style="font-size:3rem; margin-bottom:1rem;">✓</div>
            <h2>Danke — wir melden uns!</h2>
            <p class="text-mid">Joachim Kleinke schaut sich deine Angaben persönlich an und antwortet innerhalb von 24 Stunden.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
  const steps = document.querySelectorAll('.wizard-step[data-step]');
  const progressFill = document.getElementById('progress-fill') as HTMLElement | null;
  const stepLabel = document.getElementById('step-label') as HTMLElement | null;
  const answers: Record<string, string> = {};
  let currentStep = 1;
  const totalSteps = 3;

  function showStep(n: number | 'success') {
    steps.forEach(s => {
      (s as HTMLElement).hidden = (s as HTMLElement).dataset.step !== String(n);
    });
    if (typeof n === 'number') {
      if (progressFill) progressFill.style.width = `${(n / totalSteps) * 100}%`;
      if (stepLabel) stepLabel.textContent = `Schritt ${n} von ${totalSteps}`;
    }
  }

  document.querySelectorAll('.wizard-options button').forEach(btn => {
    btn.addEventListener('click', () => {
      const field = (btn as HTMLElement).dataset.field!;
      const value = (btn as HTMLElement).dataset.value!;
      answers[field] = value;
      currentStep++;
      showStep(currentStep);
    });
  });

  document.getElementById('submit-btn')?.addEventListener('click', async () => {
    const plz = (document.getElementById('plz-input') as HTMLInputElement)?.value.trim();
    const errEl = document.getElementById('submit-error') as HTMLElement | null;
    if (!plz) {
      if (errEl) errEl.hidden = false;
      return;
    }
    if (errEl) errEl.hidden = true;

    const formData = new FormData();
    formData.append('typ', 'scheidung');
    formData.append('from_questionnaire', '1');
    Object.entries(answers).forEach(([k, v]) => formData.append(k, v));
    formData.append('plz', plz);

    // email was captured in the email gate on index.astro
    // we retrieve it from sessionStorage if available, otherwise skip
    const savedEmail = sessionStorage.getItem('wkdi_email') || '';
    const savedName = sessionStorage.getItem('wkdi_name') || '';
    if (savedEmail) formData.append('email', savedEmail);
    if (savedName) formData.append('name', savedName);

    try {
      await fetch('/api/lead-magnet', { method: 'POST', body: formData });
    } catch { /* silent — questionnaire data is best-effort */ }

    showStep('success');
  });
</script>

<style>
  .wizard { max-width: 600px; margin: 0 auto; padding: var(--space-12) 0; }
  .wizard-progress { height: 4px; background: var(--color-border); border-radius: 2px; margin-bottom: var(--space-3); }
  .wizard-progress-fill { height: 100%; background: var(--color-accent); border-radius: 2px; transition: width 0.3s ease; }
  .wizard-step-label { font-size: var(--text-sm); color: var(--color-text-muted); margin-bottom: var(--space-8); }
  .wizard-step h2 { margin-bottom: var(--space-3); }
  .wizard-options { display: flex; flex-direction: column; gap: var(--space-3); margin-top: var(--space-6); }
  .wizard-options button { padding: var(--space-4) var(--space-6); border: 2px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg); font-family: inherit; font-size: var(--text-base); cursor: pointer; text-align: left; transition: border-color 0.15s, background 0.15s; }
  .wizard-options button:hover { border-color: var(--color-accent); background: var(--color-bg-card, #f9f9f9); }
  .wizard-input-group { margin-top: var(--space-6); }
  .wizard-text-input { width: 100%; max-width: 200px; padding: var(--space-3) var(--space-4); border: 2px solid var(--color-border); border-radius: var(--radius-md); font-family: inherit; font-size: var(--text-lg); background: var(--color-bg); color: var(--color-text); }
  .submit-error { color: var(--color-error, red); font-size: var(--text-sm); margin-top: var(--space-2); }
</style>
