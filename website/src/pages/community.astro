            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- FOOTER CTA -->
  <section class="section bg-alt">
    <div class="container comm-footer-cta">
      <h2>Fehlt ein Thema?</h2>
      <p>Sag uns welche Gruppe du dir wünschst — wir bauen das Netzwerk mit dir.</p>
      <a href="mailto:office@wirkaufendeineimmobilie.de?subject=Community-Vorschlag" class="btn btn-outline">Vorschlag senden &rarr;</a>
    </div>
  </section>

</Layout>

<style>
  /* Hero */
  .comm-hero {
    text-align: center;
    padding-bottom: 0;
  }
  .comm-hero__inner {
    max-width: var(--container-narrow);
  }
  .comm-hero h1 {
    font-size: var(--text-3xl);
    font-weight: var(--weight-extrabold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin-top: var(--space-4);
  }
  .comm-hero__sub {
    font-size: var(--text-lg);
    color: var(--color-text-mid);
    margin-top: var(--space-4);
    line-height: var(--leading-normal);
  }

  /* Benefits */
  .comm-benefits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
    text-align: center;
  }
  .comm-benefit__icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-4);
    background: var(--color-accent-light);
    border-radius: var(--radius-lg);
    color: var(--color-accent);
  }
  .comm-benefit h3 {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-2);
  }
  .comm-benefit p {
    font-size: var(--text-sm);
    color: var(--color-text-mid);
    line-height: var(--leading-normal);
  }

  /* Section Header */
  .comm-section-header {
    text-align: center;
    max-width: var(--container-narrow);
    margin: 0 auto var(--space-12);
  }
  .comm-section-header h2 {
    font-size: var(--text-2xl);
    font-weight: var(--weight-extrabold);
    margin-top: var(--space-4);
  }
  .comm-section-header p {
    font-size: var(--text-base);
    color: var(--color-text-mid);
    margin-top: var(--space-3);
    line-height: var(--leading-normal);
  }

  /* Group Cards Grid */
  .comm-groups {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  /* Single Card */
  .comm-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: box-shadow var(--duration-normal) var(--ease-default),
                transform var(--duration-normal) var(--ease-default);
  }
  .comm-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  /* Card Image Placeholder */
  .comm-card__img {
    background: var(--color-bg-alt);
    padding: var(--space-10) var(--space-6);
  }
  .comm-card__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-muted);
    text-align: center;
  }
  .comm-card__placeholder span {
    font-size: var(--text-xs);
    font-style: italic;
    max-width: 280px;
  }

  /* Card Body */
  .comm-card__body {
    padding: var(--space-6);
  }
  .comm-card__body h3 {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-2);
  }
  .comm-card__body p {
    font-size: var(--text-sm);
    color: var(--color-text-mid);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-5);
  }

  /* WhatsApp CTA */
  .comm-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    background: #25D366;
    color: #fff;
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background var(--duration-normal) var(--ease-default),
                transform var(--duration-normal) var(--ease-default);
    min-height: 44px;
  }
  .comm-card__cta:hover {
    background: #1DAF54;
    transform: translateY(-1px);
  }

  /* Footer CTA */
  .comm-footer-cta {
    text-align: center;
    max-width: var(--container-narrow);
  }
  .comm-footer-cta h2 {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
  }
  .comm-footer-cta p {
    font-size: var(--text-base);
    color: var(--color-text-mid);
    margin: var(--space-3) 0 var(--space-6);
    line-height: var(--leading-normal);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .comm-benefits {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .comm-groups {
      grid-template-columns: 1fr;
    }
  }
</style>
