---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import FormPrivacyHint from '../components/FormPrivacyHint.astro';

const TURNSTILE_SITE_KEY = import.meta.env.TURNSTILE_SITE_KEY || '';
---
<Layout
  title="Community — Dein Immobilien-Netzwerk in Leipzig"
  description="5 kostenlose WhatsApp-Gruppen für Makler, Investoren, Handwerker, Tippgeber und Finanzierung. Jetzt registrieren und Zugang erhalten."
>

  <!-- HERO -->
  <section class="section comm-hero">
    <div class="container comm-hero__inner">
      <div class="label">Community</div>
      <h1>Werde Teil unseres <span class="text-accent">Immobilien-Netzwerks</span></h1>
      <p class="comm-hero__sub">5 WhatsApp-Gruppen. Echte Deals, echte Kontakte, echtes Wissen — kostenlos und direkt.</p>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="section bg-alt">
    <div class="container">
      <div class="comm-benefits">
        <div class="comm-benefit">
          <div class="comm-benefit__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3>Echte Kontakte</h3>
          <p>Makler, Investoren, Handwerker — direkt vernetzen statt anonym suchen.</p>
        </div>
        <div class="comm-benefit">
          <div class="comm-benefit__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <h3>Deals &amp; Objekte</h3>
          <p>Off-Market Angebote und Gesuche direkt aus der Region Leipzig.</p>
        </div>
        <div class="comm-benefit">
          <div class="comm-benefit__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </div>
          <h3>Sofort dabei</h3>
          <p>Kurz registrieren &rarr; freischalten &rarr; fertig. Kostenlos.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- GROUPS -->
  <section class="section">
    <div class="container">
      <div class="comm-section-header">
        <div class="label">5 Gruppen</div>
        <h2>Wähle dein Netzwerk</h2>
        <p>Jede Gruppe hat einen klaren Fokus. Tritt bei wo du hingehörst — oder gleich in mehrere.</p>
      </div>

      <div class="comm-groups">

        <!-- Makler -->
        <div class="comm-card">
          <div class="comm-card__img">
            <img src="/images/wkdi-deal-handshake-jung.webp" alt="Zwei Immobilienprofis beim Händedruck" loading="lazy" width="400" height="200" />
          </div>
          <div class="comm-card__body">
            <h3>Makler</h3>
            <p>Partnermakler &amp; Immobilienprofis — Objekte teilen, Kooperationen finden.</p>
            <span class="comm-card__gate">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              Registrierung erforderlich
            </span>
          </div>
        </div>

        <!-- Investoren -->
        <div class="comm-card">
          <div class="comm-card__img">
            <img src="/images/wkdi-investoren-deal.webp" alt="Investoren-Deal mit Grundrissen auf dem Tisch" loading="lazy" width="400" height="200" />
          </div>
          <div class="comm-card__body">
            <h3>Investoren</h3>
            <p>Fix &amp; Flip, Buy &amp; Hold, Kapitalanleger — Deals, Gesuche, Erfahrungen.</p>
            <span class="comm-card__gate">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              Registrierung erforderlich
            </span>
          </div>
        </div>

        <!-- Handwerker -->
        <div class="comm-card">
          <div class="comm-card__img">
            <img src="/images/wkdi-buyer-handwerker.webp" alt="Handwerker in Altbau-Sanierung" loading="lazy" width="400" height="200" />
          </div>
          <div class="comm-card__body">
            <h3>Handwerker</h3>
            <p>Gewerke, Dienstleister, Sanierung — Kapazitäten und Empfehlungen teilen.</p>
            <span class="comm-card__gate">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              Registrierung erforderlich
            </span>
          </div>
        </div>

        <!-- Tippgeber -->
        <div class="comm-card">
          <div class="comm-card__img">
            <img src="/images/wkdi-tippgeber-hero.webp" alt="Tippgeber in Leipzig" loading="lazy" width="400" height="200" />
          </div>
          <div class="comm-card__body">
            <h3>Tippgeber</h3>
            <p>Du kennst jemanden der verkauft? Teile den Hinweis — Provision möglich.</p>
            <span class="comm-card__gate">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              Registrierung erforderlich
            </span>
          </div>
        </div>

        <!-- Finanzierung -->
        <div class="comm-card">
          <div class="comm-card__img">
            <img src="/images/wkdi-pdf-beratung.webp" alt="Finanzierungsberatung am Schreibtisch" loading="lazy" width="400" height="200" />
          </div>
          <div class="comm-card__body">
            <h3>Finanzierung</h3>
            <p>Banken, Berater, Vermittler — Konditionen, Produkte, Finanzierungsfragen.</p>
            <span class="comm-card__gate">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              Registrierung erforderlich
            </span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- REGISTRATION SECTION -->
  <section class="section bg-alt comm-reg-section" id="registrierung">
    <div class="container">
      <div class="comm-reg-split">

        <!-- Left: Why register -->
        <div class="comm-reg-text">
          <div class="label">Kostenlose Mitgliedschaft</div>
          <h2>Einmal registrieren,<br />alle Gruppen nutzen.</h2>
          <p>Wir prüfen jeden Antrag kurz — damit die Gruppen sauber bleiben. Antwort innerhalb von 24 Stunden.</p>
          <ul class="comm-reg-checks">
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Nur echte Akteure — kein Spam
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Direkte WhatsApp-Links nach Freischaltung
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Kostenlos, jederzeit kündbar
            </li>
          </ul>
        </div>

        <!-- Right: Form -->
        <div class="comm-reg-form-wrap">

          <!-- STEP 1: Role selection -->
          <div id="step-role" class="comm-step">
            <p class="comm-step__label">Schritt 1 von 2 — Wer bist du?</p>
            <h3>Wähle deine Rolle</h3>
            <div class="comm-role-cards">

              <button type="button" class="comm-role-card" data-role="investor" aria-pressed="false">
                <div class="comm-role-card__icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
                <div>
                  <strong>Investor</strong>
                  <span>Fix &amp; Flip, Buy &amp; Hold, Kapitalanlage</span>
                </div>
              </button>

              <button type="button" class="comm-role-card" data-role="makler" aria-pressed="false">
                <div class="comm-role-card__icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <div>
                  <strong>Makler</strong>
                  <span>Immobilienmakler, Kooperationspartner</span>
                </div>
              </button>

              <button type="button" class="comm-role-card" data-role="tippgeber" aria-pressed="false">
                <div class="comm-role-card__icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                </div>
                <div>
                  <strong>Tippgeber</strong>
                  <span>Hinweise auf Verkäufer, Provision möglich</span>
                </div>
              </button>

            </div>
          </div>

          <!-- STEP 2: Form (shown after role selection) -->
          <div id="step-form" class="comm-step" hidden>
            <p class="comm-step__label">Schritt 2 von 2 — Deine Angaben</p>
            <button type="button" id="btn-back" class="comm-back-btn">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
              Rolle ändern
            </button>

            <!-- Investor Form -->
            <form id="form-investor" class="comm-form" hidden>
              <div class="form-row">
                <div class="form-group">
                  <label for="inv-vorname">Vorname *</label>
                  <input type="text" id="inv-vorname" name="vorname" required placeholder="Max" autocomplete="given-name" />
                </div>
                <div class="form-group">
                  <label for="inv-nachname">Nachname *</label>
                  <input type="text" id="inv-nachname" name="nachname" required placeholder="Mustermann" autocomplete="family-name" />
                </div>
              </div>
              <div class="form-group">
                <label for="inv-email">E-Mail *</label>
                <input type="email" id="inv-email" name="email" required placeholder="max@beispiel.de" autocomplete="email" />
              </div>
              <div class="form-group">
                <label for="inv-tel">Telefon *</label>
                <input type="tel" id="inv-tel" name="telefon" required placeholder="0341 123 456" autocomplete="tel" />
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="inv-typ">Ich bin... *</label>
                  <select id="inv-typ" name="investor_typ" required>
                    <option value="">Bitte wählen...</option>
                    <option value="selbst">Handwerker / saniere selbst</option>
                    <option value="teils">Mache teils selbst, teils Fremdvergabe</option>
                    <option value="fremdvergabe">Investor / lasse komplett sanieren</option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="inv-erfahrung">Erfahrungslevel *</label>
                  <select id="inv-erfahrung" name="erfahrung" required>
                    <option value="">Bitte wählen...</option>
                    <option value="0">Noch kein Deal abgeschlossen</option>
                    <option value="1-2">1-2 Deals</option>
                    <option value="3+">3+ Deals</option>
                  </select>
                </div>
              </div>
              <!-- Honeypot -->
              <div style="position:absolute;left:-9999px;" aria-hidden="true">
                <input type="text" name="website" tabindex="-1" autocomplete="off" />
              </div>
              <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="light" data-size="compact"></div>
              <FormPrivacyHint />
              <button type="submit" class="btn btn-primary comm-form__submit">Zugang anfragen &rarr;</button>
            </form>

            <!-- Makler Form -->
            <form id="form-makler" class="comm-form" hidden>
              <div class="form-group">
                <label for="makler-name">Ihr Name *</label>
                <input type="text" id="makler-name" name="name" required placeholder="Vorname Nachname" autocomplete="name" />
              </div>
              <div class="form-group">
                <label for="makler-firma">Maklerbüro</label>
                <input type="text" id="makler-firma" name="maklerbuero" placeholder="Ihr Unternehmen" autocomplete="organization" />
              </div>
              <div class="form-group">
                <label for="makler-email">E-Mail *</label>
                <input type="email" id="makler-email" name="email" required placeholder="name@maklerbuero.de" autocomplete="email" />
              </div>
              <div class="form-group">
                <label for="makler-tel">Telefon *</label>
                <input type="tel" id="makler-tel" name="telefon" required placeholder="030 123 456" autocomplete="tel" />
              </div>
              <!-- Honeypot -->
              <div style="position:absolute;left:-9999px;" aria-hidden="true">
                <input type="text" name="website" tabindex="-1" autocomplete="off" />
              </div>
              <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="light" data-size="compact"></div>
              <FormPrivacyHint />
              <button type="submit" class="btn btn-primary comm-form__submit">Bewerbung einreichen &rarr;</button>
            </form>

            <!-- Tippgeber Form -->
            <form id="form-tippgeber" class="comm-form" hidden>
              <!-- Honeypot -->
              <div style="position:absolute;left:-9999px;" aria-hidden="true">
                <input type="text" name="website" tabindex="-1" autocomplete="off" />
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="tipp-vorname">Vorname *</label>
                  <input type="text" id="tipp-vorname" name="vorname" required placeholder="Max" autocomplete="given-name" />
                </div>
                <div class="form-group">
                  <label for="tipp-nachname">Nachname *</label>
                  <input type="text" id="tipp-nachname" name="nachname" required placeholder="Mustermann" autocomplete="family-name" />
                </div>
              </div>
              <div class="form-group">
                <label for="tipp-email">E-Mail *</label>
                <input type="email" id="tipp-email" name="email" required placeholder="deine@email.de" autocomplete="email" />
              </div>
              <div class="form-group">
                <label for="tipp-tel">Telefon *</label>
                <input type="tel" id="tipp-tel" name="telefon" required placeholder="0341 123 456" autocomplete="tel" />
              </div>
              <div class="form-group">
                <label for="tipp-beruf">Ich bin... *</label>
                <select id="tipp-beruf" name="beruf" required>
                  <option value="">Bitte wählen...</option>
                  <option value="postbote">Postbote / Zeitungszusteller</option>
                  <option value="reiniger">Gebäudereiniger / Fensterputzer</option>
                  <option value="hausmeister">Hausmeister</option>
                  <option value="schornsteinfeger">Schornsteinfeger</option>
                  <option value="pflege">Pflegedienst</option>
                  <option value="handwerker">Handwerker</option>
                  <option value="paket">Paket-Zusteller</option>
                  <option value="ableser">Ableser / Wartungsdienst</option>
                  <option value="sonstiges">Sonstiges</option>
                </select>
              </div>
              <div class="form-group">
                <label for="tipp-plz">PLZ Einsatzgebiet *</label>
                <input type="text" id="tipp-plz" name="plz" required placeholder="z.B. 04177" />
              </div>
              <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="light" data-size="compact"></div>
              <FormPrivacyHint />
              <button type="submit" class="btn btn-primary comm-form__submit">Jetzt anmelden &rarr;</button>
            </form>

            <!-- Success state -->
            <div id="form-success" hidden style="padding:2rem;background:#f0fdf4;border-radius:12px;border:1px solid #bbf7d0;">
              <p style="font-size:1.25rem;font-weight:600;color:#15803d;margin:0 0 1rem">
                ✓ Danke, <span id="success-name"></span>!
              </p>
              <p style="color:#374151;margin:0 0 1.5rem">
                📬 Du bekommst gleich eine E-Mail von:<br>
                <strong>office@wirkaufendeineimmobilie.de</strong><br>
                <span style="font-size:0.875rem;color:#6b7280">→ Bitte prüfe auch deinen Spam-Ordner.</span>
              </p>
              <p style="color:#374151;font-size:0.875rem">
                Nach Freischaltung erhältst du die WhatsApp-Links direkt per E-Mail.
              </p>
            </div>

          </div><!-- /step-form -->

        </div><!-- /comm-reg-form-wrap -->
      </div><!-- /comm-reg-split -->
    </div>
  </section>

  <!-- FOOTER CTA -->
  <section class="section">
    <div class="container comm-footer-cta">
      <h2>Fehlt ein Thema?</h2>
      <p>Sag uns welche Gruppe du dir wünschst — wir bauen das Netzwerk mit dir.</p>
      <a href="mailto:office@wirkaufendeineimmobilie.de?subject=Community-Vorschlag" class="btn btn-outline">Vorschlag senden &rarr;</a>
    </div>
  </section>

</Layout>

<style>
  /* ── Hero ─────────────────────────────────────────────── */
  .comm-hero {
    text-align: center;
    padding-bottom: 0;
  }
  .comm-hero__inner {
    max-width: var(--container-narrow);
  }
  .comm-hero h1 {
    font-size: var(--text-3xl);
    font-weight: var(--weight-extrabold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin-top: var(--space-4);
  }
  .comm-hero__sub {
    font-size: var(--text-lg);
    color: var(--color-text-mid);
    margin-top: var(--space-4);
    line-height: var(--leading-normal);
  }

  /* ── Benefits ─────────────────────────────────────────── */
  .comm-benefits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
    text-align: center;
  }
  .comm-benefit__icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-light);
    border-radius: 14px;
    color: var(--color-accent);
    margin: 0 auto var(--space-4);
  }
  .comm-benefit h3 {
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-2);
  }
  .comm-benefit p {
    font-size: var(--text-sm);
    color: var(--color-text-mid);
    line-height: var(--leading-normal);
  }

  /* ── Groups grid ──────────────────────────────────────── */
  .comm-section-header {
    text-align: center;
    margin-bottom: var(--space-10);
  }
  .comm-section-header h2 {
    font-size: var(--text-2xl);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-tight);
    margin: var(--space-2) 0;
  }
  .comm-section-header p {
    color: var(--color-text-mid);
    font-size: var(--text-base);
  }

  .comm-groups {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }
  .comm-groups .comm-card:nth-child(4) {
    grid-column: 1;
  }
  .comm-groups .comm-card:nth-child(5) {
    grid-column: 2;
  }

  .comm-card {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    background: white;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .comm-card:hover {
    box-shadow: 0 8px 24px rgba(15,23,42,0.10);
    transform: translateY(-2px);
  }
  .comm-card__img {
    height: 200px;
    overflow: hidden;
  }
  .comm-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .comm-card__body {
    padding: var(--space-5) var(--space-6);
  }
  .comm-card__body h3 {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-2);
  }
  .comm-card__body p {
    font-size: var(--text-sm);
    color: var(--color-text-mid);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-4);
  }
  .comm-card__gate {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 12px;
    font-weight: var(--weight-semibold);
    color: var(--color-text-mid);
    background: var(--color-bg-alt);
    border-radius: 20px;
    padding: var(--space-1) var(--space-3);
  }

  /* ── Registration Section ─────────────────────────────── */
  .comm-reg-section {
    border-top: 1px solid var(--color-border);
  }

  .comm-reg-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: start;
    max-width: 960px;
    margin: 0 auto;
  }

  .comm-reg-text h2 {
    font-size: var(--text-2xl);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin: var(--space-3) 0 var(--space-4);
  }
  .comm-reg-text p {
    color: var(--color-text-mid);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-6);
  }
  .comm-reg-checks {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .comm-reg-checks li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }

  /* ── Steps ────────────────────────────────────────────── */
  .comm-step__label {
    font-size: 11px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }
  .comm-step h3 {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-6);
  }

  .comm-back-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-mid);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    margin-bottom: var(--space-5);
    transition: color 0.15s ease;
  }
  .comm-back-btn:hover { color: var(--color-text); }

  /* ── Role cards ───────────────────────────────────────── */
  .comm-role-cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .comm-role-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    background: white;
    border: 2px solid var(--color-border);
    border-radius: 12px;
    cursor: pointer;
    text-align: left;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    width: 100%;
    min-height: 72px;
  }
  .comm-role-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(59,130,246,0.1);
  }
  .comm-role-card[aria-pressed="true"] {
    border-color: var(--color-accent);
    background: var(--color-accent-light);
    box-shadow: 0 0 0 3px rgba(59,130,246,0.15);
  }
  .comm-role-card__icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-alt);
    border-radius: 10px;
    color: var(--color-accent);
    flex-shrink: 0;
  }
  .comm-role-card[aria-pressed="true"] .comm-role-card__icon {
    background: white;
  }
  .comm-role-card strong {
    display: block;
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin-bottom: 2px;
  }
  .comm-role-card span {
    font-size: var(--text-sm);
    color: var(--color-text-mid);
  }

  /* ── Form ─────────────────────────────────────────────── */
  .comm-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }
  .comm-form__submit {
    margin-top: var(--space-2);
    width: 100%;
    justify-content: center;
  }

  /* Reuse existing form-group styles from global.css */

  /* ── Footer CTA ───────────────────────────────────────── */
  .comm-footer-cta {
    text-align: center;
    max-width: 560px;
    margin: 0 auto;
  }
  .comm-footer-cta h2 {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-3);
  }
  .comm-footer-cta p {
    color: var(--color-text-mid);
    margin-bottom: var(--space-6);
  }

  /* ── Responsive ───────────────────────────────────────── */
  @media (max-width: 900px) {
    .comm-groups {
      grid-template-columns: repeat(2, 1fr);
    }
    .comm-groups .comm-card:nth-child(4),
    .comm-groups .comm-card:nth-child(5) {
      grid-column: auto;
    }
    .comm-reg-split {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
    .comm-benefits {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      text-align: left;
    }
    .comm-benefit__icon { margin: 0 0 var(--space-3); }
  }

  @media (max-width: 600px) {
    .comm-groups {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // ── Role selection logic ──────────────────────────────────
  const stepRole = document.getElementById('step-role')!;
  const stepForm = document.getElementById('step-form')!;
  const btnBack  = document.getElementById('btn-back')!;
  const roleCards = document.querySelectorAll<HTMLButtonElement>('.comm-role-card');

  const forms: Record<string, HTMLFormElement | null> = {
    investor:  document.getElementById('form-investor')  as HTMLFormElement,
    makler:    document.getElementById('form-makler')    as HTMLFormElement,
    tippgeber: document.getElementById('form-tippgeber') as HTMLFormElement,
  };

  const apiMap: Record<string, string> = {
    investor:  '/api/investor',
    makler:    '/api/makler',
    tippgeber: '/api/tippgeber',
  };

  let currentRole = '';

  roleCards.forEach(card => {
    card.addEventListener('click', () => {
      const role = card.dataset.role!;
      currentRole = role;

      // Update aria-pressed
      roleCards.forEach(c => c.setAttribute('aria-pressed', 'false'));
      card.setAttribute('aria-pressed', 'true');

      // Show step 2
      stepRole.hidden = true;
      stepForm.hidden = false;

      // Show correct form
      Object.entries(forms).forEach(([r, f]) => {
        if (f) f.hidden = r !== role;
      });

      stepForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  btnBack.addEventListener('click', () => {
    stepRole.hidden = false;
    stepForm.hidden = true;
    currentRole = '';
    // Reset all forms
    Object.values(forms).forEach(f => f?.reset());
    // Reset success
    document.getElementById('form-success')!.hidden = true;
    Object.values(forms).forEach(f => { if (f) f.hidden = true; });
    document.querySelectorAll<HTMLButtonElement>('.comm-role-card').forEach(c => c.setAttribute('aria-pressed', 'false'));
  });

  // ── Form submit handlers ──────────────────────────────────
  Object.entries(forms).forEach(([role, form]) => {
    if (!form) return;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const origText = btn.textContent;
      btn.textContent = 'Wird gesendet...';
      btn.disabled = true;

      const formData = new FormData(form);
      // Add role as source tag for API
      formData.set('source', `community-${role}`);

      try {
        const res = await fetch(apiMap[role], { method: 'POST', body: formData });
        if (res.ok) {
          form.hidden = true;
          btnBack.hidden = true;

          const success = document.getElementById('form-success')!;
          const nameField = form.querySelector<HTMLInputElement>('input[name="vorname"], input[name="name"]');
          const nameSpan  = document.getElementById('success-name')!;
          if (nameField) nameSpan.textContent = nameField.value.split(' ')[0];

          success.hidden = false;
          success.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
          btn.textContent = 'Fehler — bitte erneut versuchen';
          btn.disabled = false;
          setTimeout(() => {
            btn.textContent = origText;
          }, 3000);
        }
      } catch {
        btn.textContent = 'Fehler — bitte erneut versuchen';
        btn.disabled = false;
        setTimeout(() => {
          btn.textContent = origText;
        }, 3000);
      }
    });
  });
</script>
