---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import FormPrivacyHint from '../../components/FormPrivacyHint.astro';
---
<Layout
  title="[TEST] Makler-Kooperation — Problemobjekte zu Geld machen | wirkaufendeineimmobilie.de"
  description="Problemobjekte fressen Zeit, Nerven und Gewinn? Wir haben die Käufer. Vertraglich abgesicherte Dokumentation für den Provisionsanspruch, null Mehraufwand für Sie."
>

  <!-- TEST BANNER -->
  <div class="test-banner">
    ⚠️ TESTSEITE — Video 4 Joachim-Feedback eingearbeitet — noch nicht live
    &nbsp;|&nbsp; <a href="/makler" style="color:inherit;text-decoration:underline">← Original ansehen</a>
  </div>

  <!-- HERO -->
  <section class="section makler-hero">
    <div class="container makler-hero__split">
      <div class="makler-hero__text">
        <div class="label">Für Immobilienmakler — Kooperation</div>
        <h1>Ihre Problemobjekte.<br /><span class="text-accent">Unser Spezialgebiet.</span></h1>
        <!-- GEÄNDERT: "Zeit und Nerven" → "Zeit, Nerven und Gewinn" -->
        <!-- GEÄNDERT: "Wir machen Ihre Problemobjekte zu Geld" → fett -->
        <p class="makler-hero__sub">
          Problemobjekte fressen Zeit, Nerven und Gewinn. Messie, Erbschaft, Sanierungsstau — Stundenlohn geht gegen Null. Wir haben die Käufer, die genau das suchen. <strong>Wir machen Ihre Problemobjekte zu Geld.</strong> Vertraglich abgesicherter Provisionsanspruch, null Mehraufwand.
        </p>
        <div class="makler-hero__buttons">
          <a href="#makler-form" class="btn btn-primary">Jetzt bewerben &rarr;</a>
          <a href="#painpoints" class="btn btn-outline">Warum das funktioniert &darr;</a>
        </div>
      </div>
      <div class="makler-hero__img" aria-hidden="true">
        <img src="/images/wkdi-makler-hero.webp" alt="Makler-Kooperation" />
      </div>
    </div>
  </section>

  <!-- STATS BAR -->
  <!-- GEÄNDERT: 48h → 24h, Keine Vorab-Sanierung + kein Homestaging -->
  <section class="makler-stats">
    <div class="container makler-stats__grid">
      <div class="makler-stat">
        <div class="makler-stat__value">24h</div>
        <div class="makler-stat__label">Verbindliches Angebot</div>
      </div>
      <div class="makler-stat">
        <div class="makler-stat__value">0 €</div>
        <div class="makler-stat__label">Marketingkosten für Sie</div>
      </div>
      <div class="makler-stat">
        <div class="makler-stat__value">Vertraglich</div>
        <div class="makler-stat__label">Provision abgesichert</div>
      </div>
      <div class="makler-stat">
        <div class="makler-stat__value">Kauf wie gesehen</div>
        <div class="makler-stat__label">Keine Vorab-Sanierung, kein Homestaging</div>
      </div>
    </div>
  </section>

  <!-- PAIN POINTS -->
  <!-- DESIGN GEÄNDERT: Dunkel → Hell, Pain-Cards hellrot hinterlegt, schwarze Schrift -->
  <section class="section painpoints-light" id="painpoints">
    <div class="container">
      <div class="makler-section-header">
        <div class="label">Das kennen Sie</div>
        <!-- GEÄNDERT: "Kleine, sanierungsbedürftige 1-2-Zimmer-Wohnungen" → "Sanierungsbedürftige Wohnungen" -->
        <h2>Warum diese Objekte<br />Ihren Stundensatz ruinieren.</h2>
        <p class="text-mid">Sanierungsbedürftige Wohnungen aus schwierigen Konstellationen sind das „unten links" im Portfolio: Viel Arbeit, wenig Glanz, magere Provision.</p>
      </div>

      <div class="pain-grid">
        <div class="pain-card">
          <div class="pain-card__number">01</div>
          <h3 class="pain-card__title">Das Ertrags-Dilemma</h3>
          <p class="pain-card__desc">Ob 1-Zimmer für 80.000 € oder Penthouse für 800.000 € — Ihre Fixkosten für Exposé, Portale, Fahrtwege und Telefonate sind nahezu identisch. Die absolute Provision für das Problemobjekt reicht kaum, um den Aufwand zu decken.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__number">02</div>
          <h3 class="pain-card__title">Mediator statt Makler</h3>
          <p class="pain-card__desc">Erbengemeinschaften: endlose Telefonate, emotionale Fronten, kein Konsens. Insolvenzen: starre Prozesse, Rechtspfleger, Bürokratie über Monate. Die Zeit, die Sie hier reinstecken, fehlt bei der Akquise lukrativer Objekte.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__number">03</div>
          <h3 class="pain-card__title">Vermarktungs-Desaster</h3>
          <p class="pain-card__desc">Renovierungsbedürftige Wohnungen lassen sich schlecht fotografieren — und müssen teuer aufbereitet werden, um vermarktungsfähig zu sein. Banken verweigern Finanzierungen kurz vor dem Notartermin. Und Sie ziehen primär hartgesottene Profi-Investoren an, die jeden Mangel kennen und den Preis — und damit Ihre Provision — drücken.</p>
        </div>
        <div class="pain-card">
          <div class="pain-card__number">04</div>
          <h3 class="pain-card__title">Haftungsrisiken &amp; Informationsmangel</h3>
          <p class="pain-card__desc">Erben und Insolvenzverwalter wissen oft nichts über den Zustand: Schimmel hinter Messie-Bergen, marode Elektrik, fehlende WEG-Beschlüsse, drohende Sonderumlagen. Sie stehen in der Aufklärungspflicht — und suchen mühsam alle Unterlagen selbst.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- LÖSUNG -->
  <!-- GEÄNDERT: "Sie kassieren." → "Sie kassieren!" -->
  <!-- GEÄNDERT: Bisher-Liste + Mit-WKDI-Liste aktualisiert -->
  <section class="section makler-solution bg-alt">
    <div class="container">
      <div class="makler-section-header">
        <div class="label">Unsere Lösung</div>
        <h2>Sie übergeben.<br />Wir übernehmen. <span class="text-accent">Sie kassieren!</span></h2>
      </div>

      <div class="solution-split">
        <div class="solution-col solution-col--before">
          <div class="solution-col__label solution-col__label--bad">Bisher</div>
          <ul class="solution-list solution-list--bad">
            <li>Wochen für Exposé, Fotograf, Portal-Listing</li>
            <li>Endlose Besichtigungen mit Schnäppchenjägern</li>
            <li>Finanzierung platzt kurz vor dem Notar</li>
            <!-- GEÄNDERT: präziser formuliert -->
            <li>Mediation zwischen zerstrittenen Erben und entscheidungsbefindlichen Eigentümern</li>
            <li>Bürokratie mit Insolvenzverwaltern</li>
            <li>Messie-Objektvorbereitung vor jeder Besichtigung</li>
            <!-- GEÄNDERT: "PIS" → "Preis" -->
            <li>Provision geschmälert durch Preisdruck der Investoren</li>
            <!-- NEU: Besichtigungslogistik -->
            <li>Besichtigungstermine kaum zu koordinieren — Schlüssel, An- und Abreise, Terminabstimmung mit weggezogenen Eigentümern</li>
          </ul>
        </div>
        <div class="solution-col solution-col--after">
          <div class="solution-col__label solution-col__label--good">Mit WKDI</div>
          <ul class="solution-list solution-list--good">
            <!-- GEÄNDERT: 48h → 24h -->
            <li>Verbindliches Angebot innerhalb 24 Stunden</li>
            <li>Kauf im Ist-Zustand — keine Vorbereitung nötig</li>
            <!-- GEÄNDERT: "Keine Finanzierungshürden" → "Bonitätsstarke Käufer" -->
            <li>Bonitätsstarke Käufer aus unserem Bestand</li>
            <!-- GEÄNDERT: Ehepartner ergänzt -->
            <li>Wir übernehmen Kommunikation mit Erben, geschiedenen oder entscheidungsbefindlichen Ehepartnern und Verwaltern</li>
            <li>Keine Portalkosten, kein Fotograf, kein Exposé</li>
            <!-- GEÄNDERT: "volle" gestrichen -->
            <li>Ihre Provision — mit einem Bruchteil des Aufwands</li>
            <li>Kopf frei für die Objekte, die Ihren Umsatz wirklich treiben</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- WELCHE OBJEKTE -->
  <!-- DESIGN GEÄNDERT: Dunkel → Hell, schwarze Schrift -->
  <section class="section objects-light">
    <div class="container">
      <div class="makler-section-header">
        <div class="label">Welche Objekte wir abnehmen</div>
        <h2>Alles, was auf Ihrem<br />Schreibtisch blockiert.</h2>
      </div>

      <div class="objects-grid">
        <div class="object-card">
          <h3>Messie-Wohnungen</h3>
          <p>Kauf wie gesehen. Keine Grundreinigung, keine Entrümpelung durch Sie. Wir organisieren alles danach.</p>
        </div>
        <div class="object-card">
          <h3>Erbengemeinschaften</h3>
          <p>Wir koordinieren alle Erben, übernehmen die Kommunikation und liefern die neutrale Marktbewertung, die Einigung erst möglich macht.</p>
        </div>
        <div class="object-card">
          <h3>Insolvenzverfahren</h3>
          <!-- GEÄNDERT: "Zum besten Preis." ergänzt -->
          <p>Bonitätsgeprüfte Käufer, schnelle Abwicklung. Wir liefern dem Insolvenzverwalter, was er braucht: einen sicheren, schnellen Abschluss. Zum besten Preis.</p>
        </div>
        <div class="object-card">
          <h3>Renovierungsstau / Energetische Sanierung (Gebäudeenergiegesetz E–H)</h3>
          <p>Banken verweigern Kredit? Unser Netzwerk aus Profi-Investoren kauft genau diese Objekte — ohne Finanzierungsvorbehalt.</p>
        </div>
        <div class="object-card">
          <!-- GEÄNDERT: "Spekulationsfrist abgelaufen" → "noch nicht abgelaufen" + Kündigungsschutz ergänzt -->
          <h3>Vermietet &amp; schwierig</h3>
          <p>Kündigungsschutz nach Aufteilung, Milieuschutz, Renditefalle, Spekulationsfrist noch nicht abgelaufen — wir kennen das Marktumfeld in Leipzig und finden den passenden Langfrist-Investor.</p>
        </div>
        <div class="object-card">
          <h3>Leerstand &amp; Blockade</h3>
          <p>Wenn Miteigentümer blockieren oder das Objekt schon zu lange im Portfolio liegt — wir schaffen Bewegung.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST / JOACHIM -->
  <!-- GEÄNDERT: Quote-Text authentischer + "Partnermaklern" ergänzt -->
  <section class="section">
    <div class="container trust-wrap">
      <div class="trust-card">
        <div class="trust-card__image">
          <img src="/images/wkdi-deal-handshake-jung.webp" alt="Kooperation auf Augenhöhe" />
        </div>
        <div class="trust-card__content">
          <div class="trust-card__stars" aria-label="5 von 5 Sternen">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <h2 class="trust-card__heading">Kollege zu Kollege.<br />Kein Konkurrent.</h2>
          <blockquote class="trust-card__quote">
            &bdquo;Ich bin selbst Immobilienprofi und im Immobilienhandel tätig — mit 35 Jahren Berufserfahrung. Ich weiß, wie viel Zeit und Geld eine zerstrittene Eigentümergemeinschaft oder eine Messie-Wohnung wirklich kostet — und wie wenig am Ende übrig bleibt. Deshalb bieten wir Kollegen und Partnermaklern eine saubere Lösung: Objekt rein, Provision raus, kein Stress.&ldquo;
          </blockquote>
          <div class="trust-card__author">
            <span class="trust-card__name">Joachim Kleinke</span>
            <span class="trust-card__role">35+ Jahre Immobilien-Erfahrung · § 34c Maklererlaubnis</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA GLOW -->
  <!-- GEÄNDERT: "Vertraglich abgesicherter Provisionsanspruch" → "Vertraglich abgesicherte Dokumentation..." -->
  <section class="makler-cta-glow-section">
    <div class="makler-cta-glow__glow" aria-hidden="true"></div>
    <div class="container makler-cta-glow__inner">
      <p class="makler-cta-glow__eyebrow">Vertraglich abgesicherte Dokumentation für den Provisionsanspruch</p>
      <h2 class="makler-cta-glow__heading">Problemobjekte rein — Provision raus.</h2>
      <p class="makler-cta-glow__sub">Einmal anmelden. Wir prüfen, koordinieren, schließen ab — Sie bekommen Ihre Provision.</p>
      <a href="#makler-form" class="makler-cta-glow__btn">Jetzt Kooperationspartner werden &rarr;</a>
    </div>
  </section>

  <!-- FORMULAR — Bewerbung -->
  <!-- GEÄNDERT: "48h" → "24 Stunden" -->
  <section class="makler-form-section bg-alt" id="makler-form">
    <div class="container makler-form-split">
      <div class="makler-form-split__text">
        <h2>Kooperationspartner<br />werden.</h2>
        <p class="text-mid">Wir sichern Ihren Provisionsanspruch vertraglich ab. Nach Ihrer Anmeldung erhalten Sie unsere Kooperationsvereinbarung — transparent, fair, rechtsverbindlich.</p>
        <ul class="makler-form-split__checks">
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Vertraglich abgesicherter Provisionsanspruch
          </li>
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Persönliche Rückmeldung in 24 Stunden
          </li>
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Diskret — kein öffentliches Listing
          </li>
        </ul>
      </div>

      <div class="makler-form-card">
        <form class="makler-form" id="makler-reg-form">
          <div class="form-group">
            <label for="makler-name">Ihr Name *</label>
            <input type="text" id="makler-name" name="name" required placeholder="Vorname Nachname" />
          </div>
          <div class="form-group">
            <label for="makler-firma">Maklerbüro</label>
            <input type="text" id="makler-firma" name="maklerbuero" placeholder="Ihr Unternehmen" />
          </div>
          <div class="form-group">
            <label for="makler-email">E-Mail *</label>
            <input type="email" id="makler-email" name="email" required placeholder="name@maklerbuero.de" />
          </div>
          <div class="form-group">
            <label for="makler-tel">Telefon *</label>
            <input type="tel" id="makler-tel" name="telefon" required placeholder="030 123 456" />
          </div>
          <!-- Honeypot -->
          <div style="position: absolute; left: -9999px;" aria-hidden="true">
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <button type="submit" class="btn btn-primary makler-form__submit">Bewerbung einreichen &rarr;</button>
          <FormPrivacyHint />
        </form>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* TEST BANNER */
  .test-banner {
    background: #f59e0b;
    color: #1c1917;
    text-align: center;
    padding: 10px 16px;
    font-size: 0.85rem;
    font-weight: 600;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  /* HERO */
  .makler-hero {
    padding-top: var(--space-20);
    padding-bottom: var(--space-16);
  }
  .makler-hero__split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }
  .makler-hero__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .makler-hero__sub {
    font-size: var(--text-lg);
    color: var(--color-text-mid);
    max-width: 520px;
  }
  .makler-hero__buttons {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .makler-hero__img {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 24px 64px rgba(0,0,0,0.12);
    aspect-ratio: 4/3;
  }
  .makler-hero__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }
  @media (max-width: 768px) {
    .makler-hero__split { grid-template-columns: 1fr; }
    .makler-hero__img { order: -1; aspect-ratio: 16/9; }
  }

  /* STATS */
  .makler-stats {
    background: var(--color-bg-card);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-10);
  }
  .makler-stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
    text-align: center;
  }
  .makler-stat__value {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--color-accent);
  }
  .makler-stat__label {
    font-size: var(--text-sm);
    color: var(--color-text-mid);
    margin-top: var(--space-1);
  }

  /* SECTION HEADER */
  .makler-section-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 560px;
    margin-bottom: var(--space-12);
  }

  /* PAIN GRID — HELL (war dunkel) */
  .painpoints-light {
    background: var(--color-bg-alt);
  }
  .pain-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
  }
  .pain-card {
    background: #fff5f5;
    border: 1px solid #fecaca;
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .pain-card__number {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: #dc2626;
    letter-spacing: 0.05em;
  }
  .pain-card__title {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--color-text);
  }
  .pain-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-mid);
    line-height: var(--leading-relaxed);
  }

  /* SOLUTION SPLIT */
  .makler-solution { padding-block: var(--section-gap); }
  .solution-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }
  .solution-col {
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .solution-col--before { background: #fff5f5; border: 1px solid #fecaca; }
  .solution-col--after  { background: #f0fdf4; border: 1px solid #bbf7d0; }
  .solution-col__label {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .solution-col__label--bad  { color: #b91c1c; }
  .solution-col__label--good { color: #15803d; }
  .solution-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .solution-list li {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    padding-left: var(--space-5);
    position: relative;
  }
  .solution-list--bad  li { color: #7f1d1d; }
  .solution-list--bad  li::before { content: '✗'; position: absolute; left: 0; color: #ef4444; font-weight: 700; }
  .solution-list--good li { color: #14532d; }
  .solution-list--good li::before { content: '✓'; position: absolute; left: 0; color: #22c55e; font-weight: 700; }

  /* OBJECTS GRID — HELL (war dunkel) */
  .objects-light {
    background: var(--color-bg);
  }
  .objects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }
  .object-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: box-shadow var(--duration-normal) var(--ease-default),
                transform var(--duration-normal) var(--ease-default);
  }
  .object-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .object-card h3 {
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    color: var(--color-text);
  }
  .object-card p {
    font-size: var(--text-sm);
    color: var(--color-text-mid);
    line-height: var(--leading-relaxed);
  }

  /* FORM SECTION */
  .makler-form-section { padding-block: var(--section-gap); }
  .makler-form-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }
  .makler-form-split__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-4);
  }
  .makler-form-split__text h2 { font-size: var(--text-3xl); }
  .makler-form-split__checks {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  .makler-form-split__checks li {
    display: flex;
