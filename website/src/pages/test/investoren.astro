---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import FormPrivacyHint from '../../components/FormPrivacyHint.astro';
---
<Layout
  title="[TEST] Fix & Flip Leipzig — Off-Market Objekte für Investoren"
  description="Testseite — Geprüfte Fix-&-Flip-Objekte in Leipzig — Off-Market, keine Auktionen. Exklusiver Investoren-Zugang für geprüfte Käufer."
>

  <!-- TEST BANNER -->
  <div class="test-banner">
    ⚠️ TESTSEITE — Video 3 Joachim-Feedback eingearbeitet — noch nicht live
    &nbsp;|&nbsp; <a href="/investoren" style="color:inherit;text-decoration:underline">← Original ansehen</a>
  </div>

  <!-- HERO -->
  <section class="section inv-hero inv-hero--bg">
    <div class="inv-hero__bg-img" aria-hidden="true">
      <img src="/images/wkdi-investoren-hero.webp" alt="" />
    </div>
    <div class="container inv-hero__inner">
      <div class="label">Exklusiver Investoren-Zugang</div>
      <!-- GEÄNDERT: "bevor es jemand anderes sieht" → "bevor es dir jemand anderes wegschnappt" -->
      <h1>Dein nächstes Fix-&amp;-Flip-Objekt.<br /><span class="text-accent">Bevor es dir jemand anderes wegschnappt.</span></h1>
      <!-- GEÄNDERT: "Kuratiert" → "Geprüft" -->
      <p class="inv-hero__sub">
        Off-Market Sanierungsobjekte in Leipzig. Geprüft, renditestark, mit Potenzial.
        Exklusiver Zugang für verifizierte Investoren.
      </p>
      <div class="inv-hero__buttons">
        <a href="#investor-form" class="btn btn-primary">Investoren-Zugang anfragen &rarr;</a>
        <a href="#benefits" class="btn btn-outline">Mehr erfahren &darr;</a>
      </div>
    </div>
  </section>

  <!-- BENEFITS 3-CARDS -->
  <section class="inv-benefits" id="benefits">
    <div class="container">
      <div class="inv-benefits__grid">
        <!-- GEÄNDERT: "Objekte bevor..." → persönlicher -->
        <div class="benefit-card">
          <div class="benefit-card__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <h3>Off-Market Zugang</h3>
          <p>Deine nächsten Flip-Objekte, bevor sie auf ImmoScout landen. Direkter Zugang zu Verkäufern über unser Netzwerk.</p>
        </div>
        <!-- GEÄNDERT: Heading "Kuratierte Objekte" → "Geprüfte Objekte" -->
        <div class="benefit-card">
          <div class="benefit-card__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <h3>Geprüfte Objekte</h3>
          <p>Vorgeprüft, mit Renditepotenzial, kalkulierbar. Inkl. Gebäudeenergiegesetz-Status und Sanierungskalkulation. Wir filtern — du entscheidest.</p>
        </div>
        <!-- UNVERÄNDERT: Joachim: "Ist perfekt, kann so bleiben." -->
        <div class="benefit-card">
          <div class="benefit-card__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <h3>Kein Bietergefecht</h3>
          <p>Diskretes Angebotsverfahren statt öffentlichem Bieterkrieg. Ein verdecktes Gebot pro Investor — fairer Preis, kein Stress.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA WITH GLOW -->
  <section class="inv-cta-glow">
    <div class="inv-cta-glow__glow" aria-hidden="true"></div>
    <div class="container inv-cta-glow__inner">
      <p class="inv-cta-glow__eyebrow">Exklusiver Investoren-Zugang</p>
      <!-- GEÄNDERT: "wegschnappt" + "kuratiert" weg + "keine Makler-Provision" gestrichen -->
      <h2 class="inv-cta-glow__heading">Dein nächstes Fix-&amp;-Flip-Objekt. Bevor es dir jemand anderes wegschnappt.</h2>
      <p class="inv-cta-glow__sub">Off-Market Objekte, vorgeprüft und renditestark. Diskretes Angebotsverfahren — kein Stress. Dein Gebot ist dein Endpreis — keine versteckten Zusatzkosten.</p>
      <a href="#investor-form" class="inv-cta-glow__btn">Investoren-Zugang anfragen &rarr;</a>
    </div>
  </section>

  <!-- ROI TEASER -->
  <section class="section">
    <div class="container roi-teaser">
      <h2>Was bringt dein nächster Flip?</h2>
      <p class="text-mid">Rechne es durch — mit echten Leipziger Marktdaten.</p>
      <div style="display:flex;gap:var(--space-4);align-items:center;justify-content:center;flex-wrap:wrap;margin-top:var(--space-6);">
        <a href="/roi-rechner" class="btn btn-dark">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="10" x2="10" y2="10"/><line x1="12" y1="10" x2="14" y2="10"/><line x1="16" y1="10" x2="16" y2="10"/><line x1="8" y1="14" x2="10" y2="14"/><line x1="12" y1="14" x2="14" y2="14"/><line x1="16" y1="14" x2="16" y2="14"/><line x1="8" y1="18" x2="10" y2="18"/><line x1="12" y1="18" x2="16" y2="18"/></svg>
          ROI-Rechner öffnen &rarr;
        </a>
        <a href="/kapitalanleger-rechner" class="btn btn-dark">
          Kapitalanleger-Rechner →
          <span style="display:block;font-size:0.75em;opacity:0.75;margin-top:2px;">AfA · Cashflow nach Steuer · DCF NPV</span>
        </a>
      </div>
    </div>
  </section>

  <!-- REGISTRATION FORM -->
  <section class="inv-form-section bg-alt" id="investor-form">
    <div class="container inv-form-split">
      <div class="inv-form-split__text">
        <h2>Bereit für deinen ersten Fix &amp; Flip in Leipzig?</h2>
        <!-- GEÄNDERT: "48 Stunden" → "24 Stunden" -->
        <p class="text-mid">Wir prüfen jeden Antrag persönlich. Antwort innerhalb von 24 Stunden.</p>
        <ul class="inv-form-split__checks">
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Täglich neue Off-Market Deals
          </li>
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Detaillierte Sanierungs-Kalkulationen
          </li>
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Support bei der Finanzierung
          </li>
        </ul>
      </div>
      <div class="inv-form-card">
        <form class="inv-form" id="investor-reg-form">
          <div class="form-row">
            <div class="form-group">
              <label for="inv-vorname">Vorname *</label>
              <input type="text" id="inv-vorname" name="vorname" required placeholder="Max" autocomplete="given-name" />
            </div>
            <div class="form-group">
              <label for="inv-nachname">Nachname *</label>
              <input type="text" id="inv-nachname" name="nachname" required placeholder="Mustermann" autocomplete="family-name" />
            </div>
          </div>
          <div class="form-group">
            <label for="inv-email">E-Mail *</label>
            <input type="email" id="inv-email" name="email" required placeholder="max@beispiel.de" />
          </div>
          <div class="form-group">
            <label for="inv-tel">Telefon *</label>
            <input type="tel" id="inv-tel" name="telefon" required placeholder="0341 123 456" autocomplete="tel" />
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="inv-typ">Ich bin... *</label>
              <select id="inv-typ" name="investor_typ" required>
                <option value="">Bitte wählen...</option>
                <option value="selbst">Handwerker / saniere selbst</option>
                <option value="teils">Mache teils selbst, teils Fremdvergabe</option>
                <option value="fremdvergabe">Investor / lasse komplett sanieren</option>
              </select>
            </div>
            <div class="form-group">
              <label for="inv-erfahrung">Erfahrungslevel *</label>
              <select id="inv-erfahrung" name="erfahrung" required>
                <option value="">Bitte wählen...</option>
                <option value="0">Noch kein Deal abgeschlossen</option>
                <option value="1-2">1-2 Deals</option>
                <option value="3+">3+ Deals</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label for="inv-gewerk">Gewerk (optional)</label>
            <select id="inv-gewerk" name="gewerk">
              <option value="">Keins / nicht relevant</option>
              <option value="maler">Maler</option>
              <option value="elektriker">Elektriker</option>
              <option value="shk">SHK (Sanitär/Heizung)</option>
              <option value="trockenbau">Trockenbau</option>
              <option value="fliesenleger">Fliesenleger</option>
            </select>
          </div>
          <div class="cf-turnstile" data-sitekey={import.meta.env.TURNSTILE_SITE_KEY || ''} data-theme="dark" data-size="compact"></div>
          <button type="submit" class="btn btn-primary inv-form__submit">Zugang anfragen &rarr;</button>
          <FormPrivacyHint />
        </form>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* TEST BANNER */
  .test-banner {
    background: #f59e0b;
    color: #1c1917;
    text-align: center;
    padding: 10px 16px;
    font-size: 0.85rem;
    font-weight: 600;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  /* HERO */
  .inv-hero {
    text-align: center;
    padding-top: var(--space-20);
    padding-bottom: var(--space-16);
  }

  .inv-hero--bg {
    position: relative;
    overflow: hidden;
  }

  .inv-hero__bg-img {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .inv-hero__bg-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.20;
    filter: grayscale(30%);
  }

  .inv-hero--bg .inv-hero__inner {
    position: relative;
    z-index: 1;
  }

  .inv-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .inv-hero__sub {
    font-size: var(--text-lg);
    color: var(--color-text-mid);
    text-align: center;
    max-width: 640px;
  }

  .inv-hero__buttons {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* BENEFITS */
  .inv-benefits {
    background: var(--color-bg-card);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--section-gap);
  }

  .inv-benefits__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .benefit-card {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    position: relative;
    overflow: hidden;
    transition: box-shadow var(--duration-normal) var(--ease-default),
                transform var(--duration-normal) var(--ease-default);
  }

  .benefit-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .benefit-card__icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-light);
    border: 1px solid var(--color-border);
    color: var(--color-accent);
    border-radius: var(--radius-md);
    transition: background var(--duration-normal) var(--ease-default),
                color var(--duration-normal) var(--ease-default);
  }

  .benefit-card:hover .benefit-card__icon {
    background: var(--color-accent);
    color: white;
    border-color: transparent;
  }

  .benefit-card h3 {
    color: var(--color-text);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
  }

  .benefit-card p {
    color: var(--color-text-mid);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 768px) {
    .inv-benefits__grid { grid-template-columns: 1fr; }
  }

  /* CTA WITH GLOW */
  .inv-cta-glow {
    position: relative;
    background: var(--color-primary);
    border-top: 1px solid rgba(255,255,255,0.06);
    padding-block: clamp(64px, 10vw, 120px);
    text-align: center;
    overflow: hidden;
  }

  .inv-cta-glow__glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 800px;
    height: 400px;
    background: radial-gradient(ellipse at center, rgba(59,130,246,0.25) 0%, rgba(59,130,246,0.08) 40%, transparent 70%);
    pointer-events: none;
  }

  .inv-cta-glow__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    max-width: var(--container-narrow);
    margin-inline: auto;
  }

  .inv-cta-glow__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #60A5FA;
    margin: 0;
  }

  .inv-cta-glow__heading {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: var(--weight-extrabold);
    color: #F8FAFC;
    line-height: 1.15;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .inv-cta-glow__sub {
    font-size: var(--text-lg);
    color: #94A3B8;
    max-width: 480px;
    line-height: 1.6;
    margin: 0;
  }

  .inv-cta-glow__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 40px;
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    color: var(--color-primary);
    background: #F8FAFC;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 0 0 1px rgba(255,255,255,0.1), 0 4px 24px rgba(59,130,246,0.4);
    margin-top: var(--space-2);
  }

  .inv-cta-glow__btn:hover {
    background: white;
    transform: translateY(-2px);
    box-shadow: 0 0 0 1px rgba(255,255,255,0.15), 0 8px 40px rgba(59,130,246,0.55);
  }

  /* ROI TEASER */
  .roi-teaser { text-align: center; }

  .btn-dark {
    background: var(--color-primary);
    color: var(--color-text-on-dark);
    box-shadow: 0 2px 4px rgba(15,23,42,0.15), 0 4px 16px rgba(15,23,42,0.2);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    font-family: var(--font-family);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    line-height: 1;
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--duration-normal) var(--ease-default);
    min-height: 44px;
  }

  .btn-dark:hover {
    background: var(--color-primary-light);
    color: var(--color-text-on-dark);
    transform: translateY(-1px);
  }

  /* FORM SECTION */
  .inv-form-section { padding-block: var(--section-gap); }

  .inv-form-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .inv-form-split__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-4);
  }

  .inv-form-split__text h2 { font-size: var(--text-3xl); }

  .inv-form-split__checks {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .inv-form-split__checks li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }

  .inv-form-split__checks li svg { flex-shrink: 0; }

  .inv-form-card {
    background: var(--color-bg-card);
    border-radius: var(--radius-xl);
    padding: clamp(24px, 3vw, 40px);
    box-shadow: 0 4px 8px rgba(15,23,42,0.04), 0 8px 24px rgba(15,23,42,0.1), 0 16px 48px rgba(15,23,42,0.06);
  }

  .inv-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .form-group label {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-mid);
  }

  .form-group input,
  .form-group select { width: 100%; }

  .inv-form__submit {
    width: 100%;
    margin-top: var(--space-2);
  }

  @media (max-width: 768px) {
    .inv-form-split { grid-template-columns: 1fr; gap: var(--space-8); }
    .form-row { grid-template-columns: 1fr; }
  }
</style>

<script>
  document.querySelectorAll('.benefit-card').forEach((card) => {
    card.addEventListener('mousemove', (e) => {
      const rect = (card as HTMLElement).getBoundingClientRect();
      const x = ((e as MouseEvent).clientX - rect.left) / rect.width * 100;
      const y = ((e as MouseEvent).clientY - rect.top) / rect.height * 100;
      (card as HTMLElement).style.setProperty('--mouse-x', `${x}%`);
      (card as HTMLElement).style.setProperty('--mouse-y', `${y}%`);
    });
  });

  const form = document.getElementById('investor-reg-form') as HTMLFormElement;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = btn.textContent;
    btn.textContent = 'Wird gesendet...';
    btn.disabled = true;
    try {
      const res = await fetch('/api/investor', { method: 'POST', body: formData });
      if (res.ok) {
        window.location.href = '/danke?typ=investor';
      } else {
        btn.textContent = 'Fehler — bitte erneut versuchen';
        btn.disabled = false;
        setTimeout(() => { btn.textContent = originalText; }, 3000);
      }
    } catch {
      btn.textContent = 'Fehler — bitte erneut versuchen';
      btn.disabled = false;
      setTimeout(() => { btn.textContent = originalText; }, 3000);
    }
  });
</script>
