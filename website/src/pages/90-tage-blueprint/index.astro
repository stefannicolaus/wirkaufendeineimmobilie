---
import Layout from '../../layouts/Layout.astro';
import FormPrivacyHint from '../../components/FormPrivacyHint.astro';
---
<Layout
  title="Dein persönlicher 90-Tage-Blueprint — Fix & Flip Leipzig"
  description="Beantworte 5 Fragen zu deinem Flip-Vorhaben. Joachim Kleinke und sein Team erstellen deinen persönlichen 90-Tage-Blueprint mit konkreten Zahlen für Leipzig."
>

  <section class="section ap-hero">
    <div class="container ap-hero__inner">
      <div class="label">Persönlich erstellt für deinen ersten Deal</div>
      <h1>Dein erster Flip in 90 Tagen —<br /><span class="text-accent">der Blueprint</span></h1>
      <p class="ap-hero__sub">Wir erstellen deinen Blueprint basierend auf deinen Angaben — mit konkreten Zahlen für Leipzig. Dafür brauchen wir ein paar Informationen von dir. Joachim Kleinke und sein Team schauen sich das an und schicken dir deinen persönlichen 90-Tage-Blueprint.</p>

      <div class="ap-steps">
        <div class="ap-step">
          <div class="ap-step__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          </div>
          <div class="ap-step__label">5 Fragen beantworten</div>
          <div class="ap-step__detail">2 Minuten</div>
        </div>
        <div class="ap-step__divider"></div>
        <div class="ap-step">
          <div class="ap-step__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="ap-step__label">Joachim Kleinke analysiert</div>
          <div class="ap-step__detail">Persönlich, nicht automatisiert</div>
        </div>
        <div class="ap-step__divider"></div>
        <div class="ap-step">
          <div class="ap-step__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </div>
          <div class="ap-step__label">Dein Blueprint in 24h</div>
          <div class="ap-step__detail">Individuell, mit konkreten Zahlen</div>
        </div>
      </div>

      <!-- EMAIL GATE -->
      <div id="email-gate" class="ap-email-gate">
        <p class="ap-email-gate__label">Wohin sollen wir deinen Blueprint schicken?</p>
        <form id="gate-form" class="ap-email-gate__form" novalidate>
          <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off" />
          <input type="hidden" name="typ" value="blueprint" />
          <div class="ap-gate-row">
            <input type="text" name="name" placeholder="Dein Vorname" class="ap-gate-input" />
            <input type="email" name="email" placeholder="Deine E-Mail *" required class="ap-gate-input" />
          </div>
          <FormPrivacyHint />
          <div class="cf-turnstile" data-sitekey={import.meta.env.TURNSTILE_SITE_KEY || ''} data-theme="dark" data-size="compact"></div>
          <button type="submit" class="btn btn-primary ap-hero__cta">Blueprint anfordern &rarr;</button>
        </form>
      </div>
      <!-- FAST FERTIG SCREEN -->
      <div id="doi-pending" class="ap-doi-pending" hidden>
        <div style="font-size:2.5rem; margin-bottom:1rem;">✉️</div>
        <h3>Fast fertig — check deine E-Mails!</h3>
        <p>Wir haben dir gerade eine E-Mail von <strong>office@wirkaufendeineimmobilie.de</strong> geschickt. Klick auf den Bestätigungslink — dann erhältst du deinen Blueprint.</p>
        <div class="ap-doi-benefits">
          <p><strong>Was dich erwartet:</strong></p>
          <ul>
            <li>✓ 90-Tage-Fahrplan für deinen ersten Fix & Flip</li>
            <li>✓ Kalkulations-Template mit echten Leipziger Zahlen</li>
            <li>✓ Budgetplanung für dein Eigenkapital</li>
            <li>✓ Handwerker-Checkliste für Leipzig</li>
          </ul>
        </div>
        <p style="font-size:0.85rem; opacity:0.7;">⚠️ Mail nicht da? Schau in deinen Spam-Ordner.</p>
      </div>

      <div class="ap-includes">
        <p class="text-mid">Dein Blueprint enthält:</p>
        <ul class="ap-includes__list">
          <li>90-Tage-Schritt-für-Schritt-Plan — angepasst an dein Erfahrungslevel</li>
          <li>Deal-Rechner Leipzig: Was du in deinem Stadtteil mit deinem Budget kaufen kannst</li>
          <li>Kalkulations-Template mit echten Leipziger Zahlen</li>
          <li>Stadtteil-Analyse: qm-Preise unsaniert vs. saniert für deinen Ziel-Stadtteil</li>
          <li>Finanzierungs-Optionen für dein Eigenkapital und Erfahrungslevel</li>
        </ul>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('gate-form') as HTMLFormElement | null;
    const gate = document.getElementById('email-gate') as HTMLElement | null;
    const pending = document.getElementById('doi-pending') as HTMLElement | null;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = form?.querySelector('[name="email"]') as HTMLInputElement | null;
      if (!emailInput?.value) { emailInput?.focus(); return; }
      const checkbox = form?.querySelector('[name="datenschutz_ok"]') as HTMLInputElement | null;
      if (checkbox && !checkbox.checked) { checkbox.focus(); return; }
      const btn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (btn) { btn.textContent = 'Wird gesendet...'; btn.disabled = true; }
      try {
        const fd = new FormData(form!);
        const res = await fetch('/api/lead-magnet', { method: 'POST', body: fd });
        if (res.ok) {
          if (gate) gate.hidden = true;
          if (pending) pending.hidden = false;
        } else {
          if (btn) { btn.textContent = 'Fehler — erneut versuchen'; btn.disabled = false; }
        }
      } catch {
        if (btn) { btn.textContent = 'Fehler — erneut versuchen'; btn.disabled = false; }
      }
    });
  </script>
</Layout>

<style>
  .ap-hero {
    text-align: center;
    padding-top: var(--space-20);
    padding-bottom: var(--space-16);
  }

  .ap-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    max-width: 800px;
    margin: 0 auto;
  }

  .ap-hero__sub {
    color: var(--color-text-mid);
    font-size: var(--text-lg);
    max-width: 640px;
    line-height: var(--leading-relaxed);
  }

  .ap-steps {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin: var(--space-6) 0;
    width: 100%;
    max-width: 700px;
  }

  .ap-step {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
  }

  .ap-step__icon {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-lg);
    background: var(--color-accent-light);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ap-step__label {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    line-height: var(--leading-snug);
  }

  .ap-step__detail {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .ap-step__divider {
    width: 40px;
    height: 2px;
    background: var(--color-border);
    margin-top: 28px;
    flex-shrink: 0;
  }

  @media (max-width: 600px) {
    .ap-steps { flex-direction: column; align-items: center; gap: var(--space-4); }
    .ap-step { flex-direction: row; text-align: left; gap: var(--space-3); }
    .ap-step__divider { display: none; }
    .ap-step__icon { width: 44px; height: 44px; flex-shrink: 0; }
    .ap-step__icon svg { width: 22px; height: 22px; }
  }

  .ap-hero__cta {
    margin-top: var(--space-2);
    font-size: var(--text-lg);
    padding: var(--space-4) var(--space-8);
  }

  .ap-includes {
    max-width: 560px;
    text-align: left;
    margin-top: var(--space-4);
  }

  .ap-includes > p {
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-3);
  }

  .ap-includes__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .ap-includes__list li {
    font-size: var(--text-sm);
    color: var(--color-text-mid);
    padding-left: var(--space-5);
    position: relative;
  }

  .ap-includes__list li::before {
    content: '\2713';
    color: var(--color-accent);
    font-weight: var(--weight-bold);
    position: absolute;
    left: 0;
  }

  .ap-email-gate { width: 100%; max-width: 560px; margin-top: var(--space-6); }
  .ap-email-gate__label { font-weight: 600; margin-bottom: 0.75rem; }
  .ap-email-gate__form { display: flex; flex-direction: column; gap: 0.75rem; }
  .ap-gate-row { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .ap-gate-input { flex: 1; min-width: 160px; padding: 0.75rem 1rem; border: 2px solid var(--color-border); border-radius: 8px; font-family: inherit; font-size: 1rem; background: var(--color-bg); color: var(--color-text); min-height: 48px; }
  .ap-doi-pending { max-width: 560px; padding: 2rem 0; }
  .ap-doi-pending h3 { margin-bottom: 0.75rem; }
  .ap-doi-benefits { background: var(--color-bg-card, #f9f9f9); border: 1px solid var(--color-border, #e0e0e0); border-radius: 8px; padding: 1.25rem; text-align: left; margin: 1rem 0; }
  .ap-doi-benefits ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.5rem; }
</style>
