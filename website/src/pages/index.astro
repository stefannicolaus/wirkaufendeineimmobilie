    grid-template-columns: 1fr 1fr;
    gap: 2px;
    height: 210px;
    flex-shrink: 0;
  }

  .card__photo {
    position: relative;
    overflow: hidden;
  }

  .card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card__photo-label {
    position: absolute;
    bottom: 10px;
    left: 10px;
