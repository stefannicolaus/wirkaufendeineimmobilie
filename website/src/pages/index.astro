---
import Layout from '../layouts/Layout.astro';
import FormPrivacyHint from '../components/FormPrivacyHint.astro';
---
<Layout
  title="Sanierungsbedürftige Wohnung verkaufen Leipzig — Messie, Erbengemeinschaft, Insolvenz | wirkaufendeineimmobilie.de"
  description="Wohnung verkaufen in Leipzig: Messie-Objekt, sanierungsbedürftig, Erbengemeinschaft oder Insolvenzverfahren — ohne Renovierung, ohne Makler-Ghosting. Kostenlose Erstbewertung in 48h."
>

  <!-- HERO -->
  <section class="hero section hero--bg">
    <div class="hero__bg-img" aria-hidden="true">
      <img src="/images/wkdi-hero-bg.jpg" alt="" />
    </div>
    <div class="container hero__inner">
      <div class="label">
        <span class="hero__dot"></span>
        Für Messie-Objekte, Erbengemeinschaften &amp; GEG-Problemfälle in Leipzig
      </div>
      <h1>
        Deine Immobilie verdient<br />
        <span class="text-accent">den richtigen Käufer.</span>
      </h1>
      <p class="hero__sub">
        Messie-Wohnung, Erbengemeinschaft, Insolvenzverfahren oder GEG-Sanierungsstau — wir vermitteln diskret an Käufer, die im Ist-Zustand kaufen.
        Kein Aufräumen. Kein Makler. Nur geprüfte Käufer.
      </p>

      <!-- Hero Form Card (Stitch Pattern) -->
      <div class="hero-form-card" id="hero-form">
        <div class="hero-form-card__inner">
          <div class="hero-form-card__input-wrap">
            <svg class="hero-form-card__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
            <input
              type="text"
              id="hero-plz"
              placeholder="PLZ deines Objekts eingeben..."
              pattern="[0-9]{5}"
              maxlength="5"
              inputmode="numeric"
              aria-label="Postleitzahl"
            />
          </div>
          <button type="button" class="btn btn-primary hero-form-card__btn" id="hero-cta">Kostenlos bewerten &rarr;</button>
        </div>
      </div>

      <div class="hero__trust">
        <span>&#10003; Auch bei Erbengemeinschaft</span>
        <span>&#10003; Auch bei Insolvenzverfahren</span>
        <span>&#10003; Kein Aufräumen nötig</span>
        <span>&#10003; Notariell abgesichert</span>
      </div>
    </div>
  </section>

  <!-- STATS BAR -->
  <section class="stats-bar">
    <div class="container stats-bar__inner">
      <div class="stat">
        <span class="stat__number">48h</span>
        <span class="stat__label">Erstbewertung</span>
      </div>
      <div class="stat">
        <span class="stat__number">0&euro;</span>
        <span class="stat__label">für die Bewertung</span>
      </div>
      <div class="stat">
        <span class="stat__number">100%</span>
        <span class="stat__label">Diskretion</span>
      </div>
      <div class="stat">
        <span class="stat__number">35+</span>
        <span class="stat__label">Jahre Erfahrung</span>
      </div>
    </div>
  </section>

  <!-- DUAL CARDS -->
  <section class="section">
    <div class="container dual-cards">
      <h2 class="sr-only">Verkaufen oder Investieren</h2>

      <!-- Verkäufer Card -->
      <div class="card card--seller">
        <div class="card__photos">
          <div class="card__photo">
            <img src="/images/wkdi-seller-stressed.jpg" alt="Eigentümer mit Sorgen vor dem Verkauf" loading="lazy" />
            <span class="card__photo-label">Vorher</span>
          </div>
          <div class="card__photo">
            <img src="/images/wkdi-seller-happy.jpg" alt="Erleichterter Eigentümer nach dem Verkauf" loading="lazy" />
            <span class="card__photo-label">Nachher</span>
          </div>
        </div>
        <div class="card__icon-box card__icon-box--light">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/><path d="M9 21V12h6v9"/></svg>
        </div>
        <h3>Ich möchte verkaufen</h3>
        <p>Messie-Objekt, Erbengemeinschaft, GEG-Sanierungsstau, Insolvenzverfahren oder Kapitalanlage mit Renovierungsdruck — wir vermitteln diskret an Käufer, die im Ist-Zustand kaufen.</p>
        <ul class="card__checks">
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Faire Bewertung — auch Energieklasse E bis H
          </li>
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Nur geprüfte Käufer
          </li>
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Kein Aufräumen, keine Vorab-Sanierung
          </li>
        </ul>
        <a href="/#bewertung" class="btn btn-primary card__btn">Immobilie bewerten lassen &rarr;</a>
      </div>

      <!-- Käufer Card -->
      <div class="card card--buyer">
        <div class="card__photos">
          <div class="card__photo">
            <img src="/images/wkdi-buyer-businessman.jpg" alt="Investor auf der Baustelle" loading="lazy" />
            <span class="card__photo-label">Investor</span>
          </div>
          <div class="card__photo">
            <img src="/images/wkdi-buyer-handwerker.jpg" alt="Handwerker im Blaumann" loading="lazy" />
            <span class="card__photo-label">Handwerker</span>
          </div>
        </div>
        <div class="card__icon-box card__icon-box--dark">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
        </div>
        <h3>Ich suche Objekte</h3>
        <p>Off-Market Sanierungsobjekte in Leipzig. Kuratiert, vorgeprüft, mit Renditepotenzial.</p>
        <ul class="card__checks card__checks--dark">
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Geprüfte Objekte
          </li>
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Detaillierte Potenzialanalysen
          </li>
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Off-Market Deals
          </li>
        </ul>
        <a href="/investoren" class="btn btn-ghost card__btn">Investoren-Zugang anfragen &rarr;</a>
      </div>
    </div>
  </section>

  <!-- SZENARIEN -->
  <section class="section section--scenarios">
    <div class="container">
      <h2 class="scenarios-heading">Für welche Situationen wir der richtige Ansprechpartner sind</h2>
      <div class="scenarios-grid">

        <div class="scenario-card">
          <div class="scenario-bg" aria-hidden="true"><img src="/images/wkdi-szenario-erbengemeinschaft.jpg" alt="" loading="lazy" /></div>
          <div class="scenario-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3>Erbengemeinschaft</h3>
          <p>Zerstrittene Erben, fehlende Vollmachten, unklare Eigentumsverhältnisse. Wir koordinieren alle Beteiligten und verhindern die Teilungsversteigerung.</p>
        </div>

        <div class="scenario-card">
          <div class="scenario-bg" aria-hidden="true"><img src="/images/wkdi-szenario-messie.jpg" alt="" loading="lazy" /></div>
          <div class="scenario-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/><line x1="12" y1="22" x2="12" y2="12"/><line x1="3" y1="12" x2="21" y2="12"/></svg>
          </div>
          <h3>Messie-Objekt</h3>
          <p>Vollgestellte Wohnung, Gerüche, jahrelanger Leerstand. Kein Aufräumen, keine Entrümpelung vorab. Wir vermitteln an Käufer, die den Zustand kennen und trotzdem kaufen.</p>
        </div>

        <div class="scenario-card">
          <div class="scenario-bg" aria-hidden="true"><img src="/images/wkdi-szenario-geg.jpg" alt="" loading="lazy" /></div>
          <div class="scenario-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2z"/><path d="M12 8v4l3 3"/></svg>
          </div>
          <h3>GEG-Sanierungsstau</h3>
          <p>Energieklasse E bis H, Heizung veraltet, Förderpflicht droht. Unsere Käufer rechnen die Sanierungskosten ein — du trägst sie nicht.</p>
        </div>

        <div class="scenario-card">
          <div class="scenario-bg" aria-hidden="true"><img src="/images/wkdi-szenario-insolvenz.jpg" alt="" loading="lazy" /></div>
          <div class="scenario-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><line x1="12" y1="12" x2="12" y2="16"/><line x1="10" y1="14" x2="14" y2="14"/></svg>
          </div>
          <h3>Insolvenzverfahren</h3>
          <p>Zwangsversteigerung droht, Insolvenzverwalter ist eingebunden. Wir kennen die juristischen Abläufe und holen das Maximum raus — diskret und schnell.</p>
        </div>

        <div class="scenario-card scenario-card--highlight">
          <div class="scenario-bg" aria-hidden="true"><img src="/images/wkdi-szenario-kapitalanleger.jpg" alt="" loading="lazy" /></div>
          <div class="scenario-icon scenario-icon--highlight">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3>Kapitalanleger mit Renovierungsdruck</h3>
          <p>Vor 10 Jahren gekauft, abgeschrieben, jetzt steht die Sanierung an. Wer pro Stunde mehr verdient als der Handwerker, sollte seine Zeit nicht mit Renovierungskoordination verbringen. Wir übernehmen den Verkauf — ohne dass du eine Schraube anfasst.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- STEPS — Timeline Design -->
  <section class="steps-section">
    <div class="container">
      <h2 class="steps__title">In 3 Schritten zum Verkauf</h2>
      <div class="timeline">
        <div class="timeline__rail" aria-hidden="true">
          <div class="timeline__beam"></div>
        </div>

        <div class="timeline__item" data-step="1">
          <div class="timeline__dot">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </div>
          <div class="timeline__content">
            <div class="timeline__step-label">Schritt 01</div>
            <h3>PLZ eingeben</h3>
            <p>2 Minuten. Keine Fotos, kein Aufräumen. Nur die Postleitzahl deines Objekts — wir erledigen den Rest.</p>
          </div>
        </div>

        <div class="timeline__item" data-step="2">
          <div class="timeline__dot">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div class="timeline__content">
            <div class="timeline__step-label">Schritt 02</div>
            <h3>Erstbewertung in 48h</h3>
            <p>Wir bewerten die Substanz — nicht die Unordnung. Geprüfte Käufer geben verdeckte Angebote ab. Kein Bietergefecht, kein Stress.</p>
          </div>
        </div>

        <div class="timeline__item" data-step="3">
          <div class="timeline__dot">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div class="timeline__content">
            <div class="timeline__step-label">Schritt 03</div>
            <h3>Du entscheidest, fertig</h3>
            <p>Der Käufer übernimmt Entrümpelung und alle Kosten. Du musst dich um nichts kümmern. Notariell abgesichert.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST (Stitch horizontal card pattern) -->
  <section class="section" id="trust">
    <div class="container trust-wrap">
      <div class="trust-card">
        <div class="trust-card__image">
          <img src="/images/wkdi-deal-handshake-jung.png" alt="Fairer Immobiliendeal in Leipzig — Joachim Kleinke" />
        </div>
        <div class="trust-card__content">
          <div class="trust-card__stars" aria-label="5 von 5 Sternen">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <h2 class="trust-card__heading">35 Jahre Leipzig. Für die Fälle, für die andere Makler ablehnen.</h2>
          <blockquote class="trust-card__quote">
            &bdquo;Ob Messie-Wohnung, zerstrittene Erbengemeinschaft oder GEG-Problemfall — ich kenne jeden dieser Fälle aus über 35 Jahren Praxis. Und ich kenne die Käufer, die genau das suchen.&ldquo;
          </blockquote>
          <div class="trust-card__author">
            <span class="trust-card__name">Joachim Kleinke</span>
            <span class="trust-card__role">35+ Jahre Immobilien-Erfahrung</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section bg-alt">
    <div class="container faq">
      <h2>Häufige Fragen</h2>
      <div class="faq__list">
        <details class="faq__item">
          <summary>Ist das eine Versteigerung?</summary>
          <p>Nein. Im Gegensatz zur Versteigerung (&sect;156 BGB) besteht beim Angebotsverfahren kein Zwang, das Höchstangebot anzunehmen. Du entscheidest frei, welches Angebot du akzeptierst — oder ob du überhaupt verkaufst.</p>
        </details>
        <details class="faq__item">
          <summary>Muss ich das Höchstgebot annehmen?</summary>
          <p>Nein. Du siehst alle Angebote und entscheidest frei. Es gibt keinen Zuschlagszwang.</p>
        </details>
        <details class="faq__item">
          <summary>Was kostet mich das als Verkäufer?</summary>
          <p>Die Bewertung und das Angebotsverfahren sind kostenlos. Bei erfolgreichem Verkauf fällt eine Vermittlungsprovision an (2,5% vom Kaufpreis). Kein Verkauf = keine Kosten.</p>
        </details>
        <details class="faq__item">
          <summary>Wie sicher ist das?</summary>
          <p>Der Kaufvertrag kommt erst durch notarielle Beurkundung zustande. Bis dahin gehst du keinerlei Verpflichtung ein.</p>
        </details>
        <details class="faq__item">
          <summary>Muss ich die Wohnung aufräumen?</summary>
          <p>Nein. Unsere Käufer kaufen im Ist-Zustand. Entrümpelung, Reinigung und alle damit verbundenen Kosten übernimmt der Käufer — du musst dich um nichts kümmern.</p>
        </details>
        <details class="faq__item">
          <summary>Funktioniert das auch bei Erbengemeinschaften?</summary>
          <p>Ja. Erbengemeinschaften sind unser Spezialfall. Wir koordinieren alle Erben, übernehmen die Kommunikation und sorgen dafür, dass ihr nicht in der Teilungsversteigerung landet — die meist unter Marktwert endet.</p>
        </details>
        <details class="faq__item">
          <summary>Was ist mit einer Wohnung im Insolvenzverfahren?</summary>
          <p>Auch hier können wir helfen. Im Insolvenzverfahren entscheidet der Insolvenzverwalter — aber er braucht einen Käufer. Wir liefern geprüfte Kaufinteressenten schnell, damit jeder Monat Zinsbelastung gespart wird.</p>
        </details>
        <details class="faq__item">
          <summary>Meine Wohnung hat Energieklasse F — ist das ein Problem?</summary>
          <p>Nein. GEG-betroffene Wohnungen (Energieklasse E bis H) sind genau die Objekte, die unsere Investorenkäufer suchen. Sie rechnen die Sanierungskosten ein — du musst nichts vorfinanzieren.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- STADTTEILE -->
  <section class="section">
    <div class="container stadtteile">
      <h2>Stadtteile in Leipzig</h2>
      <p class="text-mid">Milieuschutzgebiete, GEG-Sanierungs&shy;potenzial und Marktpreise für deinen Stadtteil</p>
      <div class="stadtteile-grid">
        <a href="/leipzig/volkmarsdorf" class="stadtteile-pill">Volkmarsdorf</a>
        <a href="/leipzig/plagwitz" class="stadtteile-pill">Plagwitz</a>
        <a href="/leipzig/lindenau" class="stadtteile-pill">Lindenau</a>
        <a href="/leipzig/neustadt-neuschonefeld" class="stadtteile-pill">Neustadt-Neuschönefeld</a>
        <a href="/leipzig/reudnitz-thonberg" class="stadtteile-pill">Reudnitz-Thonberg</a>
      </div>
    </div>
  </section>

  <!-- ROI RECHNER TEASER -->
  <section class="section roi-teaser-section">
    <div class="container roi-teaser__inner">
      <!-- Left: Copy -->
      <div class="roi-teaser__copy">
        <p class="roi-teaser__eyebrow">Für Investoren</p>
        <h2 class="roi-teaser__heading">Lohnt sich der Deal?<br /><span class="text-accent">Rechne es durch.</span></h2>
        <p class="roi-teaser__body">Fix &amp; Flip Kalkulation mit echten Leipziger Marktdaten. Rendite, Nebenkosten, 70%-Regel und BEG-Förderung — in 3 Minuten. Am Ende erhältst du deine persönliche Deal-Analyse als PDF.</p>
        <ul class="roi-teaser__benefits">
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            Echte Marktpreise — 8 Stadtteile Leipzig
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            Deal Score A–D mit 70%-Regel-Check
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            BEG-Förderung bei GEG-Objekten berücksichtigt
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            Persönliche Analyse als PDF — kostenlos per E-Mail
          </li>
        </ul>
        <a href="/roi-rechner" class="btn btn-primary roi-teaser__cta">Jetzt Rendite berechnen &rarr;</a>
      </div>
      <!-- Right: PDF Mockup Card -->
      <div class="roi-teaser__visual" aria-hidden="true">
        <div class="roi-mockup-wrap">
          <div class="roi-mockup-card">
            <div class="roi-mockup-bg">
