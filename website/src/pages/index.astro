<style>
  /* HERO */
  .hero {
    text-align: center;
    padding-top: var(--space-20);
    padding-bottom: var(--space-16);
    position: relative;
    overflow: hidden;
  }

  .hero__bg-img {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero__bg-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.20;
    filter: grayscale(30%);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .hero__dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
