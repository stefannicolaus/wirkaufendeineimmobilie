  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .hero__sub {
    font-size: var(--text-lg);
    color: var(--color-text-mid);
    text-align: center;
    max-width: 640px;
  }

  /* Hero Form Card */
  .hero-form-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 8px;
    box-shadow: var(--shadow-lg);
    width: 100%;
    max-width: 580px;
    margin-top: var(--space-4);
  }

  .hero-form-card__inner {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .hero-form-card__input-wrap {
    flex: 1;
    position: relative;
    display: flex;
    align-items: center;
  }

  .hero-form-card__icon {
    position: absolute;
    left: 12px;
    color: var(--color-text-muted);
    pointer-events: none;
    flex-shrink: 0;
  }

  .hero-form-card__input-wrap input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    padding-left: 44px;
    box-shadow: none;
  }

  .hero-form-card__input-wrap input:focus {
    outline: none;
    border-color: transparent;
    box-shadow: none;
  }

  .hero-form-card__btn {
    flex-shrink: 0;
    white-space: nowrap;
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4) var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-mid);
    margin-top: var(--space-4);
  }

  @media (max-width: 640px) {
    .hero-form-card__inner {
      flex-direction: column;
    }
    .hero-form-card__btn {
      width: 100%;
    }
    .hero__trust {
      flex-direction: column;
      align-items: center;
      gap: var(--space-2);
    }
  }

  /* STATS BAR — full width background */
  .stats-bar {
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-8);
  }

  .stats-bar__inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
    text-align: center;
  }

  .stat__number {
    display: block;
    font-size: var(--text-4xl);
    font-weight: var(--weight-extrabold);
    color: var(--color-text);
    letter-spacing: var(--tracking-tight);
  }

  .stat__label {
    font-size: var(--text-sm);
    color: var(--color-text-mid);
  }

  @media (max-width: 640px) {
    .stats-bar__inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* DUAL CARDS — bigger, with icon elements */
  .dual-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .card {
    padding: 40px;
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    overflow: hidden;
  }

