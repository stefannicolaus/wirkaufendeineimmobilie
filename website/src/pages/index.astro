  .card__icon-box {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .card__icon-box--light {
    background: var(--color-accent-light);
    color: var(--color-accent);
  }

  .card__icon-box--dark {
    background: var(--color-primary-muted);
    color: var(--color-text-on-dark);
  }

  /* Card Checkmark List */
  .card__checks {
    list-style: none;
