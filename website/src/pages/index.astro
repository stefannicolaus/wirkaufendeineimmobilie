  }

  .card__checks li svg {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    color: var(--color-success);
  }

  .card__checks--dark li {
    color: var(--color-text-muted);
  }

  .card__checks--dark li svg {
    color: var(--color-success);
  }

  .card__btn {
    align-self: stretch;
    margin-top: var(--space-4);
    text-align: center;
  }

  @media (max-width: 768px) {
    .dual-cards {
      grid-template-columns: 1fr;
    }
  }

  /* SCENARIOS — Feature Cards with Hover Glow (ANF Framework) */
  .section--scenarios {
    background: var(--color-primary);
    padding-block: var(--section-gap);
  }
  .scenarios-heading {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 700;
    margin-bottom: 2rem;
    color: #F8FAFC;
    text-align: center;
  }
  .scenarios-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1px;
    background: rgba(255,255,255,0.07);
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
  }
  .scenario-card {
    background: rgba(15, 23, 42, 0.95);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    position: relative;
    overflow: hidden;
    transition: background 0.3s ease;
    cursor: default;
  }

  .scenario-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .scenario-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.20;
    filter: grayscale(40%) saturate(0.8);
    transition: opacity 0.4s ease;
  }

  .scenario-card:hover .scenario-bg img {
    opacity: 0.55;
  }

  .scenario-card > :not(.scenario-bg) {
    position: relative;
    z-index: 1;
  }
  .scenario-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(59, 130, 246, 0.08),
      transparent 40%
    );
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .scenario-card:hover::before {
    opacity: 1;
  }
  .scenario-card:hover {
    background: rgba(30, 41, 59, 0.98);
  }
  .scenario-card--highlight {
    grid-column: span 2;
  }
  .scenario-card--highlight::before {
    background: radial-gradient(
      800px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(59, 130, 246, 0.1),
      transparent 40%
    );
  }
  @media (max-width: 640px) {
    .scenario-card--highlight { grid-column: span 1; }
  }
  .scenario-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.10);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94A3B8;
    flex-shrink: 0;
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }
  .scenario-card:hover .scenario-icon {
    background: rgba(59, 130, 246, 0.15);
    border-color: rgba(59, 130, 246, 0.3);
    color: #60A5FA;
  }
  .scenario-icon--highlight {
    background: rgba(59, 130, 246, 0.12);
    border-color: rgba(59, 130, 246, 0.25);
    color: #60A5FA;
  }
  .scenario-card h3 {
    font-size: 1rem;
    font-weight: 700;
    margin: 0;
    color: #E2E8F0;
    transition: color 0.3s ease;
  }
  .scenario-card:hover h3 {
    color: #F8FAFC;
  }
  .scenario-card p {
    font-size: 0.875rem;
    color: #CBD5E1;
    margin: 0;
    line-height: 1.6;
    transition: color 0.3s ease;
  }
  .scenario-card:hover p,
  .scenario-card:active p {
    color: #ffffff;
  }

  /* STEPS — Timeline Design (ANF Framework) */
  .steps-section {
    background: var(--color-bg);
    padding-block: var(--section-gap);
  }

  .steps__title {
    text-align: center;
    margin-bottom: var(--space-16);
  }

  .timeline {
    position: relative;
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .timeline__rail {
    position: absolute;
    left: 27px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-border);
    z-index: 0;
  }

  .timeline__beam {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    background: linear-gradient(to bottom, var(--color-accent), rgba(59,130,246,0));
    height: 0%;
    transition: height 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .timeline__item {
    display: flex;
    gap: var(--space-6);
    padding-bottom: var(--space-10);
    position: relative;
    z-index: 1;
    opacity: 1;
    transform: translateX(0);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .timeline__item.animate-hidden {
    opacity: 0;
    transform: translateX(-16px);
  }

  .timeline__item.animate-hidden.visible {
    opacity: 1;
    transform: translateX(0);
  }

  .timeline__item:last-child {
    padding-bottom: 0;
  }

  .timeline__dot {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-accent-light);
    border: 2px solid var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--color-accent);
    box-shadow: 0 0 0 6px rgba(59,130,246,0.08);
  }

  .timeline__content {
    padding-top: 12px;
    flex: 1;
  }

  .timeline__step-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--color-accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .timeline__content h3 {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .timeline__content p {
    color: var(--color-text-mid);
    line-height: 1.65;
  }

  /* TRUST — horizontal card (Stitch pattern) */
  .trust-wrap {
    display: flex;
    justify-content: center;
  }

  .trust-card {
    max-width: 900px;
    width: 100%;
    background: var(--color-bg-card);
