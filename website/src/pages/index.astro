    text-align: center;
  }

  .bewertung p {
    margin-bottom: var(--space-8);
  }

  .bewertung-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 32px;
    box-shadow:
      0 4px 8px rgba(15, 23, 42, 0.04),
      0 8px 24px rgba(15, 23, 42, 0.1),
      0 16px 48px rgba(15, 23, 42, 0.06);
