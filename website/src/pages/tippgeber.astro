---
import Layout from '../layouts/Layout.astro';
import FormPrivacyHint from '../components/FormPrivacyHint.astro';
---
<Layout
  title="Tippgeber werden — Zusatzeinkommen für einen guten Tipp | wirkaufendeineimmobilie.de"
  description="Du bist sowieso in Wohnhäusern unterwegs. Wenn du hörst dass jemand verkaufen will, melde uns den Kontakt — und verdiene echtes Zusatzeinkommen. Für Postboten, Hausmeister, Handwerker und mehr."
>

  <!-- HERO -->
  <section class="section tipp-hero">
    <div class="container tipp-hero__inner">
      <div class="label">Tippgeber werden</div>
      <h1>Verdiene echtes Zusatzeinkommen —<br /><span class="text-accent">für einen guten Tipp.</span></h1>
      <p class="tipp-hero__sub">
        Du bist sowieso jeden Tag in Wohnhäusern unterwegs. Wenn du hörst dass jemand verkaufen will — melde uns den Kontakt. Wir machen den Rest.
      </p>
      <div class="tipp-hero__buttons">
        <a href="#tippgeber-form" class="btn btn-primary">Jetzt anmelden &rarr;</a>
        <a href="#wer" class="btn btn-outline">Mehr erfahren &darr;</a>
      </div>
    </div>
  </section>

  <!-- PAIN -->
  <section class="section tipp-pain bg-alt">
    <div class="container tipp-pain__inner">
      <p class="tipp-pain__text">
        Du arbeitest hart — und am Ende des Monats könnte immer etwas mehr übrig sein?
      </p>
    </div>
  </section>

  <!-- WER KANN TIPPGEBER WERDEN -->
  <section class="section tipp-wer-section" id="wer">
    <div class="container">
      <div class="tipp-section-header">
        <div class="label">Für wen ist das?</div>
        <h2>Wer kann Tippgeber werden?</h2>
        <p class="text-mid">Wer täglich in Wohnhäusern unterwegs ist, hört manchmal Dinge die andere nicht hören. Das ist dein Vorteil.</p>
      </div>

      <div class="tipp-wer-grid">

        <div class="tipp-wer-card">
          <div class="tipp-wer-card__icon">
            <!-- Mail / Envelope -->
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <h3>Postboten &amp; Zeitungszusteller</h3>
          <p>Jeden Tag an Hunderten Türen — du bist nah dran wie kaum jemand sonst.</p>
        </div>

        <div class="tipp-wer-card">
          <div class="tipp-wer-card__icon">
            <!-- Sparkles / Cleaning -->
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M3 5h4"/><path d="M19 17v4"/><path d="M17 19h4"/></svg>
          </div>
          <h3>Gebäudereiniger &amp; Fensterputzer</h3>
          <p>Du kennst jeden Flur und jeden Hausflur — und manchmal auch die Sorgen der Bewohner.</p>
        </div>

        <div class="tipp-wer-card">
          <div class="tipp-wer-card__icon">
            <!-- Wrench / Tool -->
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <h3>Hausmeister</h3>
          <p>Du weißt als Erster, wenn ein Eigentümer über Verkauf nachdenkt oder wegzieht.</p>
        </div>

        <div class="tipp-wer-card">
          <div class="tipp-wer-card__icon">
            <!-- Flame -->
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
          </div>
          <h3>Schornsteinfeger</h3>
          <p>Vertrauensperson in jedem Haushalt — Jahrzehnte alte Beziehungen, die Früchte tragen.</p>
        </div>

        <div class="tipp-wer-card">
          <div class="tipp-wer-card__icon">
            <!-- Heart -->
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
          </div>
          <h3>Pflegedienste</h3>
          <p>Wenn ältere Menschen Hilfe bei der Abwicklung brauchen — du bist derjenige dem sie vertrauen.</p>
        </div>

        <div class="tipp-wer-card">
          <div class="tipp-wer-card__icon">
            <!-- Hammer -->
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 12-8.373 8.373a1 1 0 1 1-3-3L12 9"/><path d="m18 15 4-4"/><path d="m21.5 11.5-1.914-1.914A2 2 0 0 1 19 8.172V7l-2.26-2.26a6 6 0 0 0-4.202-1.756L9 2.96l.92.82A6.18 6.18 0 0 1 12 8.4V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5"/></svg>
          </div>
          <h3>Handwerker</h3>
          <p>Beim Renovieren, Reparieren oder Sanieren erfährst du oft als Erster von Verkaufsplänen.</p>
        </div>

        <div class="tipp-wer-card">
          <div class="tipp-wer-card__icon">
            <!-- Package -->
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/><path d="M12 22V12"/><polyline points="3.29 7 12 12 20.71 7"/><line x1="12" y1="2" x2="12" y2="7"/></svg>
          </div>
          <h3>Paket-Zusteller</h3>
          <p>DHL, Amazon &amp; Co — du bist jeden Tag an Türen die andere nie sehen.</p>
        </div>

        <div class="tipp-wer-card">
          <div class="tipp-wer-card__icon">
            <!-- Thermometer -->
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"/></svg>
          </div>
          <h3>Heizungs-/Wasserableser &amp; Rauchmelder-Wartung</h3>
          <p>Pflichttermine die dich in jede Wohnung bringen — ein kurzes Gespräch reicht oft.</p>
        </div>

        <div class="tipp-wer-card tipp-wer-card--highlight">
          <div class="tipp-wer-card__icon">
            <!-- Users / People -->
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3>Jeder der regelmäßig in Wohnhäusern unterwegs ist</h3>
          <p>Wenn du regelmäßig in Wohngebäuden arbeitest und manchmal hörst was andere nicht hören — du bist gemeint.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- SO FUNKTIONIERT'S -->
  <section class="section tipp-steps bg-alt">
    <div class="container">
      <div class="tipp-section-header">
        <div class="label">So einfach geht's</div>
        <h2>So funktioniert's.</h2>
      </div>

      <div class="tipp-steps__grid">
        <div class="tipp-step">
          <div class="tipp-step__number">1</div>
          <div class="tipp-step__content">
            <h3>Du hörst von jemandem der verkaufen will?</h3>
            <p>Melde uns den Kontakt — per Telefon, WhatsApp oder über das Formular. Kein Papierkram, kein Aufwand.</p>
          </div>
        </div>
        <div class="tipp-step__connector" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </div>
        <div class="tipp-step">
          <div class="tipp-step__number">2</div>
          <div class="tipp-step__content">
            <h3>Du willst aktiv werden?</h3>
            <p>Nach deiner Anmeldung zeigen wir dir genau wie es geht — verständlich, Schritt für Schritt. Kein Vorwissen nötig.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- VERTRAGSHINWEIS -->
  <section class="section">
    <div class="container">
      <div class="tipp-vertragshinweis">
        <div class="tipp-vertragshinweis__icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div class="tipp-vertragshinweis__content">
          <h3>Dein Provisionsanspruch ist vertraglich abgesichert.</h3>
          <p class="text-mid">Nach deiner Anmeldung bekommst du alle Details — transparent, klar und schriftlich.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA GLOW -->
  <section class="tipp-cta-glow-section">
    <div class="tipp-cta-glow__glow" aria-hidden="true"></div>
    <div class="container tipp-cta-glow__inner">
      <p class="tipp-cta-glow__eyebrow">Kein Vorwissen nötig</p>
      <h2 class="tipp-cta-glow__heading">Ein Tipp. Echter Lohn.</h2>
      <p class="tipp-cta-glow__sub">Melde uns den Kontakt — wir machen den Rest. Dein Provisionsanspruch ist schriftlich abgesichert.</p>
      <a href="#tippgeber-form" class="tipp-cta-glow__btn">Jetzt anmelden &rarr;</a>
    </div>
  </section>

  <!-- REGISTRATION FORM — 2-Column Split -->
  <section class="tipp-form-section bg-alt" id="tippgeber-form">
    <div class="container tipp-form-split">
      <div class="tipp-form-split__text">
        <h2>Jetzt anmelden —<br />in 2 Minuten.</h2>
        <p class="text-mid">Einfach Formular ausfüllen, wir melden uns bei dir. Kein Risiko, keine Verpflichtung.</p>
        <ul class="tipp-form-split__checks">
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Dein Provisionsanspruch ist schriftlich abgesichert
          </li>
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Kein Vorwissen nötig — wir erklären alles
          </li>
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Wir machen den Rest — du brauchst nur den Kontakt
          </li>
        </ul>
      </div>

      <div class="tipp-form-card">
        <form class="tipp-form" id="tippgeber-reg-form">
          <!-- Honeypot -->
          <div class="tipp-form__honeypot" aria-hidden="true">
            <label for="website">Website</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <div class="form-group">
            <label for="tipp-name">Name *</label>
            <input type="text" id="tipp-name" name="name" required placeholder="Vorname Nachname" />
          </div>
          <div class="form-group">
            <label for="tipp-email">E-Mail *</label>
            <input type="email" id="tipp-email" name="email" required placeholder="deine@email.de" />
          </div>
          <div class="form-group">
            <label for="tipp-tel">Telefon *</label>
            <input type="tel" id="tipp-tel" name="telefon" required placeholder="0341 123 456" />
          </div>
          <div class="form-group">
            <label for="tipp-beruf">Ich bin... *</label>
            <select id="tipp-beruf" name="beruf" required>
              <option value="">Bitte wählen...</option>
              <option value="postbote">Postbote / Zeitungszusteller</option>
              <option value="reiniger">Gebäudereiniger / Fensterputzer</option>
              <option value="hausmeister">Hausmeister</option>
              <option value="schornsteinfeger">Schornsteinfeger</option>
              <option value="pflege">Pflegedienst</option>
              <option value="handwerker">Handwerker</option>
              <option value="paket">Paket-Zusteller</option>
              <option value="ableser">Ableser / Wartungsdienst</option>
              <option value="sonstiges">Sonstiges</option>
            </select>
          </div>
          <div class="form-group">
            <label for="tipp-plz">PLZ Einsatzgebiet <span class="tipp-form__optional">(optional)</span></label>
            <input type="text" id="tipp-plz" name="plz" placeholder="z.B. 04177" />
          </div>
          <button type="submit" class="btn btn-primary tipp-form__submit">Jetzt anmelden &rarr;</button>
          <FormPrivacyHint />
        </form>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* HERO */
  .tipp-hero {
    text-align: center;
    padding-top: var(--space-20);
    padding-bottom: var(--space-16);
  }

  .tipp-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .tipp-hero__sub {
    font-size: var(--text-lg);
    color: var(--color-text-mid);
    text-align: center;
    max-width: 620px;
  }

  .tipp-hero__buttons {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* PAIN */
  .tipp-pain {
    padding-block: var(--space-16);
  }

  .tipp-pain__inner {
    display: flex;
    justify-content: center;
  }

  .tipp-pain__text {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    text-align: center;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
  }

  /* SECTION HEADER */
  .tipp-section-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 560px;
    margin-bottom: var(--space-12);
  }

  /* WER-GRID — Dark Hover Grid */
  .tipp-wer-section {
    background: var(--color-primary);
  }
  .tipp-wer-section .tipp-section-header h2 {
    color: white;
  }
  .tipp-wer-section .tipp-section-header p {
    color: rgba(255, 255, 255, 0.65);
  }
  .tipp-wer-section .label {
    color: var(--color-accent);
    background: rgba(59, 130, 246, 0.12);
    border-color: rgba(59, 130, 246, 0.25);
  }
  .tipp-wer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: rgba(255, 255, 255, 0.07);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .tipp-wer-card {
    background: #0f172a;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    position: relative;
    overflow: hidden;
    cursor: default;
  }

  .tipp-wer-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      350px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(59, 130, 246, 0.12),
      transparent 60%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .tipp-wer-card:hover::before {
    opacity: 1;
  }

  .tipp-wer-card--highlight {
    background: rgba(59, 130, 246, 0.15);
  }

  .tipp-wer-card--highlight::before {
    background: radial-gradient(
      350px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(59, 130, 246, 0.2),
      transparent 60%
    );
  }

  .tipp-wer-card__icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(59, 130, 246, 0.15);
    color: var(--color-accent);
    border-radius: var(--radius-md);
    flex-shrink: 0;
    border: 1px solid rgba(59, 130, 246, 0.2);
    transition: background var(--duration-normal) var(--ease-default),
                color var(--duration-normal) var(--ease-default);
  }

  .tipp-wer-card:hover .tipp-wer-card__icon {
    background: var(--color-accent);
    color: white;
    border-color: transparent;
  }

  .tipp-wer-card--highlight .tipp-wer-card__icon {
    background: var(--color-accent);
    color: white;
    border-color: transparent;
  }

  .tipp-wer-card h3 {
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    color: white;
  }

  .tipp-wer-card p {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.6);
    line-height: var(--leading-relaxed);
  }

  /* STEPS */
  .tipp-steps {
    padding-block: var(--section-gap);
  }

  .tipp-steps__grid {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    max-width: 900px;
  }

  .tipp-step {
    flex: 1;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
    box-shadow: var(--shadow-sm);
  }

  .tipp-step__number {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent);
    color: var(--color-text-on-accent);
    border-radius: var(--radius-full);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    flex-shrink: 0;
  }

  .tipp-step__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .tipp-step__content h3 {
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    color: var(--color-text);
  }

  .tipp-step__content p {
    font-size: var(--text-sm);
    color: var(--color-text-mid);
    line-height: var(--leading-relaxed);
  }

  .tipp-step__connector {
    flex-shrink: 0;
  }

  /* VERTRAGSHINWEIS */
  .tipp-vertragshinweis {
    display: flex;
    align-items: flex-start;
    gap: var(--space-6);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-lg);
    padding: clamp(24px, 3vw, 40px);
    box-shadow: var(--shadow-sm);
    max-width: 720px;
  }

  .tipp-vertragshinweis__icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-light);
    color: var(--color-accent);
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .tipp-vertragshinweis__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .tipp-vertragshinweis__content h3 {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--color-text);
  }

  /* FORM SECTION — 2-Column Split */
  .tipp-form-section {
    padding-block: var(--section-gap);
  }

  .tipp-form-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .tipp-form-split__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-4);
  }

  .tipp-form-split__text h2 {
    font-size: var(--text-3xl);
  }

  .tipp-form-split__checks {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .tipp-form-split__checks li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }

  .tipp-form-split__checks li svg {
    flex-shrink: 0;
  }

  /* Form Card */
  .tipp-form-card {
    background: var(--color-bg-card);
    border-radius: var(--radius-xl);
    padding: clamp(24px, 3vw, 40px);
    box-shadow:
      0 4px 8px rgba(15, 23, 42, 0.04),
      0 8px 24px rgba(15, 23, 42, 0.1),
      0 16px 48px rgba(15, 23, 42, 0.06);
  }

  .tipp-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  /* Honeypot — visually hidden, trap bots */
  .tipp-form__honeypot {
    position: absolute;
    left: -9999px;
    top: -9999px;
    opacity: 0;
    pointer-events: none;
    tab-index: -1;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .form-group label {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-mid);
  }

  .form-group input,
  .form-group select {
    width: 100%;
  }

  .tipp-form__optional {
    font-weight: var(--weight-regular);
    color: var(--color-text-muted);
  }

  .tipp-form__submit {
    width: 100%;
    margin-top: var(--space-2);
  }

  /* CTA GLOW */
  .tipp-cta-glow-section {
    position: relative;
    background: var(--color-primary);
    padding-block: var(--space-20);
    overflow: hidden;
  }
  .tipp-cta-glow__glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 300px;
    background: radial-gradient(ellipse at center, rgba(59, 130, 246, 0.25) 0%, transparent 70%);
    pointer-events: none;
  }
  .tipp-cta-glow__inner {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }
  .tipp-cta-glow__eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0;
  }
  .tipp-cta-glow__heading {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: var(--weight-extrabold);
    color: white;
    line-height: var(--leading-tight);
    max-width: 640px;
    margin: 0;
  }
  .tipp-cta-glow__sub {
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.65);
    max-width: 560px;
    margin: 0;
  }
  .tipp-cta-glow__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-8);
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    color: white;
    background: var(--color-accent);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all var(--duration-fast) ease;
    margin-top: var(--space-2);
    box-shadow: 0 0 32px rgba(59, 130, 246, 0.5);
  }
  .tipp-cta-glow__btn:hover {
    background: var(--color-accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 0 48px rgba(59, 130, 246, 0.65);
  }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .tipp-wer-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .tipp-steps__grid {
      flex-direction: column;
    }

    .tipp-step__connector {
      transform: rotate(90deg);
    }
  }

  @media (max-width: 768px) {
    .tipp-wer-grid {
      grid-template-columns: 1fr;
    }

    .tipp-form-split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .tipp-vertragshinweis {
      flex-direction: column;
      gap: var(--space-4);
    }
  }
</style>

<script>
  // Mouse-tracking glow for dark grid cards
  document.querySelectorAll('.tipp-wer-card').forEach((card) => {
    card.addEventListener('mousemove', (e) => {
      const rect = (card as HTMLElement).getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;
      (card as HTMLElement).style.setProperty('--mouse-x', `${x}%`);
      (card as HTMLElement).style.setProperty('--mouse-y', `${y}%`);
    });
  });

  const form = document.getElementById('tippgeber-reg-form') as HTMLFormElement;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = btn.textContent;
    btn.textContent = 'Wird gesendet...';
    btn.disabled = true;

    try {
      const res = await fetch('/api/tippgeber', { method: 'POST', body: formData });
      if (res.ok) {
        window.location.href = '/danke?typ=tippgeber';
      } else {
        btn.textContent = 'Fehler — bitte erneut versuchen';
        btn.disabled = false;
        setTimeout(() => { btn.textContent = originalText; }, 3000);
      }
    } catch {
      btn.textContent = 'Fehler — bitte erneut versuchen';
      btn.disabled = false;
      setTimeout(() => { btn.textContent = originalText; }, 3000);
    }
  });
</script>
