<script>
  // Mouse-tracking glow for dark grid cards
  document.querySelectorAll('.tipp-wer-card').forEach((card) => {
    card.addEventListener('mousemove', (e) => {
      const rect = (card as HTMLElement).getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;
      (card as HTMLElement).style.setProperty('--mouse-x', `${x}%`);
      (card as HTMLElement).style.setProperty('--mouse-y', `${y}%`);
    });
  });

  const form = document.getElementById('tippgeber-reg-form') as HTMLFormElement;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = btn.textContent;
    btn.textContent = 'Wird gesendet...';
    btn.disabled = true;

    try {
      const res = await fetch('/api/tippgeber', { method: 'POST', body: formData });
      if (res.ok) {
        document.getElementById('tippgeber-reg-form')!.style.display = 'none';
        const nameField = form.querySelector('input[name="name"], input[name="vorname"]') as HTMLInputElement;
        const nameSpan = document.getElementById('submitted-name');
        if (nameField && nameSpan) nameSpan.textContent = nameField.value.split(' ')[0] || nameField.value;
        const postSubmit = document.getElementById('post-submit')!;
        postSubmit.style.display = 'block';
        postSubmit.scrollIntoView({ behavior: 'smooth' });
      } else {
        btn.textContent = 'Fehler — bitte erneut versuchen';
        btn.disabled = false;
        setTimeout(() => { btn.textContent = originalText; }, 3000);
      }
    } catch {
      btn.textContent = 'Fehler — bitte erneut versuchen';
      btn.disabled = false;
      setTimeout(() => { btn.textContent = originalText; }, 3000);
    }
  });
</script>
