---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Impressum — wirkaufendeineimmobilie.de"
  description="Impressum und Angaben gemäß § 5 TMG für wirkaufendeineimmobilie.de — Vermittlungsplattform für sanierungsbedürftige Wohnungen in Leipzig."
>

  <section class="section">
    <div class="container container--narrow legal">
      <h1>Impressum</h1>

      <h2>Angaben gemäß § 5 TMG</h2>
      <p>
        <strong>[Firmenname — Platzhalter]</strong><br />
        [Straße Nr.]<br />
        [PLZ Ort]
      </p>

      <h3>Vertreten durch</h3>
      <p>[Name des Vertretungsberechtigten]</p>

      <h3>Kontakt</h3>
      <p>
        Telefon: 0341 — 800 900 0<br />
        E-Mail: [E-Mail-Adresse — Platzhalter]
      </p>

      <h3>Erlaubnis nach § 34c GewO</h3>
      <p>
        Erlaubnis nach § 34c der Gewerbeordnung<br />
        Zuständige Behörde: [Erlaubnisbehörde — Platzhalter]<br />
        Registriernummer: [Nummer — Platzhalter]
      </p>

      <h3>Zuständige IHK</h3>
      <p>
        Industrie- und Handelskammer zu Leipzig<br />
        Goerdelerring 5, 04109 Leipzig
      </p>

      <h3>Verbraucherstreitbeilegung / Universalschlichtungsstelle</h3>
      <p>
        Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren
        vor einer Verbraucherschlichtungsstelle teilzunehmen.
      </p>

      <h2>DL-InfoV</h2>
      <h3>Informationen gemäß Dienstleistungs-Informationspflichten-Verordnung</h3>
      <p>
        <strong>Berufshaftpflichtversicherung:</strong><br />
        [Versicherungsunternehmen — Platzhalter]<br />
        [Räumlicher Geltungsbereich — Platzhalter]
      </p>
    </div>
  </section>

</Layout>

<style>
  .legal {
  }

  .legal h1 {
    margin-bottom: var(--space-8);
  }

  .legal h2 {
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
  }

  .legal h3 {
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }

  .legal p {
    color: var(--color-text-mid);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }
</style>
