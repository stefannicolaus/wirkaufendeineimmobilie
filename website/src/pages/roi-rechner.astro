---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="ROI-Rechner — Deal-Analyse in 4 Schritten | wirkaufendeineimmobilie.de"
  description="Berechne Rendite, Förderung und Gewinn für dein nächstes Sanierungsobjekt in Leipzig — mit echten Marktdaten. Kostenlos, sofort per E-Mail."
>

  <!-- HERO -->
  <section class="quiz-hero">
    <div class="quiz-hero__bg" aria-hidden="true">
      <img src="/images/wkdi-roi-quiz-hero.jpg" alt="" />
    </div>
    <div class="container quiz-hero__inner">
      <h1>Was bringt dein nächster Deal?</h1>
      <p class="quiz-hero__sub">Berechne Rendite, Förderung und Gewinn — mit echten Leipziger Marktdaten.</p>
    </div>
  </section>

  <!-- PROGRESS -->
  <div class="quiz-progress-wrap" id="quiz-progress">
    <div class="container">
      <div class="quiz-progress">
        <button class="quiz-step-dot" data-step="1" aria-label="Schritt 1: Objekt-Typ">
          <span class="quiz-step-dot__num">1</span>
          <span class="quiz-step-dot__label">Objekt-Typ</span>
        </button>
        <div class="quiz-step-connector"></div>
        <button class="quiz-step-dot" data-step="2" aria-label="Schritt 2: Lage & Strategie">
          <span class="quiz-step-dot__num">2</span>
          <span class="quiz-step-dot__label">Lage &amp; Strategie</span>
        </button>
        <div class="quiz-step-connector"></div>
        <button class="quiz-step-dot" data-step="3" aria-label="Schritt 3: Zahlen">
          <span class="quiz-step-dot__num">3</span>
          <span class="quiz-step-dot__label">Zahlen</span>
        </button>
        <div class="quiz-step-connector"></div>
        <button class="quiz-step-dot" data-step="4" aria-label="Schritt 4: Ergebnis">
          <span class="quiz-step-dot__num">4</span>
          <span class="quiz-step-dot__label">Ergebnis</span>
        </button>
      </div>
    </div>
  </div>

  <!-- QUIZ WRAPPER -->
  <section class="quiz-section">
    <div class="container">

      <!-- STEP 1: Objekt-Typ -->
      <div class="quiz-step" id="step-1">
        <div class="quiz-step__header">
          <h2>Welchen Objekt-Typ willst du kalkulieren?</h2>
          <p class="quiz-step__hint">Wähle das passende Szenario — beeinflusst BEG-Förderung und Deal Score.</p>
        </div>
        <div class="scenario-grid">

          <button class="scenario-card" data-value="messie" aria-label="Messie / Verwahrlost">
            <div class="scenario-card__bg" style="background-image: url('/images/wkdi-szenario-messie.jpg')"></div>
            <div class="scenario-card__glow"></div>
            <div class="scenario-card__content">
              <svg class="scenario-card__icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
              <h3>Messie / Verwahrlost</h3>
            </div>
          </button>

          <button class="scenario-card" data-value="erbengemeinschaft" aria-label="Erbengemeinschaft">
            <div class="scenario-card__bg" style="background-image: url('/images/wkdi-szenario-erbengemeinschaft.jpg')"></div>
            <div class="scenario-card__glow"></div>
            <div class="scenario-card__content">
              <svg class="scenario-card__icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              <h3>Erbengemeinschaft</h3>
            </div>
          </button>

          <button class="scenario-card" data-value="geg" aria-label="GEG-Problemfall">
            <div class="scenario-card__bg" style="background-image: url('/images/wkdi-szenario-geg.jpg')"></div>
            <div class="scenario-card__glow"></div>
            <div class="scenario-card__content">
              <span class="badge-beg">40% BEG-Förderung</span>
              <svg class="scenario-card__icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
              <h3>GEG-Problemfall</h3>
            </div>
          </button>

          <button class="scenario-card" data-value="insolvenz" aria-label="Insolvenz / Zwangslage">
            <div class="scenario-card__bg" style="background-image: url('/images/wkdi-szenario-insolvenz.jpg')"></div>
            <div class="scenario-card__glow"></div>
            <div class="scenario-card__content">
              <svg class="scenario-card__icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <h3>Insolvenz / Zwangslage</h3>
            </div>
          </button>

          <button class="scenario-card" data-value="standard" aria-label="Kapitalanlage">
            <div class="scenario-card__bg" style="background-image: url('/images/wkdi-szenario-kapitalanleger.jpg')"></div>
            <div class="scenario-card__glow"></div>
            <div class="scenario-card__content">
              <svg class="scenario-card__icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              <h3>Kapitalanlage</h3>
            </div>
          </button>

        </div>
      </div>

      <!-- STEP 2: Lage & Strategie -->
      <div class="quiz-step" id="step-2" hidden>
        <div class="quiz-step__header">
          <h2>Lage &amp; Exit-Strategie</h2>
          <p class="quiz-step__hint">Der Stadtteil bestimmt den Verkaufspreis, die Strategie die Steuer.</p>
        </div>
        <div class="step2-grid">

          <!-- Left: Stadtteil -->
          <div class="step2-col">
            <label class="field-label" for="stadtteil-select">Stadtteil</label>
            <div class="select-wrap">
              <select id="stadtteil-select" class="styled-select">
                <option value="plagwitz">Plagwitz (3.200 €/m²)</option>
                <option value="suedvorstadt">Südvorstadt (3.100 €/m²)</option>
                <option value="gohlis">Gohlis (2.800 €/m²)</option>
                <option value="lindenau" selected>Lindenau (2.600 €/m²)</option>
                <option value="reudnitz">Reudnitz (2.400 €/m²)</option>
                <option value="neustadt">Neustadt (2.300 €/m²)</option>
                <option value="volkmarsdorf">Volkmarsdorf (2.000 €/m²)</option>
                <option value="sellerhausen">Sellerhausen (1.900 €/m²)</option>
              </select>
              <svg class="select-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
          </div>

          <!-- Right: Exit-Strategie -->
          <div class="step2-col">
            <span class="field-label">Exit-Strategie</span>
            <div class="exit-cards">
              <button class="exit-card" data-value="flip" aria-label="Flip 6 bis 18 Monate">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
                <span class="exit-card__title">Flip</span>
                <span class="exit-card__sub">6–18 Monate</span>
              </button>
              <button class="exit-card" data-value="langfrist" aria-label="Langfrist 10 plus Jahre">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                <span class="exit-card__title">Langfrist</span>
                <span class="exit-card__sub">10+ Jahre</span>
              </button>
            </div>
            <p class="exit-hint">Langfrist = steuerfrei nach 10 Jahren Haltezeit</p>
          </div>

        </div>
        <div class="quiz-nav">
          <button class="btn btn-back" id="step2-back">← Zurück</button>
          <button class="btn btn-primary" id="step2-next">Weiter →</button>
        </div>
      </div>

      <!-- STEP 3: Zahlen -->
      <div class="quiz-step" id="step-3" hidden>
        <div class="quiz-step__header">
          <h2>Deine Zahlen</h2>
          <p class="quiz-step__hint">Ziehe die Regler — das Ergebnis wird live berechnet.</p>
        </div>
        <div class="sliders-wrap">

          <div class="slider-group">
            <div class="slider-label-row">
              <label class="field-label" for="slider-kaufpreis">Kaufpreis</label>
              <span class="slider-val" id="val-kaufpreis">80.000 €</span>
            </div>
            <input type="range" id="slider-kaufpreis" class="styled-slider" min="20000" max="300000" step="5000" value="80000" />
            <div class="slider-ends"><span>20.000 €</span><span>300.000 €</span></div>
          </div>

          <div class="slider-group">
            <div class="slider-label-row">
              <label class="field-label" for="slider-wohnflaeche">Wohnfläche</label>
              <span class="slider-val" id="val-wohnflaeche">60 m²</span>
            </div>
            <input type="range" id="slider-wohnflaeche" class="styled-slider" min="20" max="200" step="5" value="60" />
            <div class="slider-ends"><span>20 m²</span><span>200 m²</span></div>
          </div>

          <div class="slider-group">
            <div class="slider-label-row">
              <label class="field-label" for="slider-sanierung">Sanierungskosten</label>
              <span class="slider-val" id="val-sanierung">40.000 €</span>
            </div>
            <input type="range" id="slider-sanierung" class="styled-slider" min="5000" max="200000" step="5000" value="40000" />
            <div class="slider-ends"><span>5.000 €</span><span>200.000 €</span></div>
          </div>

          <div class="slider-group">
            <div class="slider-label-row">
              <label class="field-label" for="slider-eigenkapital">Eigenkapital-Anteil</label>
              <span class="slider-val" id="val-eigenkapital">30 %</span>
            </div>
            <input type="range" id="slider-eigenkapital" class="styled-slider" min="10" max="100" step="5" value="30" />
            <div class="slider-ends"><span>10 %</span><span>100 %</span></div>
          </div>

          <!-- Live preview -->
          <div class="nk-preview" id="nk-preview">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            <span>Nebenkosten: <strong id="nk-total">—</strong></span>
            <span class="nk-breakdown" id="nk-breakdown"></span>
          </div>

        </div>
        <div class="quiz-nav">
          <button class="btn btn-back" id="step3-back">← Zurück</button>
          <button class="btn btn-primary" id="step3-next">Ergebnis berechnen →</button>
        </div>
      </div>

      <!-- STEP 4: Ergebnis -->
      <div class="quiz-step" id="step-4" hidden>
        <div class="quiz-step__header">
          <h2>Dein Deal-Ergebnis</h2>
          <p class="quiz-step__hint">Gib deine E-Mail ein, um die vollständige Analyse freizuschalten.</p>
        </div>
        <div class="result-grid">

          <!-- Left: Dashboard (blurred initially) -->
          <div class="result-dashboard-wrap" id="result-dashboard-wrap">
            <div class="result-blur-overlay" id="result-blur-overlay">
              <div class="result-blur-overlay__inner">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <p>Ergebnis nach E-Mail sichtbar</p>
              </div>
            </div>
            <div class="result-dashboard" id="result-dashboard">

              <!-- Deal Score -->
              <div class="deal-score-wrap">
                <div class="deal-score-circle" id="deal-score-circle">
                  <span class="deal-score-letter" id="deal-score-letter">—</span>
                </div>
                <span class="deal-score-label" id="deal-score-label">Wird berechnet…</span>
              </div>

              <!-- Waterfall Bars -->
              <div class="waterfall">
                <div class="waterfall-row">
                  <span class="waterfall-label">Kaufpreis</span>
                  <div class="waterfall-bar-wrap">
                    <div class="waterfall-bar waterfall-bar--kp" id="wf-kp"></div>
                  </div>
                  <span class="waterfall-val" id="wf-val-kp">—</span>
                </div>
                <div class="waterfall-row">
                  <span class="waterfall-label">Nebenkosten</span>
                  <div class="waterfall-bar-wrap">
                    <div class="waterfall-bar waterfall-bar--nk" id="wf-nk"></div>
                  </div>
                  <span class="waterfall-val" id="wf-val-nk">—</span>
                </div>
                <div class="waterfall-row">
                  <span class="waterfall-label">Sanierungskosten</span>
                  <div class="waterfall-bar-wrap">
                    <div class="waterfall-bar waterfall-bar--san" id="wf-san"></div>
                  </div>
                  <span class="waterfall-val" id="wf-val-san">—</span>
                </div>
                <div class="waterfall-row waterfall-row--total">
                  <span class="waterfall-label">Gesamtinvestition</span>
                  <div class="waterfall-bar-wrap">
                    <div class="waterfall-bar waterfall-bar--total" id="wf-total"></div>
                  </div>
                  <span class="waterfall-val waterfall-val--bold" id="wf-val-total">—</span>
                </div>
                <div class="waterfall-row">
                  <span class="waterfall-label">Netto-Gewinn</span>
                  <div class="waterfall-bar-wrap">
                    <div class="waterfall-bar" id="wf-netto"></div>
                  </div>
                  <span class="waterfall-val waterfall-val--netto" id="wf-val-netto">—</span>
                </div>
              </div>

              <!-- Traffic Lights -->
              <div class="traffic-lights">
                <div class="tl-item">
                  <div class="tl-icon" id="tl-roi-icon"></div>
                  <div class="tl-text">
                    <span class="tl-label">ROI</span>
                    <span class="tl-val" id="tl-roi-val">—</span>
                  </div>
                </div>
                <div class="tl-item">
                  <div class="tl-icon" id="tl-regel70-icon"></div>
                  <div class="tl-text">
                    <span class="tl-label">70%-Regel</span>
                    <span class="tl-val" id="tl-regel70-val">—</span>
                  </div>
                </div>
                <div class="tl-item">
                  <div class="tl-icon" id="tl-speku-icon"></div>
                  <div class="tl-text">
                    <span class="tl-label">Spekulationssteuer</span>
                    <span class="tl-val" id="tl-speku-val">—</span>
                  </div>
                </div>
              </div>

            </div>
          </div>

          <!-- Right: Email Gate -->
          <div class="email-gate-card">
            <!-- PDF Mockup -->
            <div class="pdf-mockup" aria-hidden="true">
              <div class="pdf-mockup__inner">
                <div class="pdf-mockup__logo">WKDI</div>
                <div class="pdf-mockup__title">Deal-Analyse</div>
                <div class="pdf-mockup__sub">Leipzig · Persönlich erstellt</div>
                <div class="pdf-mockup__lines">
                  <div class="pdf-mockup__line" style="width:80%"></div>
                  <div class="pdf-mockup__line" style="width:60%"></div>
                  <div class="pdf-mockup__line" style="width:70%"></div>
                  <div class="pdf-mockup__line" style="width:45%"></div>
                </div>
              </div>
            </div>

            <!-- Form -->
            <form class="email-gate-form" id="email-gate-form" novalidate>
              <h3 class="email-gate-form__title">Analyse freischalten</h3>
              <div class="form-field">
                <label class="field-label" for="gate-vorname">Vorname</label>
                <input type="text" id="gate-vorname" name="vorname" placeholder="Max" required autocomplete="given-name" />
              </div>
              <div class="form-field">
                <label class="field-label" for="gate-email">E-Mail</label>
                <input type="email" id="gate-email" name="email" placeholder="max@beispiel.de" required autocomplete="email" />
              </div>
              <button type="submit" class="btn btn-primary email-gate-btn" id="email-gate-btn">
                Analyse jetzt erhalten →
              </button>
              <p class="email-gate-disclaimer">Kostenlos · Keine Weitergabe · Sofort per E-Mail</p>
              <p class="email-gate-error" id="email-gate-error" hidden></p>
            </form>
          </div>

        </div>
        <div class="quiz-nav quiz-nav--step4">
          <button class="btn btn-back" id="step4-back">← Zurück zu den Zahlen</button>
        </div>
      </div>

    </div>
  </section>

</Layout>

<style>
/* ─────────────────────────────
   HERO
───────────────────────────── */
.quiz-hero {
  position: relative;
  padding-top: var(--space-20);
  padding-bottom: var(--space-14);
  text-align: center;
  overflow: hidden;
  background: var(--color-bg-dark);
}

.quiz-hero__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.quiz-hero__bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.15;
}

.quiz-hero__inner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-4);
}

.quiz-hero__inner h1 {
  color: var(--color-text-on-dark);
  font-size: clamp(var(--text-3xl), 5vw, var(--text-4xl));
}

.quiz-hero__sub {
  font-size: var(--text-lg);
  color: var(--color-text-muted);
  max-width: 560px;
}

/* ─────────────────────────────
   PROGRESS
───────────────────────────── */
.quiz-progress-wrap {
  background: var(--color-bg-dark);
  border-bottom: 1px solid var(--color-border);
  padding-block: var(--space-4);
  position: sticky;
  top: 0;
  z-index: 50;
}

.quiz-progress {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
}

.quiz-step-dot {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-1);
  background: none;
  border: none;
  cursor: pointer;
  padding: var(--space-1) var(--space-2);
  opacity: 0.4;
  transition: opacity 0.2s;
}

.quiz-step-dot.is-active {
  opacity: 1;
}

.quiz-step-dot.is-done {
  opacity: 0.7;
}

.quiz-step-dot__num {
  width: 32px;
  height: 32px;
  border-radius: var(--radius-full);
  border: 2px solid var(--color-border-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--text-sm);
  font-weight: var(--weight-bold);
  color: var(--color-text-muted);
  transition: background 0.2s, border-color 0.2s, color 0.2s;
}

.quiz-step-dot.is-active .quiz-step-dot__num {
  background: var(--color-accent);
  border-color: var(--color-accent);
  color: #fff;
}

.quiz-step-dot.is-done .quiz-step-dot__num {
  background: rgba(37,99,235,0.15);
  border-color: var(--color-accent);
  color: var(--color-accent);
}

.quiz-step-dot__label {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  white-space: nowrap;
}

.quiz-step-dot.is-active .quiz-step-dot__label {
  color: var(--color-text);
}

.quiz-step-connector {
  flex: 1;
  max-width: 60px;
  height: 1px;
  background: var(--color-border);
  margin-bottom: 18px;
}

/* ─────────────────────────────
   QUIZ SECTION + STEPS
───────────────────────────── */
.quiz-section {
  padding-block: var(--space-12) var(--space-20);
}

.quiz-step__header {
  text-align: center;
  margin-bottom: var(--space-10);
}

.quiz-step__header h2 {
  font-size: clamp(var(--text-2xl), 3vw, var(--text-3xl));
  margin-bottom: var(--space-2);
}

.quiz-step__hint {
  color: var(--color-text-mid);
  font-size: var(--text-base);
}

/* ─────────────────────────────
   STEP 1 — SCENARIO CARDS
───────────────────────────── */
.scenario-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: var(--space-4);
  max-width: 900px;
  margin: 0 auto;
}

.scenario-card {
  position: relative;
  aspect-ratio: 3 / 2;
  border-radius: var(--radius-xl);
  overflow: hidden;
  cursor: pointer;
  background: rgba(15, 23, 42, 0.95);
  border: 2px solid var(--color-border);
  transition: border-color 0.25s, box-shadow 0.25s, transform 0.2s;
  text-align: center;
}

.scenario-card:hover {
  transform: translateY(-2px);
  border-color: rgba(37, 99, 235, 0.5);
  box-shadow:
    0 4px 16px rgba(37, 99, 235, 0.15),
    0 8px 32px rgba(15, 23, 42, 0.3);
}

.scenario-card.selected {
  border-color: var(--color-accent);
  box-shadow:
    0 0 0 3px rgba(37, 99, 235, 0.2),
    0 8px 32px rgba(37, 99, 235, 0.25),
    0 16px 48px rgba(15, 23, 42, 0.3);
}

.scenario-card__bg {
  position: absolute;
  inset: 0;
  background-size: cover;
