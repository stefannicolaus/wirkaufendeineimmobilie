---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="ROI-Rechner — Deal-Analyse in 4 Schritten | wirkaufendeineimmobilie.de"
  description="Berechne Rendite, Förderung und Gewinn für dein nächstes Sanierungsobjekt in Leipzig — mit echten Marktdaten. Kostenlos, sofort per E-Mail."
>

  <!-- HERO -->
  <section class="quiz-hero">
    <div class="quiz-hero__bg" aria-hidden="true">
      <img src="/images/wkdi-roi-quiz-hero.webp" alt="" />
    </div>
    <div class="container quiz-hero__inner">
      <p class="quiz-hero__tag">Für Eigentümer mit schwierigen Immobilien</p>
      <h1>Was bekommst du für deine Immobilie — trotz des Zustands?</h1>
      <p class="quiz-hero__sub">Messie-Wohnung, Erbschaft im Streit, Energetische Sanierungspflicht (gemäß GEG), Zwangslage — kein Problem. Gib 3 Zahlen ein und sieh sofort, was beim Verkauf realistisch für dich rausspringt.</p>
    </div>
  </section>

  <!-- PROGRESS -->
  <div class="quiz-progress-wrap" id="quiz-progress">
    <div class="container">
      <div class="quiz-progress">
        <button class="quiz-step-dot" data-step="1" aria-label="Schritt 1: Objekt-Typ">
          <span class="quiz-step-dot__num">1</span>
          <span class="quiz-step-dot__label">Objekt-Typ</span>
        </button>
        <div class="quiz-step-connector"></div>
        <button class="quiz-step-dot" data-step="2" aria-label="Schritt 2: Lage & Strategie">
          <span class="quiz-step-dot__num">2</span>
          <span class="quiz-step-dot__label">Lage &amp; Strategie</span>
        </button>
        <div class="quiz-step-connector"></div>
        <button class="quiz-step-dot" data-step="3" aria-label="Schritt 3: Zahlen">
          <span class="quiz-step-dot__num">3</span>
          <span class="quiz-step-dot__label">Zahlen</span>
        </button>
        <div class="quiz-step-connector"></div>
        <button class="quiz-step-dot" data-step="4" aria-label="Schritt 4: Ergebnis">
          <span class="quiz-step-dot__num">4</span>
          <span class="quiz-step-dot__label">Ergebnis</span>
        </button>
      </div>
    </div>
  </div>

  <!-- QUIZ WRAPPER -->
  <section class="quiz-section">
    <div class="container">

      <!-- STEP 1: Objekt-Typ -->
      <div class="quiz-step" id="step-1">
        <div class="quiz-step__header">
          <h2>Welchen Objekt-Typ willst du kalkulieren?</h2>
          <p class="quiz-step__hint">Wähle das passende Szenario — beeinflusst BEG-Förderung und Deal Score.</p>
        </div>
        <div class="scenario-grid">

          <button class="scenario-card" data-value="messie" aria-label="Messie / Verwahrlost">
            <div class="scenario-card__bg" style="background-image: url('/images/wkdi-szenario-messie.jpg')"></div>
            <div class="scenario-card__glow"></div>
            <div class="scenario-card__content">
              <div class="scenario-card__top">
                <svg class="scenario-card__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                <h3>Messie / Verwahrlost</h3>
              </div>
              <p class="scenario-card__desc">Der Rechner kalkuliert den realistischen Kaufpreisabschlag durch den Zustand und zeigt, welchen Erlös du trotzdem erzielen kannst.</p>
              <span class="scenario-card__benefit">Erlös trotz Problemzustand sichtbar machen</span>
            </div>
          </button>

          <button class="scenario-card" data-value="erbengemeinschaft" aria-label="Erbengemeinschaft">
            <div class="scenario-card__bg" style="background-image: url('/images/wkdi-szenario-erbengemeinschaft.jpg')"></div>
            <div class="scenario-card__glow"></div>
            <div class="scenario-card__content">
              <div class="scenario-card__top">
                <svg class="scenario-card__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <h3>Erbengemeinschaft</h3>
              </div>
              <p class="scenario-card__desc">Der Rechner liefert einen objektiven Marktwert — unabhängig von Erben-Emotionen. Zahlen statt Streit als Grundlage für die Einigung.</p>
              <span class="scenario-card__benefit">Neutrale Zahl für alle Beteiligten</span>
            </div>
          </button>

          <button class="scenario-card" data-value="geg" aria-label="Energetischer Sanierungsbedarf (gemäß GEG)">
            <div class="scenario-card__bg" style="background-image: url('/images/wkdi-szenario-geg.jpg')"></div>
            <div class="scenario-card__glow"></div>
            <div class="scenario-card__content">
              <div class="scenario-card__top">
                <svg class="scenario-card__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                <h3>Energetische Sanierung (gemäß GEG)</h3>
              </div>
              <p class="scenario-card__desc">Der Rechner zieht die 40 % BEG-Förderung automatisch in die Kalkulation ein und zeigt, was für Käufer nach Förderung noch übrig bleibt.</p>
              <span class="scenario-card__benefit badge-beg">40 % BEG-Förderung fließt in den Deal Score</span>
            </div>
          </button>

          <button class="scenario-card" data-value="insolvenz" aria-label="Insolvenz / Zwangslage">
            <div class="scenario-card__bg" style="background-image: url('/images/wkdi-szenario-insolvenz.jpg')"></div>
            <div class="scenario-card__glow"></div>
            <div class="scenario-card__content">
              <div class="scenario-card__top">
                <svg class="scenario-card__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <h3>Insolvenz / Zwangslage</h3>
              </div>
              <p class="scenario-card__desc">Der Rechner stellt Zwangsversteigerungswert und diskret vermittelten Verkaufspreis gegenüber — damit du siehst, wie viel du durch uns mehr holst.</p>
              <span class="scenario-card__benefit">Vergleich: Zwangsversteigerung vs. diskreter Verkauf</span>
            </div>
          </button>

          <button class="scenario-card" data-value="standard" aria-label="Kapitalanlage">
            <div class="scenario-card__bg" style="background-image: url('/images/wkdi-szenario-kapitalanleger.jpg')"></div>
            <div class="scenario-card__glow"></div>
            <div class="scenario-card__content">
              <div class="scenario-card__top">
                <svg class="scenario-card__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                <h3>Kapitalanlage mit Renovierungsdruck</h3>
              </div>
              <p class="scenario-card__desc">Fix &amp; Flip oder Halten? Der Rechner vergleicht beide Exit-Strategien mit echten Sanierungskosten und Marktpreisen — Entscheidung auf Zahlenbasis.</p>
              <span class="scenario-card__benefit">Fix &amp; Flip vs. Halten — direkt vergleichbar</span>
            </div>
          </button>

        </div>
      </div>

      <!-- STEP 2: Lage & Strategie -->
      <div class="quiz-step" id="step-2" hidden>
        <div class="quiz-step__header">
          <h2>Lage &amp; Exit-Strategie</h2>
          <p class="quiz-step__hint">Der Stadtteil bestimmt den Verkaufspreis, die Strategie die Steuer.</p>
        </div>
        <div class="step2-grid">

          <!-- Left: Stadtteil -->
          <div class="step2-col">
            <label class="field-label" for="stadtteil-select">Stadtteil</label>
            <div class="select-wrap">
              <select id="stadtteil-select" class="styled-select">
                <optgroup label="Mitte">
                  <option value="zentrum">Zentrum (3.900 €/m²)</option>
                  <option value="zentrum-ost">Zentrum-Ost (3.400 €/m²)</option>
                  <option value="zentrum-suedost">Zentrum-Südost (3.200 €/m²)</option>
                  <option value="zentrum-sued">Zentrum-Süd (3.300 €/m²)</option>
                  <option value="zentrum-west">Zentrum-West (3.500 €/m²)</option>
                  <option value="zentrum-nordwest">Zentrum-Nordwest (3.200 €/m²)</option>
                  <option value="zentrum-nord">Zentrum-Nord (3.000 €/m²)</option>
                </optgroup>
                <optgroup label="Nord">
                  <option value="gohlis-sued">Gohlis-Süd (2.700 €/m²)</option>
                  <option value="gohlis-mitte">Gohlis-Mitte (2.400 €/m²)</option>
                  <option value="gohlis-nord">Gohlis-Nord (2.100 €/m²)</option>
                  <option value="eutritzsch">⚠ Eutritzsch — MS (2.050 €/m²)</option>
                  <option value="seehausen">Seehausen (1.650 €/m²)</option>
                  <option value="wiederitzsch">Wiederitzsch (1.850 €/m²)</option>
                </optgroup>
                <optgroup label="Nordost">
                  <option value="schoenefeld-abtnaundorf">⚠ Schönefeld-Abtnaundorf — MS (2.050 €/m²)</option>
                  <option value="schoenefeld-ost">Schönefeld-Ost (1.950 €/m²)</option>
                  <option value="mockau-sued">Mockau-Süd (2.050 €/m²)</option>
                  <option value="mockau-nord">Mockau-Nord (1.850 €/m²)</option>
                  <option value="thekla">Thekla (1.700 €/m²)</option>
                  <option value="plaussig-portitz">Plaußig-Portitz (1.550 €/m²)</option>
                </optgroup>
                <optgroup label="Ost">
                  <option value="neustadt-neuschoenef" selected>⚠ Neustadt-Neuschönefeld — MS (2.050 €/m²)</option>
                  <option value="volkmarsdorf">⚠ Volkmarsdorf — MS (1.900 €/m²)</option>
                  <option value="anger-crottendorf">Anger-Crottendorf (1.950 €/m²)</option>
                  <option value="sellerhausen-stuenz">Sellerhausen-Stünz (1.750 €/m²)</option>
                  <option value="paunsdorf">Paunsdorf (1.650 €/m²)</option>
                  <option value="heiterblick">Heiterblick (1.850 €/m²)</option>
                  <option value="moelkau">Mölkau (1.950 €/m²)</option>
                  <option value="engelsdorf">Engelsdorf (1.850 €/m²)</option>
                  <option value="baalsdorf">Baalsdorf (1.700 €/m²)</option>
                  <option value="althen-kleinpoesna">Althen-Kleinpösna (1.600 €/m²)</option>
                </optgroup>
                <optgroup label="Südost">
                  <option value="reudnitz-thonberg">⚠ Reudnitz-Thonberg — MS (2.350 €/m²)</option>
                  <option value="stoetteritz">Stötteritz (2.200 €/m²)</option>
                  <option value="probstheida">Probstheida (1.950 €/m²)</option>
                  <option value="meusdorf">Meusdorf (1.800 €/m²)</option>
                  <option value="liebertwolkwitz">Liebertwolkwitz (1.700 €/m²)</option>
                  <option value="holzhausen">Holzhausen (1.600 €/m²)</option>
                </optgroup>
                <optgroup label="Süd">
                  <option value="suedvorstadt">Südvorstadt (3.100 €/m²)</option>
                  <option value="connewitz">⚠ Connewitz — MS (2.900 €/m²)</option>
                  <option value="marienbrunn">Marienbrunn (2.200 €/m²)</option>
                  <option value="loessnig">Lößnig (1.950 €/m²)</option>
                  <option value="doelitz-doesen">Dölitz-Dösen (1.850 €/m²)</option>
                </optgroup>
                <optgroup label="Südwest">
                  <option value="schleussig">Schleußig (3.300 €/m²)</option>
                  <option value="plagwitz">⚠ Plagwitz — MS (2.900 €/m²)</option>
                  <option value="kleinzschocher">⚠ Kleinzschocher — MS (1.950 €/m²)</option>
                  <option value="grosszschocher">Großzschocher (1.800 €/m²)</option>
                  <option value="knautnaundorf">Knautnaundorf (1.550 €/m²)</option>
                  <option value="knauthain">Knauthain-Knautkleeberg (1.650 €/m²)</option>
                </optgroup>
                <optgroup label="West">
                  <option value="schoenau">Schönau (1.500 €/m²)</option>
                  <option value="gruenau-ost">Grünau-Ost (1.400 €/m²)</option>
                  <option value="gruenau-nord">Grünau-Nord (1.300 €/m²)</option>
                  <option value="gruenau-mitte">Grünau-Mitte (1.400 €/m²)</option>
                  <option value="gruenau-siedlung">Grünau-Siedlung (1.300 €/m²)</option>
                  <option value="lausen-gruenau">Lausen-Grünau (1.500 €/m²)</option>
                  <option value="miltitz">Miltitz (1.600 €/m²)</option>
                </optgroup>
                <optgroup label="Alt-West">
                  <option value="lindenau">⚠ Lindenau — MS (2.500 €/m²)</option>
                  <option value="alt-lindenau">⚠ Alt-Lindenau — MS (2.300 €/m²)</option>
                  <option value="neu-lindenau">Neu-Lindenau (2.100 €/m²)</option>
                  <option value="leutzsch">⚠ Leutzsch — MS (2.400 €/m²)</option>
                  <option value="boehlitz-ehrenberg">Böhlitz-Ehrenberg (2.000 €/m²)</option>
                  <option value="burghausen">Burghausen-Rückmarsdorf (1.750 €/m²)</option>
                </optgroup>
                <optgroup label="Nordwest">
                  <option value="moeckern">Möckern (2.200 €/m²)</option>
                  <option value="wahren">Wahren (2.000 €/m²)</option>
                  <option value="luetzschena">Lützschena-Stahmeln (1.750 €/m²)</option>
                  <option value="lindenthal">Lindenthal (1.850 €/m²)</option>
                </optgroup>
              </select>
              <svg class="select-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
            <div id="milieuschutz-warning" class="ms-warning" hidden>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              <div>
                <strong>Milieuschutz-Gebiet</strong>
                <p>Umwandlung Miete → ETW und Luxussanierung eingeschränkt. Aufteiler-Strategie vorab mit Anwalt prüfen.</p>
              </div>
            </div>
          </div>

          <!-- Right: Exit-Strategie -->
          <div class="step2-col">
            <span class="field-label">Exit-Strategie</span>
            <div class="exit-cards">
              <button class="exit-card" data-value="flip" aria-label="Flip 6 bis 18 Monate">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
                <span class="exit-card__title">Flip</span>
                <span class="exit-card__sub">6–18 Monate</span>
              </button>
              <button class="exit-card" data-value="langfrist" aria-label="Langfrist 10 plus Jahre">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                <span class="exit-card__title">Langfrist</span>
                <span class="exit-card__sub">10+ Jahre</span>
              </button>
            </div>
            <p class="exit-hint">Langfrist = steuerfrei nach 10 Jahren Haltezeit</p>
          </div>

        </div>
        <div class="quiz-nav">
          <button class="btn btn-back" id="step2-back">← Zurück</button>
          <button class="btn btn-primary" id="step2-next">Weiter →</button>
        </div>
      </div>

      <!-- STEP 3: Zahlen -->
      <div class="quiz-step" id="step-3" hidden>
        <div class="quiz-step__header">
          <h2>Deine Zahlen</h2>
          <p class="quiz-step__hint">Gib deine Zahlen ein und klicke auf „Ergebnis berechnen".</p>
        </div>
        <div class="sliders-wrap">

          <div class="slider-group">
            <div class="slider-label-row">
              <label class="field-label" for="slider-kaufpreis">Kaufpreis</label>
              <span class="slider-val" id="val-kaufpreis">80.000 €</span>
            </div>
            <input type="range" id="slider-kaufpreis" class="styled-slider" min="20000" max="300000" step="5000" value="80000" />
            <div class="slider-ends"><span>20.000 €</span><span>300.000 €</span></div>
          </div>

          <div class="slider-group">
            <div class="slider-label-row">
              <label class="field-label" for="slider-wohnflaeche">Wohnfläche</label>
              <span class="slider-val" id="val-wohnflaeche">60 m²</span>
            </div>
            <input type="range" id="slider-wohnflaeche" class="styled-slider" min="20" max="200" step="5" value="60" />
            <div class="slider-ends"><span>20 m²</span><span>200 m²</span></div>
          </div>

          <div class="slider-group">
            <div class="slider-label-row">
              <label class="field-label" for="slider-sanierung">Sanierungskosten</label>
              <span class="slider-val" id="val-sanierung">40.000 €</span>
            </div>
            <input type="range" id="slider-sanierung" class="styled-slider" min="5000" max="200000" step="5000" value="40000" />
            <div class="slider-ends"><span>5.000 €</span><span>200.000 €</span></div>
          </div>

          <div class="slider-group">
            <div class="slider-label-row">
              <label class="field-label" for="slider-eigenkapital">Eigenkapital-Anteil</label>
              <span class="slider-val" id="val-eigenkapital">30 %</span>
            </div>
            <input type="range" id="slider-eigenkapital" class="styled-slider" min="10" max="100" step="5" value="30" />
            <div class="slider-ends"><span>10 %</span><span>100 %</span></div>
          </div>

          <!-- Live preview -->
          <div class="nk-preview" id="nk-preview">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            <span>Nebenkosten: <strong id="nk-total">—</strong></span>
            <span class="nk-breakdown" id="nk-breakdown"></span>
          </div>

        </div>
        <div class="quiz-nav">
          <button class="btn btn-back" id="step3-back">← Zurück</button>
          <button class="btn btn-primary" id="step3-next">Ergebnis berechnen →</button>
        </div>
      </div>

      <!-- CALC OVERLAY: 10s progress between step 3 and step 4 -->
      <div id="calc-overlay" hidden>
        <div class="calc-overlay__inner">
          <div class="calc-overlay__icon" aria-hidden="true">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
          </div>
          <h3 class="calc-overlay__title">Dein Deal wird analysiert…</h3>
          <div class="calc-progress-track">
            <div class="calc-progress-fill" id="calc-progress-fill"></div>
          </div>
          <p class="calc-progress-pct" id="calc-progress-pct">0 %</p>
          <ul class="calc-steps-list" id="calc-steps-list">
            <li class="calc-step-item" data-at="0">Marktwerte Leipzig werden geladen…</li>
            <li class="calc-step-item" data-at="25">Sanierungskosten werden bewertet…</li>
            <li class="calc-step-item" data-at="55">Deal Score wird berechnet…</li>
            <li class="calc-step-item" data-at="82">PDF-Bericht wird vorbereitet…</li>
          </ul>
        </div>
      </div>

      <!-- STEP 4: Ergebnis -->
      <div class="quiz-step" id="step-4" hidden>
        <div class="quiz-step__header">
          <h2>Dein Deal-Ergebnis</h2>
          <p class="quiz-step__hint">Gib deine E-Mail ein, und wir senden dir umgehend die vollständige Analyse zu.</p>
        </div>
        <div class="result-grid">

          <!-- Left column: Dashboard + Joachim bubble -->
          <div class="result-left-col">
          <div class="result-dashboard-wrap" id="result-dashboard-wrap">
            <div class="result-blur-overlay" id="result-blur-overlay">
              <div class="result-blur-overlay__inner">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <p>Ergebnis nach E-Mail sichtbar</p>
              </div>
            </div>
            <div class="result-dashboard" id="result-dashboard">

              <!-- Deal Score -->
              <div class="deal-score-wrap">
                <div class="deal-score-circle" id="deal-score-circle">
                  <span class="deal-score-letter" id="deal-score-letter">—</span>
                </div>
                <span class="deal-score-label" id="deal-score-label">Wird berechnet…</span>
              </div>

              <!-- Waterfall Bars -->
