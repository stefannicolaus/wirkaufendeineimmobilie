<script>
// ─────────────────────────────────────────
//  STATE
// ─────────────────────────────────────────
interface QuizState {
  objekt_typ: string;
  stadtteil: string;
  kaufpreis: number;
  wohnflaeche: number;
  sanierungskosten: number;
  exit_strategie: string;
  eigenkapital_pct: number;
}

const state: QuizState = {
  objekt_typ: '',
  stadtteil: 'neustadt-neuschoenef',
  kaufpreis: 80000,
  wohnflaeche: 60,
  sanierungskosten: 40000,
  exit_strategie: '',
  eigenkapital_pct: 30,
};

let currentStep = 1;

// ─────────────────────────────────────────
//  CALC
// ─────────────────────────────────────────
const MARKT: Record<string, number> = {
  // Mitte (Homeday ~2.650 €/m²)
  'zentrum': 3900, 'zentrum-ost': 3400, 'zentrum-suedost': 3200,
  'zentrum-sued': 3300, 'zentrum-west': 3500, 'zentrum-nordwest': 3200, 'zentrum-nord': 3000,
  // Nord (Homeday ~2.150 €/m²)
  'gohlis-sued': 2700, 'gohlis-mitte': 2400, 'gohlis-nord': 2100,
  'eutritzsch': 2050, 'seehausen': 1650, 'wiederitzsch': 1850,
  // Nordost (Homeday ~2.250 €/m²)
  'schoenefeld-abtnaundorf': 2050, 'schoenefeld-ost': 1950,
  'mockau-sued': 2050, 'mockau-nord': 1850, 'thekla': 1700, 'plaussig-portitz': 1550,
  // Ost (Homeday ~1.900 €/m²)
  'neustadt-neuschoenef': 2050, 'volkmarsdorf': 1900, 'anger-crottendorf': 1950,
  'sellerhausen-stuenz': 1750, 'paunsdorf': 1650, 'heiterblick': 1850,
  'moelkau': 1950, 'engelsdorf': 1850, 'baalsdorf': 1700, 'althen-kleinpoesna': 1600,
  // Südost (Homeday ~1.950 €/m²)
  'reudnitz-thonberg': 2350, 'stoetteritz': 2200, 'probstheida': 1950,
  'meusdorf': 1800, 'liebertwolkwitz': 1700, 'holzhausen': 1600,
  // Süd (Homeday ~2.350 €/m²)
  'suedvorstadt': 3100, 'connewitz': 2900, 'marienbrunn': 2200,
  'loessnig': 1950, 'doelitz-doesen': 1850,
  // Südwest (Homeday ~1.850 €/m²)
  'schleussig': 3300, 'plagwitz': 2900, 'kleinzschocher': 1950,
  'grosszschocher': 1800, 'knautnaundorf': 1550, 'knauthain': 1650,
  // West (Homeday ~1.350 €/m²)
  'schoenau': 1500, 'gruenau-ost': 1400, 'gruenau-nord': 1300,
  'gruenau-mitte': 1400, 'gruenau-siedlung': 1300, 'lausen-gruenau': 1500, 'miltitz': 1600,
  // Alt-West (Homeday ~1.850 €/m²)
  'lindenau': 2500, 'alt-lindenau': 2300, 'neu-lindenau': 2100,
  'leutzsch': 2400, 'boehlitz-ehrenberg': 2000, 'burghausen': 1750,
  // Nordwest (Homeday ~1.900 €/m²)
  'moeckern': 2200, 'wahren': 2000, 'luetzschena': 1750, 'lindenthal': 1850,
};

function calcResult(s: QuizState) {
  const kp = s.kaufpreis, san = s.sanierungskosten, m2 = s.wohnflaeche;
  const grunderwerb = kp * 0.035, notar = kp * 0.02, prov_kauf = kp * 0.0238;
  const nk = grunderwerb + notar + prov_kauf;
  const beg = s.objekt_typ === 'geg' ? san * 0.40 : 0;
  const san_netto = san - beg;
  const gesamt = kp + nk + san_netto;
  const qm_preis = MARKT[s.stadtteil] ?? 2400;
  const vp = m2 * qm_preis;
  const prov_vk = vp * 0.0357;
  const brutto = vp - gesamt;
  const netto = brutto - prov_vk;
  const roi = gesamt > 0 ? (netto / gesamt * 100) : 0;
  const regel70 = kp <= (vp * 0.70 - san);
  const speku = s.exit_strategie === 'langfrist';
  let score: 'A' | 'B' | 'C' | 'D' = roi >= 20 && regel70 ? 'A' : roi >= 12 ? 'B' : roi >= 5 ? 'C' : 'D';
  const labelMap: Record<string, string> = { A: 'Sehr guter Deal', B: 'Solides Potential', C: 'Grenzwertig', D: 'Überdenken' };
  const label = labelMap[score];
  return { kp, san, m2, grunderwerb, notar, prov_kauf, nk, beg, san_netto, gesamt, qm_preis, vp, prov_vk, brutto, netto, roi, regel70, speku, score, label };
}

// ─────────────────────────────────────────
//  FORMATTERS
// ─────────────────────────────────────────
const fmtEur = (n: number) => n.toLocaleString('de-DE', { maximumFractionDigits: 0 }) + ' €';
const fmtPct = (n: number) => n.toFixed(1) + ' %';

// ─────────────────────────────────────────
//  PROGRESS INDICATOR
// ─────────────────────────────────────────
function updateProgress(step: number) {
  document.querySelectorAll<HTMLElement>('.quiz-step-dot').forEach((dot) => {
    const dotStep = Number(dot.dataset.step);
    dot.classList.remove('is-active', 'is-done');
    if (dotStep === step) dot.classList.add('is-active');
    else if (dotStep < step) dot.classList.add('is-done');
  });
}

// ─────────────────────────────────────────
//  STEP NAVIGATION
// ─────────────────────────────────────────
function showStep(n: number) {
  [1, 2, 3, 4].forEach((s) => {
    const el = document.getElementById(`step-${s}`);
    if (el) el.hidden = s !== n;
  });
  currentStep = n;
  updateProgress(n);
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

// ─────────────────────────────────────────
//  STEP 1 — SCENARIO CARDS
// ─────────────────────────────────────────
document.querySelectorAll<HTMLElement>('.scenario-card').forEach((card) => {
  // Mouse tracking glow
  card.addEventListener('mousemove', (e) => {
    const rect = card.getBoundingClientRect();
    card.style.setProperty('--mouse-x', (e.clientX - rect.left) + 'px');
    card.style.setProperty('--mouse-y', (e.clientY - rect.top) + 'px');
  });

  card.addEventListener('click', () => {
    document.querySelectorAll('.scenario-card').forEach((c) => c.classList.remove('selected'));
    card.classList.add('selected');
    state.objekt_typ = card.dataset.value ?? '';
    setTimeout(() => showStep(2), 300);
  });
});

// ─────────────────────────────────────────
//  STEP 2 — LAGE & STRATEGIE
// ─────────────────────────────────────────
// Soziale Erhaltungssatzungen (Milieuschutz) Leipzig — Stand 02/2025
// Quelle: Stadt Leipzig, https://www.leipzig.de/bauen-und-wohnen/stadterneuerung-in-leipzig/soziale-erhaltungssatzungen/die-gebiete
// Gebiete: Alt-Lindenau (2020), Lindenau (2020), Am Lene-Voigt-Park / Reudnitz-Thonberg+Anger-Crottendorf (2020),
//          Eisenbahnstraße / Neustadt-Neuschönefeld+Volkmarsdorf+Sellerhausen-Stünz (2020),
//          Connewitz (2020), Eutritzsch (2020), Plagwitz/Kleinzschocher (2022), Leutzsch (2022),
//          Schönefeld westlicher Bereich (02/2025)
const MS_DISTRICTS = new Set([
  'eutritzsch',
  'neustadt-neuschoenef', 'volkmarsdorf', 'sellerhausen-stuenz',
  'reudnitz-thonberg', 'anger-crottendorf',
  'connewitz',
  'plagwitz', 'kleinzschocher',
  'lindenau', 'alt-lindenau',
  'leutzsch',
  'schoenefeld-abtnaundorf',
]);

const stadtteilSelect = document.getElementById('stadtteil-select') as HTMLSelectElement;
const msWarning = document.getElementById('milieuschutz-warning') as HTMLElement;

function updateMsWarning(val: string) {
  if (msWarning) msWarning.hidden = !MS_DISTRICTS.has(val);
}

stadtteilSelect?.addEventListener('change', () => {
  state.stadtteil = stadtteilSelect.value;
  updateMsWarning(stadtteilSelect.value);
});

// Check initial value
updateMsWarning(stadtteilSelect?.value ?? '');

document.querySelectorAll<HTMLElement>('.exit-card').forEach((card) => {
  card.addEventListener('click', () => {
    document.querySelectorAll('.exit-card').forEach((c) => c.classList.remove('selected'));
    card.classList.add('selected');
    state.exit_strategie = card.dataset.value ?? '';
  });
});

document.getElementById('step2-back')?.addEventListener('click', () => showStep(1));

document.getElementById('step2-next')?.addEventListener('click', () => {
  if (!state.exit_strategie) {
    // Auto-select flip if nothing chosen
    const flipCard = document.querySelector('.exit-card[data-value="flip"]') as HTMLElement;
    flipCard?.classList.add('selected');
    state.exit_strategie = 'flip';
  }
  state.stadtteil = stadtteilSelect?.value ?? 'lindenau';
  showStep(3);
});

// ─────────────────────────────────────────
//  STEP 3 — SLIDERS
// ─────────────────────────────────────────
function calcPreview() {
  const kp = state.kaufpreis;
  const grunderwerb = kp * 0.035;
  const notar = kp * 0.02;
  const prov = kp * 0.0238;
  const total = grunderwerb + notar + prov;
  const el = document.getElementById('nk-total');
  if (el) el.textContent = fmtEur(total);
  const breakdown = document.getElementById('nk-breakdown');
  if (breakdown) {
    breakdown.textContent = `Grunderwerb ${fmtEur(grunderwerb)} · Notar ${fmtEur(notar)} · Provision ${fmtEur(prov)}`;
  }
}

function bindSlider(id: string, valId: string, key: keyof QuizState, formatter: (n: number) => string) {
  const slider = document.getElementById(id) as HTMLInputElement;
  const display = document.getElementById(valId);
  if (!slider || !display) return;
  slider.addEventListener('input', () => {
    const v = Number(slider.value);
    (state as any)[key] = v;
    display.textContent = formatter(v);
    calcPreview();
  });
}

bindSlider('slider-kaufpreis', 'val-kaufpreis', 'kaufpreis', (n) => n.toLocaleString('de-DE') + ' €');
bindSlider('slider-wohnflaeche', 'val-wohnflaeche', 'wohnflaeche', (n) => n + ' m²');
bindSlider('slider-sanierung', 'val-sanierung', 'sanierungskosten', (n) => n.toLocaleString('de-DE') + ' €');
bindSlider('slider-eigenkapital', 'val-eigenkapital', 'eigenkapital_pct', (n) => n + ' %');

document.getElementById('step3-back')?.addEventListener('click', () => showStep(2));

document.getElementById('step3-next')?.addEventListener('click', () => {
  showCalcOverlay(() => {
    showStep(4);
    renderResult();
  });
});

function showCalcOverlay(onComplete: () => void) {
  const overlay = document.getElementById('calc-overlay') as HTMLElement | null;
  if (!overlay) { onComplete(); return; }

  // Hide all steps, show overlay
  [1, 2, 3, 4].forEach((s) => {
    const el = document.getElementById(`step-${s}`);
    if (el) el.hidden = true;
  });
  overlay.hidden = false;
  // Scroll to quiz section top so overlay is in view
  const quizSection = document.querySelector('.quiz-section') as HTMLElement | null;
  if (quizSection) {
    quizSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  const fill = document.getElementById('calc-progress-fill') as HTMLElement | null;
  const pctEl = document.getElementById('calc-progress-pct') as HTMLElement | null;
  const items = overlay.querySelectorAll<HTMLElement>('.calc-step-item');

  const DURATION = 10_000;
  const start = performance.now();

  function tick(now: number) {
    const pct = Math.min(100, ((now - start) / DURATION) * 100);
    if (fill) fill.style.width = pct.toFixed(1) + '%';
    if (pctEl) pctEl.textContent = Math.floor(pct) + ' %';
    items.forEach((item) => {
      if (pct >= Number(item.dataset.at)) item.classList.add('is-active');
    });
    if (pct < 100) {
      requestAnimationFrame(tick);
    } else {
      overlay.hidden = true;
      onComplete();
    }
  }
  requestAnimationFrame(tick);
}

// ─────────────────────────────────────────
//  STEP 4 — RENDER RESULT
// ─────────────────────────────────────────
function renderResult() {
  const r = calcResult(state);

  // Deal Score
  const circle = document.getElementById('deal-score-circle');
  const letter = document.getElementById('deal-score-letter');
  const scoreLabel = document.getElementById('deal-score-label');
  if (circle && letter && scoreLabel) {
    circle.className = 'deal-score-circle score-' + r.score;
    letter.textContent = r.score;
    scoreLabel.textContent = r.label;
  }

  // Waterfall bars — normalize to percentage of gesamt (max)
  const maxVal = Math.max(r.gesamt, r.vp) || 1;
  function setBar(barId: string, valId: string, val: number, color?: string) {
    const bar = document.getElementById(barId) as HTMLElement;
    const valEl = document.getElementById(valId);
    if (bar) {
      bar.style.width = Math.max(2, (Math.abs(val) / maxVal) * 100) + '%';
      if (color) bar.style.background = color;
    }
    if (valEl) valEl.textContent = fmtEur(val);
  }

  setBar('wf-kp', 'wf-val-kp', r.kp);
  setBar('wf-nk', 'wf-val-nk', r.nk);
  setBar('wf-san', 'wf-val-san', r.san_netto);
  setBar('wf-total', 'wf-val-total', r.gesamt);

  const nettoBar = document.getElementById('wf-netto');
  const nettoVal = document.getElementById('wf-val-netto');
  if (nettoBar) {
    nettoBar.style.width = Math.max(2, (Math.abs(r.netto) / maxVal) * 100) + '%';
    nettoBar.style.background = r.netto >= 0 ? '#16a34a' : '#dc2626';
  }
  if (nettoVal) {
    nettoVal.textContent = fmtEur(r.netto);
    nettoVal.style.color = r.netto >= 0 ? '#4ade80' : '#f87171';
  }

  // Traffic Lights
  function setTL(iconId: string, valId: string, level: 'green' | 'amber' | 'red', text: string) {
    const icon = document.getElementById(iconId);
    const val = document.getElementById(valId);
    if (icon) {
      icon.className = 'tl-icon ' + level;
      icon.textContent = level === 'green' ? '✓' : level === 'amber' ? '!' : '✗';
    }
    if (val) val.textContent = text;
  }

  const roiLevel = r.roi >= 12 ? 'green' : r.roi >= 5 ? 'amber' : 'red';
  setTL('tl-roi-icon', 'tl-roi-val', roiLevel, fmtPct(r.roi));

  setTL('tl-regel70-icon', 'tl-regel70-val', r.regel70 ? 'green' : 'red',
    r.regel70 ? 'Eingehalten' : 'Überschritten');

  setTL('tl-speku-icon', 'tl-speku-val', r.speku ? 'green' : 'amber',
    r.speku ? 'Steuerfrei' : 'Zu versteuern');
}

// ─────────────────────────────────────────
//  EMAIL GATE FORM
// ─────────────────────────────────────────
const emailForm = document.getElementById('email-gate-form') as HTMLFormElement;
const emailBtn = document.getElementById('email-gate-btn') as HTMLButtonElement;
const emailError = document.getElementById('email-gate-error') as HTMLElement;

emailForm?.addEventListener('submit', async (e) => {
  e.preventDefault();
  emailError.hidden = true;

  const vorname = (document.getElementById('gate-vorname') as HTMLInputElement)?.value?.trim();
  const email = (document.getElementById('gate-email') as HTMLInputElement)?.value?.trim();

  if (!vorname || !email) {
    emailError.textContent = 'Bitte Vorname und E-Mail angeben.';
    emailError.hidden = false;
    return;
  }

  // Show loading
  emailBtn.textContent = 'Wird gesendet…';
  emailBtn.classList.add('is-loading');

  // Unlock immediately (optimistic)
  unlockResult();

  try {
    const body = {
      vorname,
      email,
      objekt_typ: state.objekt_typ,
      stadtteil: state.stadtteil,
      kaufpreis: state.kaufpreis,
      wohnflaeche: state.wohnflaeche,
      sanierungskosten: state.sanierungskosten,
      exit_strategie: state.exit_strategie,
      eigenkapital_pct: state.eigenkapital_pct,
    };

    const res = await fetch('/api/roi-report', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });

    if (res.ok) {
      // Show "Fast fertig" DOI pending screen
      const quizSection = document.querySelector('.quiz-section') as HTMLElement | null;
      const progressWrap = document.getElementById('quiz-progress') as HTMLElement | null;
      if (quizSection) quizSection.style.display = 'none';
      if (progressWrap) progressWrap.style.display = 'none';
      const pending = document.getElementById('doi-pending-screen');
      if (pending) pending.style.display = 'block';
      window.scrollTo(0, 0);
    } else {
      emailBtn.textContent = 'Analyse erhalten';
      emailBtn.classList.remove('is-loading');
      // Result still unlocked
    }
  } catch {
    emailBtn.textContent = 'Analyse erhalten';
    emailBtn.classList.remove('is-loading');
    // Still unlocked — user has their result
  }
});

function unlockResult() {
  const overlay = document.getElementById('result-blur-overlay');
  const dashboard = document.getElementById('result-dashboard');
  overlay?.classList.add('is-hidden');
  dashboard?.classList.add('is-revealed');
}

// ─────────────────────────────────────────
//  STEP 4 BACK
// ─────────────────────────────────────────
document.getElementById('step4-back')?.addEventListener('click', () => showStep(3));

// ─────────────────────────────────────────
//  PROGRESS BUTTONS (clickable for done steps)
// ─────────────────────────────────────────
document.querySelectorAll<HTMLElement>('.quiz-step-dot').forEach((dot) => {
  dot.addEventListener('click', () => {
    const targetStep = Number(dot.dataset.step);
    if (targetStep < currentStep) showStep(targetStep);
  });
});

// ─────────────────────────────────────────
//  INIT
// ─────────────────────────────────────────
calcPreview();
updateProgress(1);
</script>
