}

.result-kpi-card__value {
  font-size: 22px;
  font-weight: 700;
  color: var(--color-accent);
  margin-bottom: 4px;
}

.result-kpi-card__formula {
  font-size: 11px;
  color: var(--color-text-muted);
}

.result-kpi-card__comment {
  font-size: 11px;
  color: var(--color-text-muted);
  margin-top: 2px;
}

.result-kpi-card--gated {
  filter: blur(5px);
  user-select: none;
  pointer-events: none;
  opacity: .6;
}

.result-kpi-card--gated .result-kpi-card__value {
