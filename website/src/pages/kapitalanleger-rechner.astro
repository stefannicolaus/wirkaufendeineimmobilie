}

/* ─── GATE CTA ─── */
.gate-cta {
  background: var(--color-surface-2, var(--color-bg-card));
  border: 1px solid var(--color-border);
  border-radius: 8px;
  padding: 20px;
  text-align: center;
  margin-bottom: 12px;
  max-width: 860px;
  margin-left: auto;
  margin-right: auto;
}

.gate-cta__text {
  color: var(--color-text-muted);
  margin-bottom: 12px;
  font-size: 14px;
}

/* ─── EMAIL GATE FORM (Step 5) ─── */
.email-gate-form {
  max-width: 420px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.field-group {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.field-group input {
  background: var(--color-bg-card);
  border: 1px solid var(--color-border-strong);
  border-radius: var(--radius-md);
  padding: var(--space-3) var(--space-4);
  font-size: var(--text-base);
  color: var(--color-text);
  width: 100%;
  transition: border-color 0.2s;
}

.field-group input:focus {
  outline: none;
  border-color: var(--color-accent);
  box-shadow: 0 0 0 3px rgba(37,99,235,0.2);
}

.field-group input::placeholder {
  color: var(--color-text-muted);
}

.email-gate-btn {
  width: 100%;
}

.email-gate-btn.is-loading {
  pointer-events: none;
  opacity: 0.7;
}

.email-gate-disclaimer {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  text-align: center;
  margin: 0;
}

.email-gate-error {
  font-size: var(--text-sm);
  color: #f87171;
  text-align: center;
  margin: 0;
}

.email-gate-success {
  text-align: center;
  padding: var(--space-6);
  color: var(--color-text);
}

.consent-label {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: 12px;
  color: var(--color-text-muted);
  cursor: pointer;
  line-height: 1.5;
}
.consent-label input[type="checkbox"] {
  margin-top: 2px;
  flex-shrink: 0;
  width: 16px;
  height: 16px;
  accent-color: var(--color-accent);
}
.consent-label a { color: var(--color-accent); }

/* ─── RESPONSIVE ─── */
@media (max-width: 640px) {
  .input-grid { grid-template-columns: 1fr; }
  .result-open-grid, .result-gated-grid { grid-template-columns: 1fr; }
  .quiz-step-dot__label { display: none; }
}
</style>

<script>
  // Seite immer ganz oben starten
  if (window.history.scrollRestoration) window.history.scrollRestoration = 'manual';
  window.scrollTo(0, 0);

  // State
  let formData: Record<string, string> = {};

  // Step navigation
  function showStep(n: number) {
    document.querySelectorAll('.quiz-step').forEach((el: Element) => {
      (el as HTMLElement).hidden = true;
    });
    const stepEl = document.getElementById(`step-${n}`);
    if (stepEl) stepEl.hidden = false;
    document.querySelectorAll('.quiz-step-dot').forEach((dot: Element) => {
      const s = Number((dot as HTMLElement).dataset.step);
      dot.classList.toggle('is-active', s === n);
      dot.classList.toggle('is-done', s < n);
    });
    const progress = document.getElementById('quiz-progress');
    if (progress) {
      window.scrollTo({ top: progress.offsetTop - 20, behavior: 'smooth' });
    }
  }

  // Initialize step 1 as active
  showStep(1);

  // Next/Back buttons
  document.querySelectorAll('.quiz-next-btn').forEach((btn: Element) => {
    btn.addEventListener('click', () => {
      const next = Number((btn as HTMLElement).dataset.next);
      const stepEl = (btn as HTMLElement).closest('.quiz-step');
      if (stepEl) {
        stepEl.querySelectorAll('input[name]').forEach((inp: Element) => {
          const input = inp as HTMLInputElement;
          if (input.value !== '') formData[input.name] = input.value;
        });
      }
      showStep(next);
    });
  });

  document.querySelectorAll('.quiz-back-btn').forEach((btn: Element) => {
    btn.addEventListener('click', () => showStep(Number((btn as HTMLElement).dataset.back)));
  });

  // LTV warning
  const darlehenInput = document.getElementById('darlehen') as HTMLInputElement | null;
  const ltvWarning = document.getElementById('ltv-warning');
  darlehenInput?.addEventListener('input', () => {
    const kp = Number(formData.kaufpreis || 0);
    const dl = Number(darlehenInput!.value || 0);
    if (ltvWarning) ltvWarning.hidden = !(kp > 0 && dl > kp);
  });

  // Currency formatter
  const fmt = (n: number) =>
    new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n);

  // Calc button → client-side preview → step 4
  document.getElementById('calc-btn')?.addEventListener('click', () => {
    // Collect step 3 inputs
    const stepEl = document.getElementById('step-3');
    if (stepEl) {
      stepEl.querySelectorAll('input[name]').forEach((inp: Element) => {
        const input = inp as HTMLInputElement;
        if (input.value !== '') formData[input.name] = input.value;
      });
    }

    const kp = Number(formData.kaufpreis);
    const bj = Number(formData.baujahr);
    const km = Number(formData.kaltmiete);
    const hg = Number(formData.hausgeld);
    const dl = Number(formData.darlehen);
    const zs = Number(formData.zinssatz);
    const tl = Number(formData.tilgung);
    const gst = Number(formData.grenzsteuersatz);
    const ga = Number(formData.gebaeudeanteil || 80);
    const ls = Number(formData.leerstand || 3);

    // Validate required numeric inputs
    if (!kp || !bj || !km || !dl || isNaN(kp) || isNaN(bj) || isNaN(km) || isNaN(hg) || isNaN(dl) || isNaN(zs) || isNaN(tl) || isNaN(gst)) {
      alert('Bitte alle Pflichtfelder ausfüllen (Kaufpreis, Baujahr, Kaltmiete, Hausgeld, Darlehensdaten, Grenzsteuersatz).');
      return;
    }
    if (km === 0) {
      alert('Kaltmiete darf nicht 0 sein.');
      return;
    }

    // AfA rate §7 EStG
    const afaRate = bj <= 1924 ? 0.025 : bj >= 2023 ? 0.03 : 0.02;
    const jahresAfA = kp * (ga / 100) * afaRate;

    // §21 EStG
    const zinsen = dl * (zs / 100);
    const nichtUmlagefaehig = hg * 12 * 0.30;
    const werbungskosten = zinsen + nichtUmlagefaehig + jahresAfA;
    const bruttoMieteJahr = km * 12 * (1 - ls / 100);
    const zuVersteuern = bruttoMieteJahr - werbungskosten;
    const einkommensteuer = Math.max(0, zuVersteuern) * (gst / 100);

    // Cashflow
    const kapitaldienstJahr = dl * ((zs + tl) / 100);
    const nettoJahr = bruttoMieteJahr - kapitaldienstJahr - hg * 12 - einkommensteuer;
    const nettoMonat = nettoJahr / 12;

    // Kaufpreisfaktor
    const faktor = kp / (km * 12);

    // Fill KPI cards
    const faktorEl = document.getElementById('res-faktor');
    const faktorFormulaEl = document.getElementById('res-faktor-formula');
    const faktorCommentEl = document.getElementById('res-faktor-comment');
    if (faktorEl) faktorEl.textContent = faktor.toFixed(1) + '×';
    if (faktorFormulaEl) faktorFormulaEl.textContent = `${fmt(kp)} ÷ (${fmt(km)} × 12)`;
    if (faktorCommentEl) faktorCommentEl.textContent =
      faktor < 20 ? 'Günstiger Einstieg (Leipzig: 20–28×)' :
      faktor <= 28 ? 'Solides Leipzig-Niveau (20–28×)' : 'Hohes Preisniveau — Rendite prüfen';

    const cashflowEl = document.getElementById('res-cashflow');
    const cashflowFormulaEl = document.getElementById('res-cashflow-formula');
    const cashflowCommentEl = document.getElementById('res-cashflow-comment');
    if (cashflowEl) {
      cashflowEl.textContent = fmt(nettoMonat) + '/Mo';
      cashflowEl.style.color = nettoMonat >= 0 ? 'var(--color-success, #1a7a4a)' : '#b91c1c';
    }
    if (cashflowFormulaEl) cashflowFormulaEl.textContent = 'nach Zinsen, Tilgung, Hausgeld, Steuer';
    if (cashflowCommentEl) cashflowCommentEl.textContent =
      nettoMonat >= 0 ? 'Positiver Cashflow ab Tag 1' : 'Negativer Cashflow — Wertsteigerung kalkulieren';

    const afaEl = document.getElementById('res-afa');
    const afaFormulaEl = document.getElementById('res-afa-formula');
    const afaCommentEl = document.getElementById('res-afa-comment');
    if (afaEl) afaEl.textContent = fmt(jahresAfA) + '/J';
    if (afaFormulaEl) afaFormulaEl.textContent = `${fmt(kp)} × ${ga}% × ${(afaRate * 100).toFixed(1)}%`;
    if (afaCommentEl) afaCommentEl.textContent = `§7 EStG · Baujahr ${bj}`;

    showStep(4);
  });

  // Show gate on CTA click
  document.getElementById('show-gate-btn')?.addEventListener('click', () => showStep(5));

  // Email gate submit
  const emailForm = document.getElementById('email-gate-form') as HTMLFormElement | null;
  const emailBtn = document.getElementById('email-gate-btn') as HTMLButtonElement | null;
  const emailError = document.getElementById('email-gate-error');

  emailForm?.addEventListener('submit', async (e: Event) => {
    e.preventDefault();
    if (emailError) emailError.hidden = true;
    if (emailBtn) {
      emailBtn.classList.add('is-loading');
      emailBtn.disabled = true;
    }

    const vorname = (document.getElementById('gate-vorname') as HTMLInputElement)?.value.trim() ?? '';
    const email = (document.getElementById('gate-email') as HTMLInputElement)?.value.trim() ?? '';

    const consentCheckbox = document.getElementById('dsgvo-consent');
    if (!(consentCheckbox as HTMLInputElement)?.checked) {
      if (emailError) {
        emailError.textContent = 'Bitte stimmen Sie der Datenschutzerklärung zu.';
        emailError.hidden = false;
      }
      if (emailBtn) {
        emailBtn.classList.remove('is-loading');
        emailBtn.disabled = false;
      }
      return;
    }

    try {
      const res = await fetch('/api/kapitalanleger-report', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...formData, vorname, email }),
      });
      const data = await res.json();
      if (!data.success) throw new Error(data.error || 'Fehler beim Verarbeiten');

      // DOI pending — hide quiz, show confirmation screen
      const quizSection = document.querySelector('.quiz-section') as HTMLElement | null;
      const progressWrap = document.getElementById('quiz-progress') as HTMLElement | null;
      const doiScreen = document.getElementById('doi-pending-screen') as HTMLElement | null;
      if (quizSection) quizSection.style.display = 'none';
      if (progressWrap) progressWrap.style.display = 'none';
      if (doiScreen) doiScreen.style.display = 'block';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } catch (err: unknown) {
      const message = err instanceof Error ? err.message : 'Etwas ist schiefgelaufen. Bitte erneut versuchen.';
      if (emailError) {
        emailError.textContent = message;
        emailError.hidden = false;
      }
      if (emailBtn) {
        emailBtn.classList.remove('is-loading');
        emailBtn.disabled = false;
      }
    }
  });
</script>
