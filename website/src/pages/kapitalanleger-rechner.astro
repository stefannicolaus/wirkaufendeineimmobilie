}

/* ─── STEP NAV ─── */
.step-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  max-width: 620px;
  margin: var(--space-6) auto 0;
  gap: var(--space-4);
}

/* ─── KPI RESULT CARDS ─── */
.result-open-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-bottom: 16px;
  max-width: 860px;
  margin-left: auto;
  margin-right: auto;
}

.result-gated-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-bottom: 24px;
  max-width: 860px;
  margin-left: auto;
  margin-right: auto;
}

.result-kpi-card {
  background: var(--color-surface-2, var(--color-bg-card));
  border: 1px solid var(--color-border);
