/* ─── ADVANCED PARAMS ─── */
.advanced-params {
  margin-top: 16px;
  max-width: 620px;
  margin-left: auto;
  margin-right: auto;
}

.advanced-params summary {
  cursor: pointer;
  font-size: 13px;
  color: var(--color-text-muted);
