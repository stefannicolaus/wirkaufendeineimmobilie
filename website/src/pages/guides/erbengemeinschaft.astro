---
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="Erbengemeinschaft & Immobilie — 7 Wege aus der Blockade | wirkaufendeineimmobilie.de"
  description="Einer will nicht verkaufen? Die Kosten laufen? 7 rechtliche Wege, wie Erbengemeinschaften eine Immobilie verwerten können."
>

  <section class="section guide-hero">
    <div class="container guide-hero__inner">
      <div class="label">Kostenloser Guide</div>
      <h1>Erbengemeinschaft &amp; Immobilie —<br /><span class="text-accent">7 Wege aus der Blockade</span></h1>
    </div>
  </section>

  <section class="section bg-alt">
    <div class="container guide-content">
      <div class="guide-grid">
        <div class="guide-pain">
          <h2>Kommt Ihnen das bekannt vor?</h2>
          <ul class="pain-list">
            <li>Einer der Erben blockiert den Verkauf</li>
            <li>Die laufenden Kosten fressen die Substanz</li>
            <li>Seit Monaten passiert einfach nichts</li>
            <li>Niemand will die Verantwortung übernehmen</li>
            <li>Die Immobilie verfällt, während alle streiten</li>
          </ul>

          <h3>Was im Guide steht:</h3>
          <ul class="content-list">
            <li>7 rechtliche Wege, eine Erbengemeinschaft aufzulösen</li>
            <li>Kostenrechner: Was kostet die Blockade pro Monat?</li>
            <li>Lokale Ansprechpartner in Leipzig (Notar, Mediator)</li>
            <li>Checkliste: Welcher Weg passt zu Ihrer Situation?</li>
          </ul>

          <div class="guide-trust">
            Kostenlos. 14 Seiten. Sofort per E-Mail.
          </div>
        </div>

        <div class="guide-form-wrap">
          <h3>Guide jetzt anfordern</h3>
          <form class="guide-form" id="erben-form">
            <div class="form-group">
              <label for="erben-anzahl">Anzahl Erben</label>
              <select id="erben-anzahl" name="anzahl_erben">
                <option value="2">2 Erben</option>
                <option value="3">3 Erben</option>
                <option value="4">4 Erben</option>
                <option value="5+">5 oder mehr</option>
              </select>
            </div>
            <div class="form-group">
              <label for="erben-dauer">Seit wann blockiert?</label>
              <select id="erben-dauer" name="blockiert_seit">
                <option value="<3m">Weniger als 3 Monate</option>
                <option value="3-12m">3-12 Monate</option>
                <option value="1-3j">1-3 Jahre</option>
                <option value=">3j">Mehr als 3 Jahre</option>
              </select>
            </div>
            <div class="form-group">
              <label for="erben-plz">PLZ der Immobilie</label>
              <input type="text" id="erben-plz" name="plz" pattern="[0-9]{5}" maxlength="5" placeholder="04315" />
            </div>
            <div class="form-group">
              <label for="erben-email">E-Mail *</label>
              <input type="email" id="erben-email" name="email" required placeholder="max@beispiel.de" />
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;">Guide kostenlos erhalten &rarr;</button>
          </form>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .guide-hero {
    text-align: center;
    padding-top: var(--space-20);
    padding-bottom: var(--space-12);
  }

  .guide-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .guide-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10);
    align-items: start;
  }

  @media (max-width: 768px) {
    .guide-grid {
      grid-template-columns: 1fr;
    }
  }

  .pain-list,
  .content-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .pain-list li::before {
    content: '\2717  ';
    color: var(--color-error);
    font-weight: var(--weight-bold);
  }

  .content-list li::before {
    content: '\2713  ';
    color: var(--color-success);
    font-weight: var(--weight-bold);
  }

  .pain-list li,
  .content-list li {
    color: var(--color-text-mid);
  }

  .guide-trust {
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    font-size: var(--text-sm);
  }

  .guide-form-wrap {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-lg);
  }

  .guide-form-wrap h3 {
    margin-bottom: var(--space-6);
  }

  .guide-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .form-group label {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-mid);
  }

  .form-group input,
  .form-group select {
    width: 100%;
  }
</style>

<script>
  const form = document.getElementById('erben-form') as HTMLFormElement;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    formData.append('typ', 'erben');
    const btn = form.querySelector('button') as HTMLButtonElement;
    btn.textContent = 'Wird gesendet...';
    btn.disabled = true;
    try {
      const res = await fetch('/api/guide', { method: 'POST', body: formData });
      if (res.ok) {
        window.location.href = '/danke?typ=guide&guide=erben';
      } else {
        btn.textContent = 'Fehler — erneut versuchen';
        btn.disabled = false;
      }
    } catch {
      btn.textContent = 'Fehler — erneut versuchen';
      btn.disabled = false;
    }
  });
</script>
