</style>

<script>
(function() {
  // ── STATE ──
  const state = {
    sessionId: null,
    currentStep: 0,
    kontakt: { vorname: '', nachname: '', email: '', strasse: '', hausnummer: '', plz: '', ort: '' },
    steps: {
      1: { status: 'pending', files: [] },
      2: { status: 'pending', files: [] },
      3: { status: 'pending', files: [] },
      4: { status: 'pending', files: [] },
      5: { status: 'pending', files: [] },
      6: { status: 'pending', files: [] },
    }
  };

  const STEP_LABELS = ['', 'Energieausweis', 'WEG-Protokolle', 'Wirtschaftsplan', 'Hausgeldabrechnungen', 'Grundriss', 'Grundbuchauszug'];

  // ── SESSION ──
  function initSession() {
    const params = new URLSearchParams(window.location.search);
    const existing = params.get('session') || localStorage.getItem('wkdi_session');
    if (existing) {
      state.sessionId = existing;
    } else {
      state.sessionId = crypto.randomUUID();
      localStorage.setItem('wkdi_session', state.sessionId);
    }
  }

  // ── NAVIGATION ──
  function goToStep(n) {
    document.querySelectorAll('.wiz-step').forEach(el => el.classList.add('hidden'));
    const el = document.getElementById('step-' + n);
    if (el) {
      el.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
      const block = document.getElementById('wiz-progress-block');
      if (block) {
        if (n >= 1 && n <= 6) {
          const card = el.querySelector('.wiz-card');
          if (card && card.firstChild !== block) card.insertBefore(block, card.firstChild);
          block.classList.remove('hidden');
        } else {
          block.classList.add('hidden');
        }
      }
    }
    state.currentStep = n;
    updateProgress(n);
    if (n > 0) document.getElementById('voice-fab')?.classList.remove('hidden');
  }

  function updateProgress(step) {
    const bar = document.getElementById('wiz-progress-bar');
    const pct = step === 0 ? 0 : Math.min(Math.round((step / 6) * 100), 100);
    if (bar) bar.setAttribute('data-pct', String(pct));
    const label = document.getElementById('wiz-progress-label');
    if (label && step >= 1 && step <= 6) label.textContent = `Schritt ${step} von 6`;
    document.querySelectorAll('.wiz-step-dot').forEach(dot => {
      const s = parseInt(dot.getAttribute('data-step') || '0');
      const numEl = dot.querySelector('.wiz-step-dot__num') as HTMLElement;
      const statusEl = dot.querySelector('.wiz-step-dot__status') as HTMLElement;
      dot.classList.remove('active', 'done', 'missing');
      dot.removeAttribute('data-navigable');
      if (s < step) {
        const st = state.steps[s as keyof typeof state.steps]?.status;
        if (st === 'missing') {
          dot.classList.add('missing');
          if (numEl) numEl.textContent = '⚠';
          if (statusEl) statusEl.textContent = 'Fehlt noch';
        } else {
          dot.classList.add('done');
          if (numEl) numEl.textContent = '✓';
          if (statusEl) statusEl.textContent = 'Hochgeladen';
        }
        dot.setAttribute('data-navigable', '1');
      } else if (s === step) {
        dot.classList.add('active');
        if (numEl) numEl.textContent = String(s);
        if (statusEl) statusEl.textContent = '← Aktuell';
      } else {
        if (numEl) numEl.textContent = String(s);
        if (statusEl) statusEl.textContent = '';
      }
    });
  }

  // ── MISSING TOGGLE ──
  document.querySelectorAll('.wiz-missing-label[data-toggle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = (btn as HTMLElement).dataset.toggle!;
      const content = document.getElementById(id);
      if (!content) return;
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      content.classList.toggle('hidden', expanded);
    });
  });

  // ── BACK BUTTON ──
  document.querySelectorAll('.wiz-btn-back').forEach(btn => {
    btn.addEventListener('click', () => {
      const step = parseInt((btn as HTMLElement).getAttribute('data-step') || '1');
      goToStep(step - 1 < 1 ? 0 : step - 1);
    });
  });

  // ── DOT CLICK NAVIGATION ──
  document.querySelectorAll('.wiz-step-dot').forEach(dot => {
    dot.addEventListener('click', () => {
      if (!dot.hasAttribute('data-navigable')) return;
      const s = parseInt(dot.getAttribute('data-step') || '0');
      if (s > 0) goToStep(s);
    });
  });

  // ── KONTAKT FORM ──
  document.getElementById('form-kontakt')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.textContent = 'Wird gespeichert…';
    btn.disabled = true;
    state.kontakt.vorname = (document.getElementById('k-vorname') as HTMLInputElement).value;
    state.kontakt.nachname = (document.getElementById('k-nachname') as HTMLInputElement).value;
    state.kontakt.email = (document.getElementById('k-email') as HTMLInputElement).value;
    state.kontakt.strasse = (document.getElementById('k-strasse') as HTMLInputElement).value;
    state.kontakt.hausnummer = (document.getElementById('k-hausnummer') as HTMLInputElement).value;
    state.kontakt.plz = (document.getElementById('k-plz') as HTMLInputElement).value;
    state.kontakt.ort = (document.getElementById('k-ort') as HTMLInputElement).value;
    const fd = new FormData();
    fd.append('sessionId', state.sessionId!);
    fd.append('docType', 'kontakt');
    fd.append('name', `${state.kontakt.vorname} ${state.kontakt.nachname}`);
    fd.append('email', state.kontakt.email);
    fd.append('adresse', `${state.kontakt.strasse} ${state.kontakt.hausnummer}, ${state.kontakt.plz} ${state.kontakt.ort}`);
    try { await fetch('/api/unterlagen', { method: 'POST', body: fd }); } catch {}
    goToStep(1);
  });

  // ── FILE INPUTS ──
  for (let i = 1; i <= 6; i++) {
    const input = document.getElementById('files-' + i) as HTMLInputElement;
    const uploadBtn = document.getElementById('upload-btn-' + i) as HTMLButtonElement;
    const zone = document.getElementById('upload-zone-' + i);

    input?.addEventListener('change', () => updateFileList(i));

    // Drag & drop
    zone?.addEventListener('dragover', (e) => { e.preventDefault(); zone.classList.add('dragover'); });
    zone?.addEventListener('dragleave', () => zone.classList.remove('dragover'));
    zone?.addEventListener('drop', (e: DragEvent) => {
      e.preventDefault();
      zone.classList.remove('dragover');
      if (e.dataTransfer?.files && input) {
        const dt = new DataTransfer();
        Array.from(e.dataTransfer.files).forEach(f => dt.items.add(f));
        input.files = dt.files;
        updateFileList(i);
      }
    });
  }

  function updateFileList(step: number) {
    const input = document.getElementById('files-' + step) as HTMLInputElement;
    const list = document.getElementById('file-list-' + step);
    const btn = document.getElementById('upload-btn-' + step) as HTMLButtonElement;
    if (!input || !list || !btn) return;
    list.innerHTML = '';
    const files = Array.from(input.files || []);
    state.steps[step].files = files;
    files.forEach((f, idx) => {
      const li = document.createElement('li');
      li.className = 'wiz-file-item';
      li.innerHTML = `<span class="wiz-file-item__name">✓ ${f.name}</span><button class="wiz-file-item__remove" data-idx="${idx}" aria-label="Entfernen">&times;</button>`;
      li.querySelector('.wiz-file-item__remove')?.addEventListener('click', () => removeFile(step, idx));
      list.appendChild(li);
    });
    btn.disabled = files.length === 0;
  }

  function removeFile(step: number, idx: number) {
    const input = document.getElementById('files-' + step) as HTMLInputElement;
    if (!input) return;
    const dt = new DataTransfer();
    Array.from(input.files || []).forEach((f, i) => { if (i !== idx) dt.items.add(f); });
    input.files = dt.files;
    updateFileList(step);
  }

  // ── UPLOAD & NEXT ──
  document.querySelectorAll('.wiz-btn-upload').forEach(btn => {
    btn.addEventListener('click', async () => {
      const step = parseInt((btn as HTMLElement).getAttribute('data-step') || '0');
      const input = document.getElementById('files-' + step) as HTMLInputElement;
      const uploadBtn = btn as HTMLButtonElement;
      uploadBtn.textContent = 'Wird hochgeladen…';
      uploadBtn.disabled = true;
      const fd = new FormData();
      fd.append('sessionId', state.sessionId!);
      fd.append('docType', getDocType(step));
      Array.from(input?.files || []).forEach(f => fd.append('files', f));
      try { await fetch('/api/unterlagen', { method: 'POST', body: fd }); } catch {}
      state.steps[step].status = 'done';
      if (step < 6) goToStep(step + 1); else goToStep(7);
    });
  });

  // ── SKIP / MISSING ──
  document.querySelectorAll('.wiz-btn-skip').forEach(btn => {
    btn.addEventListener('click', async () => {
      const step = parseInt((btn as HTMLElement).getAttribute('data-step') || '0');
      const notiz = (document.getElementById('notiz-' + step) as HTMLTextAreaElement)?.value || '';
      const wkdiKuemmert = (document.getElementById('wkdi-kuemmert-' + step) as HTMLInputElement)?.checked;
      const fd = new FormData();
      fd.append('sessionId', state.sessionId!);
      fd.append('docType', getDocType(step));
      fd.append('missing', 'true');
      fd.append('notiz', notiz);
      if (wkdiKuemmert) fd.append('wkdiKuemmert', 'true');
      try { await fetch('/api/unterlagen', { method: 'POST', body: fd }); } catch {}
      state.steps[step].status = 'missing';
      if (step < 6) goToStep(step + 1); else goToStep(7);
    });
  });

  // ── STEP 7: SUMMARY ──
  function buildSummary() {
    const list = document.getElementById('summary-list');
    if (!list) return;
    list.innerHTML = '';
    for (let i = 1; i <= 6; i++) {
      const s = state.steps[i].status;
      const li = document.createElement('li');
      li.className = `wiz-summary-item wiz-summary-item--${s === 'done' ? 'done' : s === 'missing' ? 'missing' : 'skipped'}`;
      const icon = s === 'done' ? '✓' : s === 'missing' ? '⚠' : '—';
      const label = s === 'done' ? 'hochgeladen' : s === 'missing' ? 'fehlt noch' : 'übersprungen';
      li.textContent = `${icon} ${STEP_LABELS[i]} — ${label}`;
      list.appendChild(li);
    }
  }

  // Override goToStep to build summary on step 7
  const origGoToStep = goToStep;
  (window as any)._goToStep = origGoToStep;

  document.getElementById('submit-btn')?.addEventListener('click', async () => {
    const btn = document.getElementById('submit-btn') as HTMLButtonElement;
    btn.textContent = 'Wird gesendet…';
    btn.disabled = true;
    const fd = new FormData();
    fd.append('sessionId', state.sessionId!);
    fd.append('docType', 'abschluss');
    fd.append('missing', 'false');
    try { await fetch('/api/unterlagen', { method: 'POST', body: fd }); } catch {}
    window.location.href = '/danke?typ=unterlagen';
  });

  function getDocType(step: number): string {
    return ['', 'energieausweis', 'weg-protokolle', 'wirtschaftsplan', 'hausgeldabrechnungen', 'grundriss', 'grundbuchauszug'][step];
  }

  // ── COPY EMAIL ──
  document.querySelectorAll('.btn-copy').forEach(btn => {
    btn.addEventListener('click', () => {
      const doc = (btn as HTMLElement).getAttribute('data-doc') || '';
      const tpl = (document.getElementById('email-template') as HTMLTemplateElement)?.innerHTML || '';
      const text = tpl
        .replace(/{adresse}/g, `${state.kontakt.strasse} ${state.kontakt.hausnummer}, ${state.kontakt.plz} ${state.kontakt.ort}`.trim() || 'Ihre Adresse')
        .replace(/{name}/g, `${state.kontakt.vorname} ${state.kontakt.nachname}`.trim() || 'Ihr Name')
        .replace(/{dokument}/g, doc);
      navigator.clipboard.writeText(text).then(() => {
        btn.classList.add('copied');
        btn.textContent = '✓ Kopiert!';
        setTimeout(() => { btn.classList.remove('copied'); (btn as HTMLElement).innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> E-Mail an Hausverwaltung kopieren`; }, 2500);
      });
    });
  });

  // ── VOICE MODAL ──
  const voiceFab = document.getElementById('voice-fab');
  const modal = document.getElementById('voice-modal');
  const modalClose = document.getElementById('modal-close');

  voiceFab?.addEventListener('click', () => modal?.classList.remove('hidden'));
  modalClose?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  function closeModal() { modal?.classList.add('hidden'); resetVoice(); }

  // Tab switching
  document.querySelectorAll('.modal-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.modal-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const which = (tab as HTMLElement).getAttribute('data-tab');
      document.getElementById('tab-voice')?.classList.toggle('hidden', which !== 'voice');
      document.getElementById('tab-text')?.classList.toggle('hidden', which !== 'text');
    });
  });

  // Voice recording
  let mediaRecorder: MediaRecorder | null = null;
  let audioChunks: Blob[] = [];
  let timerInterval: ReturnType<typeof setInterval> | null = null;
  let seconds = 0;
  let audioBlob: Blob | null = null;

  const recordBtn = document.getElementById('voice-record-btn');
  const voiceStatus = document.getElementById('voice-status');
  const voiceTimer = document.getElementById('voice-timer');
  const voicePlayback = document.getElementById('voice-playback') as HTMLAudioElement;
  const voiceSendBtn = document.getElementById('voice-send-btn');

  recordBtn?.addEventListener('click', async () => {
    if (mediaRecorder?.state === 'recording') {
      mediaRecorder.stop();
      return;
    }
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      audioChunks = [];
      mediaRecorder = new MediaRecorder(stream);
      mediaRecorder.ondataavailable = (e) => { if (e.data.size > 0) audioChunks.push(e.data); };
      mediaRecorder.onstop = () => {
        stream.getTracks().forEach(t => t.stop());
        audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
        voicePlayback!.src = URL.createObjectURL(audioBlob);
        voicePlayback?.classList.remove('hidden');
        voiceSendBtn?.classList.remove('hidden');
        recordBtn?.classList.remove('recording');
        if (voiceStatus) voiceStatus.textContent = 'Gut! Sie können sich die Aufnahme anhören und dann absenden.';
        if (timerInterval) clearInterval(timerInterval);
        voiceTimer?.classList.add('hidden');
      };
      mediaRecorder.start();
      recordBtn.classList.add('recording');
      if (voiceStatus) voiceStatus.textContent = 'Aufnahme läuft… Drücken Sie erneut zum Stoppen.';
      voiceTimer?.classList.remove('hidden');
      seconds = 0;
      timerInterval = setInterval(() => {
        seconds++;
        const m = Math.floor(seconds / 60);
        const s = seconds % 60;
        if (voiceTimer) voiceTimer.textContent = `${m}:${s.toString().padStart(2, '0')}`;
        if (seconds >= 60) mediaRecorder?.stop();
      }, 1000);
    } catch {
      if (voiceStatus) voiceStatus.textContent = 'Mikrofon-Zugriff nicht möglich. Bitte nutzen Sie die Textnachricht.';
    }
  });

  voiceSendBtn?.addEventListener('click', async () => {
    if (!audioBlob) return;
    voiceSendBtn.textContent = 'Wird gesendet…';
    (voiceSendBtn as HTMLButtonElement).disabled = true;
    const fd = new FormData();
    fd.append('sessionId', state.sessionId!);
    fd.append('audio', audioBlob, 'voice.webm');
    try {
      await fetch('/api/unterlagen-frage', { method: 'POST', body: fd });
      showModalSuccess();
    } catch {
      voiceSendBtn.textContent = 'Senden fehlgeschlagen — bitte Textnachricht nutzen';
    }
  });

  document.getElementById('text-send-btn')?.addEventListener('click', async () => {
    const textarea = document.getElementById('text-frage') as HTMLTextAreaElement;
    const text = textarea?.value.trim();
    if (!text) return;
    const btn = document.getElementById('text-send-btn') as HTMLButtonElement;
    btn.textContent = 'Wird gesendet…';
    btn.disabled = true;
    try {
      await fetch('/api/unterlagen-frage', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sessionId: state.sessionId, text }),
      });
      showModalSuccess();
    } catch {
      btn.textContent = 'Senden fehlgeschlagen';
      btn.disabled = false;
    }
  });

  function showModalSuccess() {
    document.getElementById('tab-voice')?.classList.add('hidden');
    document.getElementById('tab-text')?.classList.add('hidden');
    document.querySelectorAll('.modal-tabs, .modal__sub').forEach(el => (el as HTMLElement).style.display = 'none');
    document.getElementById('modal-success')?.classList.remove('hidden');
    setTimeout(closeModal, 3000);
  }

  function resetVoice() {
    if (mediaRecorder?.state === 'recording') mediaRecorder.stop();
    if (timerInterval) clearInterval(timerInterval);
    audioBlob = null;
    audioChunks = [];
    voicePlayback?.classList.add('hidden');
    voiceSendBtn?.classList.add('hidden');
    voiceTimer?.classList.add('hidden');
    recordBtn?.classList.remove('recording');
    if (voiceStatus) voiceStatus.textContent = 'Drücken Sie den Knopf und sprechen Sie.';
    const textFrage = document.getElementById('text-frage') as HTMLTextAreaElement;
    if (textFrage) textFrage.value = '';
    document.getElementById('modal-success')?.classList.add('hidden');
    document.getElementById('tab-voice')?.classList.remove('hidden');
    document.getElementById('tab-text')?.classList.add('hidden');
    document.querySelectorAll('.modal-tabs, .modal__sub').forEach(el => (el as HTMLElement).style.removeProperty('display'));
    document.querySelectorAll('.modal-tab').forEach((t, i) => t.classList.toggle('active', i === 0));
    const sendBtn = document.getElementById('text-send-btn') as HTMLButtonElement;
    if (sendBtn) { sendBtn.textContent = 'Nachricht senden'; sendBtn.disabled = false; }
  }

  // ── STEP 7 SUMMARY HOOK ──
  const origStep7 = () => {
    buildSummary();
    const label = document.getElementById('wiz-progress-label');
    if (label) label.textContent = 'Alle Schritte abgeschlossen';
  };

  // Patch goToStep for step 7
  const _originalGoToStep = goToStep;
  function goToStepPatched(n: number) {
    _originalGoToStep(n);
    if (n === 7) origStep7();
  }

  // Re-bind all buttons that call goToStep
  document.querySelectorAll('.wiz-btn-upload, .wiz-btn-skip').forEach(btn => {
    // Already handled above, this ensures step 7 logic fires
  });

  // ── INIT ──
  initSession();
  goToStep(0);

  // Handle goToStep calls from upload/skip buttons (they call goToStep directly)
  // Monkey-patch the local function reference via a shared object
  (window as any).__wkdiGoToStep = function(n: number) {
    goToStep(n);
    if (n === 7) origStep7();
  };
})();
</script>
