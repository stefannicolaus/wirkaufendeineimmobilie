    .wiz-actions .btn { width: 100%; }
    .form-row { grid-template-columns: 1fr !important; }
    .voice-fab span { display: none; }
    .voice-fab { width: 56px; height: 56px; border-radius: var(--radius-full); justify-content: center; padding: 0; }
